        "ck_events_status": {
          "name": "ck_events_status",
          "value": "\"events\".\"status\" IN ('scheduled','open','closing','closed')"
        },
        "ck_events_time": {
          "name": "ck_events_time",
          "value": "\"events\".\"starts_at\" < \"events\".\"official_ends_at\" AND \"events\".\"official_ends_at\" <= \"events\".\"operational_deadline_at\" AND \"events\".\"operational_deadline_at\" <= \"events\".\"official_ends_at\" + interval '1 hour'"
        },
        "ck_events_external_order": {
          "name": "ck_events_external_order",
          "value": "\"events\".\"external_last_order\" >= 0"
        },
        "ck_events_access_code": {
          "name": "ck_events_access_code",
          "value": "\"events\".\"access_code_normalized\" = upper(btrim(\"events\".\"access_code_normalized\"))"
        },
        "ck_events_closure_shape": {
          "name": "ck_events_closure_shape",
          "value": "(\"events\".\"closure_mode\" IS NULL AND \"events\".\"closure_requested_at\" IS NULL AND \"events\".\"admin_deadline_at\" IS NULL) OR (\"events\".\"closure_mode\" IN ('immediate','controlled') AND \"events\".\"closure_requested_at\" IS NOT NULL AND \"events\".\"admin_deadline_at\" IS NOT NULL)"
        },
        "ck_events_closure_deadline": {
          "name": "ck_events_closure_deadline",
          "value": "\"events\".\"closure_mode\" IS NULL OR (\"events\".\"closure_mode\" = 'immediate' AND \"events\".\"admin_deadline_at\" = \"events\".\"closure_requested_at\") OR (\"events\".\"closure_mode\" = 'controlled' AND \"events\".\"closure_requested_at\" < \"events\".\"admin_deadline_at\" AND \"events\".\"admin_deadline_at\" <= LEAST(\"events\".\"closure_requested_at\" + interval '1 hour', \"events\".\"operational_deadline_at\"))"
        }
      },
      "isRLSEnabled": false
    },
