# URL base do backend NestJS (o sufixo /api/v1 é aplicado automaticamente pelo cliente HTTP)
# - Desenvolvimento local no mesmo computador (Web / simulador iOS): http://127.0.0.1:3000
# - Emulador Android padrão: http://10.0.2.2:3000
# - Dispositivo físico com Expo Go na mesma rede Wi-Fi: http://<IP_LOCAL_DA_MAQUINA>:3000 (ex.: http://192.168.1.15:3000)
# NUNCA inclua segredos do backend (JWT_SECRET, DATABASE_URL, chaves privadas) neste arquivo.
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3000
