+    assert.ok(app.hasExactText('Bruno'));
+    assert.ok(!app.hasExactText('Ana'));
+    await app.act(async () => staleConfirm());
+    assert.equal(mutations, 0);
+  } finally {
+    app.dispose();
+  }
+});
