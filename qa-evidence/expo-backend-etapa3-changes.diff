+const names = ["DATABASE_URL", "DATABASE_DIRECT_URL", "EVENTS_TEST_DATABASE_URL"] as const;
+
+/** A Etapa 3 usa somente um banco descartável próprio; nunca aceita os bancos históricos. */
+export function assertParticipantAdmissionTestDatabaseUrls(env: Record<string, string | undefined>): string {
+  if (env.NODE_ENV !== "test") throw new Error("[SEGURANÇA BLOQUEADA] NODE_ENV=test é obrigatório.");
+  const urls = names.map(name => {
+    const value = env[name];
+    if (!value || value.trim() !== value) throw new Error(`[SEGURANÇA BLOQUEADA] ${name} explícita é obrigatória.`);
+    let parsed: URL;
+    try { parsed = new URL(value); }
+    catch { throw new Error(`[SEGURANÇA BLOQUEADA] ${name} inválida.`); }
+    if ((parsed.protocol !== "postgresql:" && parsed.protocol !== "postgres:")
+      || parsed.hostname !== "127.0.0.1" || parsed.port !== "55432"
+      || parsed.pathname !== "/arenago_admission_test" || !parsed.username || !parsed.password
+      || parsed.search || parsed.hash) {
+      throw new Error(`[SEGURANÇA BLOQUEADA] ${name} exige 127.0.0.1:55432/arenago_admission_test, credenciais explícitas e nenhum redirecionamento.`);
+    }
+    return value;
+  });
+  if (urls.some(value => value !== urls[0])) throw new Error("[SEGURANÇA BLOQUEADA] As três URLs devem ser idênticas.");
+  return urls[0];
+}
