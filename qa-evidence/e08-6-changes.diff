+export interface AdminExternalQueueInput {
+  userId: string;
+  sessionId: string;
+  eventId: string;
+  enabled: boolean;
+  reason: string;
+  idempotencyKey: string;
+  expiresAt: Date;
+}
+export interface AdminExternalQueueState {
+  eventId: string;
+  externalQueueEnabled: boolean;
+  releasedCount: number;
+  changedAt?: Date;
+}
+export type AdminExternalQueueResult =
+  | ({ kind: "completed" | "replay" } & AdminExternalQueueState)
+  | { kind: "resource_not_found" | "admin_required" | "account_inactive" | "invalid_session"
+    | "session_revoked" | "session_expired" | "admin_2fa_required" | "event_closed"
+    | "event_unavailable" | "request_conflict" | "in_progress" };
diff --git a/backend/src/events/admin-idempotency.policy.ts b/backend/src/events/admin-idempotency.policy.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2d8b7a05c3f5fc9d3b49b5107ad909209b29f9f9
--- /dev/null
+++ b/backend/src/events/admin-idempotency.policy.ts
@@ -0,0 +1,14 @@
+import { Injectable } from "@nestjs/common";
+import { parseOperationIdempotencyTtl } from "../common/http/idempotency-ttl";
+
+/** Prazo técnico explícito; não apaga reservas nem invalida replay pelo vencimento. */
+@Injectable()
+export class AdminIdempotencyPolicy {
+  private readonly ttlMs = parseOperationIdempotencyTtl(process.env.ADMIN_IDEMPOTENCY_TTL_SECONDS, "ADMIN_IDEMPOTENCY_TTL_SECONDS");
+
+  expiresAt(): Date {
+    const result = new Date(Date.now() + this.ttlMs);
+    if (!Number.isFinite(result.getTime())) throw new Error("Expiração administrativa fora do intervalo de Date.");
+    return result;
+  }
+}
