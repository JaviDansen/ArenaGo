+    bodySmall: 18,
+    body: 20,
+    bodyLarge: 22,
+    titleSmall: 24,
+    titleMedium: 26,
+    titleLarge: 32,
+    hero: 36,
+  },
+
+  // Estilos tipográficos prontos para uso em StyleSheet (todos com fontFamily explícito)
+  hero: {
+    fontFamily: defaultFontFamily,
+    fontSize: 28,
+    lineHeight: 36,
+    fontWeight: '800',
+    letterSpacing: -0.4,
+  },
+  titleLarge: {
+    fontFamily: defaultFontFamily,
+    fontSize: 24,
+    lineHeight: 32,
+    fontWeight: '700',
+    letterSpacing: -0.3,
+  },
