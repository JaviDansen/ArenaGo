+import { adminColors } from './components/adminTheme';
+import { useAdminDemo } from './AdminDemoContext';
+import { ADMIN_BI_STAGE_LABELS, ADMIN_CLOSURE_LABELS, getClosureReason, getEventBi } from './adminInsights';
+import { formatInstantWithZone } from './adminTime';
+
+const ownParam = (params, key) =>
+  (params != null && Object.prototype.hasOwnProperty.call(params, key) ? params[key] : undefined);
+
+function Row({ label, value }) {
+  return (
+    <View style={styles.row} accessible accessibilityLabel={`${label}: ${value}`}>
+      <Text style={styles.rowLabel}>{label}</Text>
+      <Text style={styles.rowValue}>{value}</Text>
+    </View>
+  );
+}
+
+// BI individual do evento (ADM03), em qualquer fase. Somente leitura e sempre
+// agregado (D10). Aberto pelo Histórico, pelo detalhe do evento e pela Visão
+// Geral com um único evento selecionado.
+export default function AdminEventBiScreen({ navigation, route }) {
+  const { session } = useAdminDemo();
+  const eventId = ownParam(route?.params, 'eventId');
+  const bi = session && typeof eventId === 'string' ? getEventBi(session, eventId) : null;
+
+  if (!bi) {
+    return (
+      <AdminMissing
+        title="Evento não encontrado"
+        message="Este evento não existe nesta sessão de demonstração."
+        actionLabel="VOLTAR"
+        onAction={() => navigation.goBack()}
+      />
+    );
+  }
+
+  const { event, info, stage, participations, completions, usage, evaluations, time } = bi;
+  const reason = getClosureReason(event);
+
+  return (
+    <AdminScreen
+      title="BI do"
+      highlight="Evento"
+      subtitle={`${event.name} · código ${event.accessCode}`}
+      backLabel="Voltar"
+      onBack={() => navigation.goBack()}
+    >
+      <AdminNotice
+        tone="warning"
+        title="Indicadores fictícios"
+        message="Calculados a partir dos dados simulados desta sessão. Não são resultados reais."
+      />
+
+      <AdminCard>
+        <AdminPhaseBadge phase={info.phase} waitingReadiness={info.waitingReadiness} />
+        <Text style={styles.stage}>{ADMIN_BI_STAGE_LABELS[stage]}</Text>
+        <Text style={styles.line}>Início: {formatInstantWithZone(event.startsAt, event.timezone)}</Text>
+        {bi.closedAt ? (
+          <>
+            <Text style={styles.line}>{ADMIN_CLOSURE_LABELS[bi.closureKind]}</Text>
+            <Text style={styles.line}>Encerrado em: {formatInstantWithZone(bi.closedAt, event.timezone)}</Text>
+            {bi.closureKind !== 'schedule' ? (
+              <Text style={styles.line}>Justificativa: {reason ?? 'não registrada nesta demonstração.'}</Text>
+            ) : null}
+          </>
+        ) : null}
+      </AdminCard>
+
+      {bi.insufficient ? (
+        <AdminNotice
+          tone="info"
+          title="Dados insuficientes"
+          message={stage === 'future'
+            ? 'Evento futuro: ainda não há participações, atendimentos nem avaliações. Nenhum número é inventado.'
+            : 'Este evento ainda não tem participações, atendimentos nem avaliações registrados.'}
+        />
+      ) : null}
+
+      <Text style={styles.heading} accessibilityRole="header">Participações</Text>
+      <AdminCard>
+        <Row label="Registradas (estado atual)" value={participations.registered} />
+        <Row label="Na fila externa" value={participations.externalWaiting} />
+        <Row label="Ativas" value={participations.active} />
+        <Row label="Finalizadas" value={participations.finished} />
+        <Row label="Finalizadas pelo encerramento administrativo" value={participations.adminFinalized} />
+        {info.phase === 'closed' && participations.active + participations.externalWaiting > 0 ? (
+          <Text style={styles.warning}>
+            A finalização automática no limite operacional (D07) não é simulada: as participações ainda abertas não
+            foram alteradas pelo relógio.
+          </Text>
+        ) : null}
+        <Text style={styles.note}>
+          Fonte: contadores do evento na sessão. As finalizadas pelo encerramento administrativo não contam como
+          experiência concluída nem como avaliação.
+        </Text>
+      </AdminCard>
+
+      <Text style={styles.heading} accessibilityRole="header">Experiências e estações</Text>
+      <AdminCard>
+        <Row label="Atendimentos concluídos (Staff)" value={completions.completed} />
+        <Row label="Ausências marcadas" value={completions.absences} />
+        <Row label="Estações com atendimento" value={`${completions.stationsWithCompletions} de ${completions.stations}`} />
+        <Text style={styles.note}>
+          Fonte: atendimentos registrados por estação. Fila e número de estações não geram atendimentos; ausência
+          não prova falta real.
+        </Text>
+      </AdminCard>
+      {usage.length === 0 ? (
+        <Text style={styles.line}>Nenhuma experiência cadastrada neste evento.</Text>
+      ) : usage.map((item) => (
+        <AdminCard key={item.experience.id}>
+          <Text style={styles.name}>{item.experience.name}</Text>
+          <Text style={styles.line}>
+            {item.completed > 0
+              ? `${item.completed} atendimento(s) concluído(s) · ${item.absences} ausência(s)`
+              : 'Sem atendimentos registrados.'}
+          </Text>
+          {item.stations.map(({ station, completed, share }) => (
+            <Text key={station.id} style={styles.station}>
+              {station.label}: {completed > 0 ? `${completed} (${share}% da experiência)` : 'sem atendimentos registrados'}
+            </Text>
+          ))}
+        </AdminCard>
+      ))}
+
+      <Text style={styles.heading} accessibilityRole="header">Avaliações</Text>
+      <AdminCard>
+        <Row label="Participações finalizadas fora do encerramento administrativo" value={participations.finishedOutsideAdmin} />
+        <AdminRatings summary={evaluations} />
+        <Text style={styles.note}>
+          Uma avaliação por participação, com a nota mais recente (D08). Finalizar não é o mesmo que avaliar:
+          nem toda participação finalizada envia avaliação.
+        </Text>
+      </AdminCard>
+
+      <Text style={styles.heading} accessibilityRole="header">Tempo</Text>
+      <AdminCard>
+        <AdminDuration label="Entrada até a última experiência concluída" summary={time.lastCompletion} population="participação(ões) com experiência concluída" />
+        <AdminDuration label="Entrada até a saída voluntária" summary={time.voluntaryExit} population="saída(s) voluntária(s)" />
+        <Text style={styles.note}>
+          Populações diferentes. Não é calculado a partir dos horários do evento nem da finalização administrativa.
+        </Text>
+      </AdminCard>
+
+      <Text style={styles.heading} accessibilityRole="header">Perfil do público</Text>
+      <AdminNotice
+        tone="neutral"
+        title="Indisponível"
+        message="Segmentação do público sem política aprovada (D10). Nenhum participante é identificado nesta área."
+      />
+
+      <AdminButton
+        variant="secondary"
+        label="Ver configuração do evento"
+        onPress={() => navigation.navigate('AdminEventDetail', { eventId: event.id })}
+      />
+
+      <AdminDemoTools showFailure={false} />
+    </AdminScreen>
+  );
+}
+
+const styles = StyleSheet.create({
+  heading: { color: adminColors.text, fontSize: 18, fontWeight: 'bold', marginTop: 24 },
+  stage: { color: adminColors.text, fontSize: 14, lineHeight: 20, marginTop: 8 },
+  name: { color: adminColors.text, fontSize: 15, fontWeight: 'bold' },
+  line: { color: adminColors.muted, fontSize: 13, lineHeight: 19, marginTop: 6 },
+  station: { color: adminColors.muted, fontSize: 12, lineHeight: 18, marginTop: 4, paddingLeft: 8 },
+  note: { color: adminColors.muted, fontSize: 12, lineHeight: 17, marginTop: 8 },
+  warning: { color: adminColors.warning, fontSize: 12, lineHeight: 17, marginTop: 8 },
+  row: { flexDirection: 'row', justifyContent: 'space-between', marginTop: 6 },
+  rowLabel: { color: adminColors.muted, flex: 1, fontSize: 13, paddingRight: 8 },
+  rowValue: { color: adminColors.text, fontSize: 14, fontWeight: '600' },
+});
diff --git a/app/screens/admin/AdminEventCloseScreen.js b/app/screens/admin/AdminEventCloseScreen.js
new file mode 100644
--- /dev/null
+++ b/app/screens/admin/AdminEventCloseScreen.js
@@ -0,0 +1,176 @@
+import { useEffect, useRef, useState } from 'react';
+import { StyleSheet, Text } from 'react-native';
+
+import AdminButton from './components/AdminButton';
+import AdminCard from './components/AdminCard';
+import AdminConfirmDialog from './components/AdminConfirmDialog';
+import AdminField from './components/AdminField';
+import AdminMissing from './components/AdminMissing';
+import AdminNotice from './components/AdminNotice';
+import AdminOptions from './components/AdminOptions';
+import AdminScreen from './components/AdminScreen';
+import { adminColors } from './components/adminTheme';
+import { useAdminDemo } from './AdminDemoContext';
+import { waitAdminDemoLatency } from './adminDemoLatency';
+import { closeEvent, findEvent, getCloseAvailability } from './adminDemoState';
+import { formatInstantWithZone } from './adminTime';
+import { useAdminConfirmation } from './useAdminConfirmation';
+
+const ownParam = (params, key) =>
+  (params != null && Object.prototype.hasOwnProperty.call(params, key) ? params[key] : undefined);
+
+const MODE_OPTIONS = [
+  { value: 'immediate', label: 'Imediato', accessibilityLabel: 'Modo imediato' },
+  { value: 'controlled', label: 'Controlado', accessibilityLabel: 'Modo controlado' },
+];
+
+const EFFECTS = {
+  immediate: 'Bloqueia agora novas entradas e chamadas, cancela esperas e chamadas pendentes e finaliza todas as participações abertas. Conclusões anteriores são preservadas; quem for elegível poderá avaliar ao voltar ao app.',
+  controlled: 'Bloqueia agora novas entradas e inscrições em filas. Quem aguarda na fila externa é finalizado agora, sem avaliação. Filas e atendimentos internos já existentes continuam até o prazo escolhido.',
+};
+
+// Encerramento antecipado (§17.8, D09): modos imediato e controlado, com
+// justificativa obrigatória e janela válida. Não existe reabertura.
+export default function AdminEventCloseScreen({ navigation, route }) {
+  const { session, run } = useAdminDemo();
+  const eventId = ownParam(route?.params, 'eventId');
+  const event = session ? findEvent(session, eventId) : null;
+  const [mode, setMode] = useState(null);
+  const [minutes, setMinutes] = useState('');
+  const [reason, setReason] = useState('');
+  const [errors, setErrors] = useState({});
+  const [message, setMessage] = useState(null);
+  const confirmation = useAdminConfirmation();
+  const [saving, setSaving] = useState(false);
+  const mountedRef = useRef(true);
+
+  useEffect(() => {
+    mountedRef.current = true;
+    return () => { mountedRef.current = false; };
+  }, []);
+
+  if (!event) {
+    return (
+      <AdminMissing title="Evento não encontrado" message="Volte e escolha um evento." actionLabel="VOLTAR" onAction={() => navigation.goBack()} />
+    );
+  }
+
+  const availability = getCloseAvailability(event, session.clockNow);
+  const done = message?.tone === 'success';
+
+  function clearFeedback() {
+    if (Object.keys(errors).length) setErrors({});
+    if (message && !done) setMessage(null);
+  }
+
+  function handleReview() {
+    if (saving) return;
+    if (!mode) {
+      setErrors({ mode: 'Escolha o modo de encerramento.' });
+      return;
+    }
+    if (mode === 'controlled' && availability.controlledBlocked) {
+      setErrors({ mode: availability.controlledBlocked });
+      return;
+    }
+    confirmation.open({ eventId: event.id, input: { mode, controlledMinutes: minutes, reason } });
+  }
+
+  // Executa no máximo uma vez por confirmação válida, com o snapshot revisado.
+  async function handleConfirm(token) {
+    const snapshot = confirmation.claim(token);
+    if (!snapshot) return;
+    setSaving(true);
+    await waitAdminDemoLatency();
+    if (!mountedRef.current) return;
+    const result = run(closeEvent, snapshot.eventId, snapshot.input);
+    confirmation.release();
+    setSaving(false);
+    setErrors(result.errors ?? {});
+    setMessage({ tone: result.ok ? 'success' : 'error', text: result.message });
+  }
+
+  return (
+    <AdminScreen
+      title="Encerrar"
+      highlight="Evento"
+      subtitle={`${event.name} · ${event.accessCode}`}
+      backLabel="Evento"
+      onBack={() => navigation.goBack()}
+    >
+      <AdminCard>
+        <Text style={styles.line}>Limite operacional autorizado: {formatInstantWithZone(event.operationalDeadlineAt, event.timezone)}</Text>
+        <Text style={styles.line}>Aguardando na fila externa: {event.participants.externalWaiting}</Text>
+        <Text style={styles.line}>Ativas na Arena: {event.participants.active}</Text>
+        <Text style={styles.muted}>O encerramento não pode ser desfeito: não há reabertura.</Text>
+      </AdminCard>
+
+      {!availability.allowed && !done ? (
+        <AdminNotice tone="warning" title="Encerramento indisponível" message={availability.message} />
+      ) : null}
+
+      {availability.allowed && !done ? (
+        <>
+          <AdminOptions
+            label="Modo de encerramento *"
+            options={MODE_OPTIONS}
+            value={mode}
+            onChange={(value) => { setMode(value); clearFeedback(); }}
+            error={errors.mode}
+            disabled={saving}
+          />
+          {mode ? <AdminNotice tone="warning" title="Efeitos" message={EFFECTS[mode]} /> : null}
+          {mode === 'controlled' && availability.controlledBlocked ? (
+            <AdminNotice tone="neutral" message={availability.controlledBlocked} />
+          ) : null}
+          {mode === 'controlled' && !availability.controlledBlocked ? (
+            <AdminField
+              label="Prazo controlado (minutos a partir de agora) *"
+              hint={`De 1 a ${availability.maxControlledMinutes} min: no máximo 60 e nunca além do limite operacional autorizado.`}
+              value={minutes}
+              onChangeText={(value) => { setMinutes(value.replace(/\D/g, '').slice(0, 3)); clearFeedback(); }}
+              keyboardType="number-pad"
+              error={errors.controlledMinutes}
+              editable={!saving}
+            />
+          ) : null}
+          <AdminField
+            label="Justificativa *"
+            hint="Registrada para auditoria; não é mostrada ao participante."
+            value={reason}
+            onChangeText={(value) => { setReason(value); clearFeedback(); }}
+            placeholder="Ex.: Interrupção operacional registrada pela organização"
+            error={errors.reason}
+            multiline
+            editable={!saving}
+          />
+        </>
+      ) : null}
+
+      {message ? (
+        <AdminNotice tone={message.tone} title={done ? 'Encerramento registrado' : 'Não foi possível encerrar'} message={message.text} />
+      ) : null}
+
+      {availability.allowed && !done ? (
+        <AdminButton label={saving ? 'ENCERRANDO...' : 'REVISAR ENCERRAMENTO'} variant="danger" loading={saving} onPress={handleReview} />
+      ) : null}
+      <AdminButton label={done ? 'Voltar ao evento' : 'Cancelar'} variant="secondary" disabled={saving} onPress={() => navigation.goBack()} />
+
+      <AdminConfirmDialog
+        visible={confirmation.visible}
+        title={confirmation.snapshot?.input.mode === 'immediate' ? 'Encerrar imediatamente?' : 'Iniciar encerramento controlado?'}
+        message={confirmation.snapshot ? EFFECTS[confirmation.snapshot.input.mode] : ''}
+        note="Esta ação é simulada e não pode ser desfeita nesta demonstração."
+        confirmLabel="ENCERRAR EVENTO"
+        variant="danger"
+        onConfirm={() => handleConfirm(confirmation.pending)}
+        onCancel={confirmation.cancel}
+      />
+    </AdminScreen>
+  );
+}
+
+const styles = StyleSheet.create({
+  line: { color: adminColors.text, fontSize: 13, lineHeight: 19, marginTop: 4 },
+  muted: { color: adminColors.muted, fontSize: 13, lineHeight: 19, marginTop: 8 },
+});
diff --git a/app/screens/admin/AdminEventDetailScreen.js b/app/screens/admin/AdminEventDetailScreen.js
new file mode 100644
--- /dev/null
+++ b/app/screens/admin/AdminEventDetailScreen.js
@@ -0,0 +1,268 @@
+import { StyleSheet, Text } from 'react-native';
+
+import { adminReadinessLabels } from '../../data/adminDemoData';
+import AdminButton from './components/AdminButton';
+import AdminCard from './components/AdminCard';
+import AdminDemoTools from './components/AdminDemoTools';
+import AdminMissing from './components/AdminMissing';
+import AdminNotice from './components/AdminNotice';
+import AdminPhaseBadge from './components/AdminPhaseBadge';
+import AdminScreen from './components/AdminScreen';
+import { adminColors } from './components/adminTheme';
+import { useAdminDemo } from './AdminDemoContext';
+import {
+  describeEvent,
+  findEvent,
+  getCapacityGaps,
+  getCloseAvailability,
+  getExternalQueueAvailability,
+  getScheduleChangeAvailability,
+  phaseText,
+} from './adminDemoState';
+import { formatInstantWithZone, minutesBetween } from './adminTime';
+
+const ACTION_LABELS = {
+  CREATE: 'Cadastro',
+  SCHEDULE: 'Alteração de horários',
+  EXTERNAL_QUEUE: 'Fila externa',
+  CLOSE: 'Encerramento antecipado',
+  CONTROLLED_DEADLINE: 'Prazo do encerramento controlado',
+  EXPERIENCE_CREATE: 'Nova experiência',
+  EXPERIENCE_RENAME: 'Experiência renomeada',
+  STATION_CREATE: 'Nova estação',
+  STATION_RENAME: 'Estação renomeada',
+  STATION_AVAILABILITY: 'Disponibilidade de estação',
+  STAFF_GRANT: 'Staff concedido',
+  STAFF_REVOKE: 'Staff revogado',
+};
+
+const ownParam = (params, key) =>
+  (params != null && Object.prototype.hasOwnProperty.call(params, key) ? params[key] : undefined);
+
+// Detalhe e gestão do evento (ADM01–ADM03): configuração, fase efetiva,
+// prontidão calculada, capacidade operacional atual, estrutura e ações
+// demonstrativas permitidas pela arquitetura. Não há "Abrir Evento" (abertura
+// automática) nem exclusão física.
+export default function AdminEventDetailScreen({ navigation, route }) {
+  const { session } = useAdminDemo();
+  const eventId = ownParam(route?.params, 'eventId');
+  const event = session ? findEvent(session, eventId) : null;
+
+  if (!event) {
+    return (
+      <AdminMissing
+        title="Evento não encontrado"
+        message="Este evento não existe nesta sessão de demonstração."
+        actionLabel="VOLTAR AOS EVENTOS"
+        onAction={() => navigation.goBack()}
+      />
+    );
+  }
+
+  const now = session.clockNow;
+  const info = describeEvent(event, now, session);
+  const structure = info.readiness.structure;
+  const tz = event.timezone;
+  const margin = minutesBetween(event.officialEndsAt, event.operationalDeadlineAt);
+  const schedule = getScheduleChangeAvailability(event, now);
+  const queue = getExternalQueueAvailability(event, now);
+  const close = getCloseAvailability(event, now);
+
+  return (
+    <AdminScreen
+      title={event.name}
+      subtitle={`Código de ingresso: ${event.accessCode} · imutável`}
+      backLabel="Eventos"
+      onBack={() => navigation.goBack()}
+    >
+      {ownParam(route?.params, 'created') === true ? (
+        <AdminNotice
+          tone="success"
+          title="Evento criado na demonstração"
+          message='Cadastrado como "Agendado" e ainda não pronto. Nada foi enviado ao servidor.'
+        />
+      ) : null}
+
+      <AdminPhaseBadge phase={info.phase} waitingReadiness={info.waitingReadiness} />
+      <Text style={styles.line}>
+        Status armazenado: {phaseText(info.statusStored)} · fase efetiva: {phaseText(info.phase)}
+      </Text>
+      {info.statusStored !== info.phase ? (
+        <Text style={styles.warning}>
+          O status armazenado está defasado: horários e prontidão prevalecem sobre ele.
+        </Text>
+      ) : null}
+      <Text style={info.acceptingNewParticipations ? styles.ok : styles.muted}>
+        {info.acceptingNewParticipations
+          ? 'Aceitando novas participações (simulado).'
+          : 'Não aceita novas participações agora.'}
+      </Text>
+      {info.capacitySuspended ? (
+        <AdminNotice
+          tone="warning"
+          title="Novas participações suspensas — o evento continua aberto"
+          message={`Motivo: ${getCapacityGaps(info.readiness).join(' e ')}. Participações, esperas, posições e conclusões existentes foram preservadas: nada foi encerrado ou cancelado. A capacidade volta sozinha ao restaurar Staff ou estação, desde que antes do corte de novas entradas.`}
+        />
+      ) : null}
+
+      <AdminCard>
+        <Text style={styles.cardTitle}>Configuração</Text>
+        <Text style={styles.line}>Fuso: {tz}</Text>
+        <Text style={styles.line}>Início: {formatInstantWithZone(event.startsAt, tz)}</Text>
+        <Text style={styles.line}>Encerramento oficial: {formatInstantWithZone(event.officialEndsAt, tz)}</Text>
+        <Text style={styles.line}>
+          Limite operacional: {formatInstantWithZone(event.operationalDeadlineAt, tz)} (margem de {margin} min)
+        </Text>
+        <Text style={styles.line}>Fila externa: {event.externalQueueEnabled ? 'habilitada' : 'desabilitada'}</Text>
+        <Text style={styles.line}>Novas entradas até: {formatInstantWithZone(info.entriesCutAt, tz)}</Text>
+        <Text style={styles.line}>Chamadas e conclusões até: {formatInstantWithZone(info.operationalCutAt, tz)}</Text>
+        {info.openedAt ? (
+          <Text style={styles.line}>Abertura automática registrada em: {formatInstantWithZone(info.openedAt, tz)}</Text>
+        ) : null}
+        {event.closureMode ? (
+          <Text style={styles.warning}>
+            Encerramento administrativo {event.closureMode === 'immediate' ? 'imediato' : 'controlado'} pedido em{' '}
+            {formatInstantWithZone(event.closureRequestedAt, tz)}; prazo Admin: {formatInstantWithZone(event.adminDeadlineAt, tz)}.
+          </Text>
+        ) : null}
+      </AdminCard>
+
+      <AdminCard>
+        <Text style={styles.cardTitle}>
+          Prontidão: {info.readiness.ready ? 'pronto ✓' : 'não pronto ✗'}
+        </Text>
+        {Object.keys(adminReadinessLabels).map((key) => (
+          <Text
+            key={key}
+            style={info.readiness.checks[key] ? styles.ok : styles.missing}
+            accessibilityLabel={`${adminReadinessLabels[key]}: ${info.readiness.checks[key] ? 'atendido' : 'faltando'}`}
+          >
+            {info.readiness.checks[key] ? '✓' : '✗'} {adminReadinessLabels[key]}
+          </Text>
+        ))}
+        <Text style={styles.muted}>
+          O evento abre sozinho a partir do início quando estiver pronto e antes do corte de entradas. Não existe botão “Abrir Evento”.
+        </Text>
+        <Text style={styles.muted}>
+          Prontidão calculada a partir das experiências, estações e vínculos Staff cadastrados abaixo (sem exigir Staff conectado).
