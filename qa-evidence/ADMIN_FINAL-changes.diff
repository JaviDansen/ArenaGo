+  { id: 'demo-admin-eval-summer-07', eventId: 'demo-admin-summer', revisions: [{ score: 4, at: '2026-08-21T12:00:00.000Z' }, { score: 1, at: '2026-08-18T21:00:00.000Z' }] },
