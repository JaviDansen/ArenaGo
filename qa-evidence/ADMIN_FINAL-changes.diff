@@ -0,0 +1,272 @@
+import { useState } from 'react';
+import { StyleSheet, Text } from 'react-native';
+
+import { ADMIN_EXPERIENCE_NAME_MAX_LENGTH, ADMIN_STATION_LABEL_MAX_LENGTH, adminStationLabelPrefixes } from '../../data/adminDemoData';
+import AdminButton from './components/AdminButton';
+import AdminCard from './components/AdminCard';
+import AdminConfirmDialog from './components/AdminConfirmDialog';
+import AdminDemoTools from './components/AdminDemoTools';
+import AdminField from './components/AdminField';
+import AdminMissing from './components/AdminMissing';
+import AdminNotice from './components/AdminNotice';
+import AdminScreen from './components/AdminScreen';
+import AdminSuggestions from './components/AdminSuggestions';
+import { adminColors } from './components/adminTheme';
+import { useAdminDemo } from './AdminDemoContext';
+import {
+  addStation,
+  describeExperience,
+  findEvent,
+  findExperience,
+  getStructureRules,
+  renameExperience,
+} from './adminDemoState';
+import { formatInstant } from './adminTime';
+import { useAdminAction } from './useAdminAction';
+
+const ownParam = (params, key) =>
+  (params != null && Object.prototype.hasOwnProperty.call(params, key) ? params[key] : undefined);
+
+const DIALOGS = {
+  renameExperience: {
+    title: 'Renomear a experiência?',
+    note: 'A fila e as estações continuam as mesmas. Depois da primeira participação do evento não será mais possível renomear.',
+    confirmLabel: 'SALVAR NOME',
+  },
+  addStation: {
+    title: 'Adicionar esta estação?',
+    note: 'Ela começa disponível e atende a MESMA fila da experiência (não cria fila nova). Nada é enviado ao servidor.',
+    confirmLabel: 'ADICIONAR ESTAÇÃO',
+  },
+};
+
+// Detalhe da experiência (ADM02): nome, fila única e as estações que a
+// atendem. Disponibilidade e ocupação aparecem como conceitos separados.
+export default function AdminExperienceDetailScreen({ navigation, route }) {
+  const { session, run } = useAdminDemo();
+  const eventId = ownParam(route?.params, 'eventId');
+  const experienceId = ownParam(route?.params, 'experienceId');
+  const event = session ? findEvent(session, eventId) : null;
+  // A experiência só é encontrada pela cadeia deste evento (§18.1).
+  const experience = event ? findExperience(session, event.id, experienceId) : null;
+  const [name, setName] = useState(() => experience?.name ?? '');
+  const [label, setLabel] = useState('');
+  const action = useAdminAction(run);
+
+  if (!event || !experience) {
+    return (
+      <AdminMissing
+        title="Experiência não encontrada"
+        message="Esta experiência não existe neste evento da demonstração."
+        actionLabel="VOLTAR"
+        onAction={() => navigation.goBack()}
+      />
+    );
+  }
+
+  const rules = getStructureRules(session, event);
+  const view = describeExperience(session, event, experience);
+  const renameFeedback = action.feedbackFor('renameExperience');
+  const stationFeedback = action.feedbackFor('addStation');
+  const nextNumber = view.stationsTotal + 1;
+  const labelSuggestions = adminStationLabelPrefixes.map((prefix) => `${prefix} ${nextNumber}`);
+  const dialog = action.snapshot ? DIALOGS[action.snapshot.kind] : null;
+
+  function handleRename() {
+    if (action.busy) return;
+    const trimmed = name.trim();
+    if (!trimmed) {
+      action.reject('renameExperience', 'Revise o nome da experiência.', { name: 'Informe o nome da experiência.' });
+      return;
+    }
+    if (trimmed === experience.name) {
+      action.reject('renameExperience', 'O nome informado é igual ao atual.');
+      return;
+    }
+    action.review({
+      kind: 'renameExperience',
+      transition: renameExperience,
+      args: [event.id, experience.id, { name: trimmed }],
+      summary: `${experience.name} → ${trimmed}`,
+    });
+  }
+
+  function handleAddStation() {
+    if (action.busy) return;
+    const trimmed = label.trim();
+    if (!trimmed) {
+      action.reject('addStation', 'Revise a identificação da estação.', { label: 'Informe a identificação da estação.' });
+      return;
+    }
+    action.review({
+      kind: 'addStation',
+      transition: addStation,
+      args: [event.id, experience.id, { label: trimmed }],
+      summary: `${trimmed}\nExperiência: ${experience.name}`,
+      onSuccess: () => setLabel(''),
+    });
+  }
+
+  return (
+    <AdminScreen
+      title={experience.name}
+      subtitle={`Experiência de ${event.name} · ${event.accessCode}`}
+      backLabel="Experiências"
+      onBack={() => navigation.goBack()}
+    >
+      <AdminCard>
+        <Text style={styles.cardTitle}>Fila única da experiência</Text>
+        <Text style={styles.line}>Aguardando: {view.queueWaiting} (fictício)</Text>
+        <Text style={styles.line}>
+          Atendida por {view.stationsTotal} estação(ões): todas chamam desta mesma fila. Não existe fila por estação.
+        </Text>
+        <Text style={view.acceptingNewEntries ? styles.ok : styles.warning}>
+          {view.acceptingNewEntries
+            ? 'Novas entradas nesta fila: aceitas (simulado).'
+            : `Novas entradas nesta fila: suspensas — ${view.entriesBlockedReason}.`}
+        </Text>
+      </AdminCard>
+
+      <Text style={styles.sectionTitle} accessibilityRole="header">Nome da experiência</Text>
+      {rules.renameExperience.allowed ? (
+        <>
+          <AdminField
+            label="Nome da experiência *"
+            hint={`Até ${ADMIN_EXPERIENCE_NAME_MAX_LENGTH} caracteres.`}
+            value={name}
+            onChangeText={(value) => {
+              setName(value);
+              if (renameFeedback && renameFeedback.tone === 'error') action.clearFeedback();
+            }}
+            error={renameFeedback?.errors?.name}
+            maxLength={ADMIN_EXPERIENCE_NAME_MAX_LENGTH}
+            editable={!action.busy}
+          />
+          <AdminButton
+            label={action.saving === 'renameExperience' ? 'SALVANDO...' : 'SALVAR NOME'}
+            variant="secondary"
+            loading={action.saving === 'renameExperience'}
+            disabled={action.busy}
+            onPress={handleRename}
+          />
+        </>
+      ) : (
+        <AdminNotice tone="warning" title="Renomear indisponível" message={rules.renameExperience.message} />
+      )}
+      {renameFeedback ? (
+        <AdminNotice
+          tone={renameFeedback.tone}
+          title={renameFeedback.tone === 'success' ? 'Nome atualizado' : 'Não foi possível renomear'}
+          message={renameFeedback.text}
+        />
+      ) : null}
+
+      <Text style={styles.sectionTitle} accessibilityRole="header">Estações</Text>
+      <Text style={styles.muted}>
+        Disponível não quer dizer livre: uma estação disponível pode estar ocupada por uma chamada pendente.
+      </Text>
+      {view.stations.length === 0 ? (
+        <AdminNotice
+          tone="neutral"
+          title="Nenhuma estação nesta experiência"
+          message="Sem estação disponível, esta experiência não conta para a prontidão e não aceita novas entradas."
+        />
+      ) : null}
+      {view.stations.map(({ station, available, pendingCall }) => (
+        <AdminCard
+          key={station.id}
+          onPress={() => navigation.navigate('AdminStationDetail', {
+            eventId: event.id,
+            experienceId: experience.id,
+            stationId: station.id,
+          })}
+          accessibilityLabel={`Abrir estação ${station.label}`}
+        >
+          <Text style={styles.name}>{station.label}  →</Text>
+          <Text style={available ? styles.ok : styles.warning}>
+            Disponibilidade: {available ? 'disponível' : 'indisponível'}
+          </Text>
+          <Text style={styles.line}>
+            Ocupação: {rules.ended
+              ? 'sem chamadas vigentes (evento encerrado)'
+              : pendingCall
+                ? `chamada pendente desde ${formatInstant(pendingCall.calledAt, event.timezone)} (fictícia)`
+                : 'livre (sem chamada pendente)'}
+          </Text>
+        </AdminCard>
+      ))}
+
+      <Text style={styles.sectionTitle} accessibilityRole="header">Adicionar estação</Text>
+      {rules.addStation.allowed ? (
+        <>
+          {rules.history ? (
+            <Text style={styles.muted}>
+              O evento já teve participação, mas adicionar estação a uma experiência existente continua permitido: ela entra na mesma fila.
+            </Text>
+          ) : null}
+          <AdminField
+            label="Identificação da nova estação *"
+            hint={`Até ${ADMIN_STATION_LABEL_MAX_LENGTH} caracteres.`}
+            value={label}
+            onChangeText={(value) => {
+              setLabel(value);
+              if (stationFeedback && stationFeedback.tone === 'error') action.clearFeedback();
+            }}
+            placeholder={`Ex.: Estação ${nextNumber}`}
+            error={stationFeedback?.errors?.label}
+            maxLength={ADMIN_STATION_LABEL_MAX_LENGTH}
+            editable={!action.busy}
+          />
+          <AdminSuggestions
+            label="Atalhos de preenchimento (não é um catálogo de estações):"
+            items={labelSuggestions}
+            disabled={action.busy}
+            onPick={(value) => {
+              setLabel(value);
+              if (stationFeedback && stationFeedback.tone === 'error') action.clearFeedback();
+            }}
+          />
+          <AdminButton
+            label={action.saving === 'addStation' ? 'ADICIONANDO...' : 'ADICIONAR ESTAÇÃO'}
+            loading={action.saving === 'addStation'}
+            disabled={action.busy}
+            onPress={handleAddStation}
+          />
+        </>
+      ) : (
+        <AdminNotice tone="warning" title="Adicionar estação indisponível" message={rules.addStation.message} />
+      )}
+      {stationFeedback ? (
+        <AdminNotice
+          tone={stationFeedback.tone}
+          title={stationFeedback.tone === 'success' ? 'Estação adicionada' : 'Não foi possível adicionar'}
+          message={stationFeedback.text}
+        />
+      ) : null}
+
+      <AdminButton label="Voltar às experiências" variant="secondary" disabled={action.busy} onPress={() => navigation.goBack()} />
+
+      <AdminDemoTools disabled={action.busy} />
+
+      <AdminConfirmDialog
+        visible={action.dialog.visible}
+        title={dialog?.title ?? ''}
+        message={action.snapshot?.summary ?? ''}
+        note={dialog?.note}
+        confirmLabel={dialog?.confirmLabel}
+        onConfirm={action.dialog.onConfirm}
+        onCancel={action.dialog.onCancel}
+      />
+    </AdminScreen>
+  );
+}
+
+const styles = StyleSheet.create({
+  cardTitle: { color: adminColors.text, fontSize: 15, fontWeight: 'bold', marginBottom: 4 },
+  name: { color: adminColors.text, fontSize: 16, fontWeight: 'bold' },
+  sectionTitle: { color: adminColors.text, fontSize: 18, fontWeight: 'bold', marginTop: 24 },
+  line: { color: adminColors.text, fontSize: 13, lineHeight: 19, marginTop: 4 },
+  muted: { color: adminColors.muted, fontSize: 13, lineHeight: 19, marginTop: 6 },
+  ok: { color: adminColors.success, fontSize: 13, lineHeight: 19, marginTop: 6 },
+  warning: { color: adminColors.warning, fontSize: 13, lineHeight: 19, marginTop: 6 },
+});
diff --git a/app/screens/admin/AdminHistoryScreen.js b/app/screens/admin/AdminHistoryScreen.js
new file mode 100644
--- /dev/null
+++ b/app/screens/admin/AdminHistoryScreen.js
@@ -0,0 +1,146 @@
+import { useEffect, useRef, useState } from 'react';
+import { StyleSheet, Text } from 'react-native';
+
+import AdminButton from './components/AdminButton';
+import AdminCard from './components/AdminCard';
+import AdminDemoTools from './components/AdminDemoTools';
+import AdminField from './components/AdminField';
+import AdminMissing from './components/AdminMissing';
+import AdminNotice from './components/AdminNotice';
+import AdminOptions from './components/AdminOptions';
+import AdminPhaseBadge from './components/AdminPhaseBadge';
+import AdminScreen from './components/AdminScreen';
+import { adminColors } from './components/adminTheme';
+import { useAdminDemo } from './AdminDemoContext';
+import { waitAdminDemoLatency } from './adminDemoLatency';
+import { ADMIN_CLOSURE_LABELS, listHistory } from './adminInsights';
+import { adminBiPeriods } from '../../data/adminDemoData';
+import { formatInstant } from './adminTime';
+
+const PERIODS = adminBiPeriods.map((item) => ({
+  value: item.id,
+  label: item.label,
+  accessibilityLabel: `Período: ${item.label}`,
+}));
+
+// Histórico (ADM03): eventos efetivamente encerrados no estado atual da
+// demonstração (inclui os encerrados na própria sessão), com busca e período.
+export default function AdminHistoryScreen({ navigation }) {
+  const { session, simulateLoad } = useAdminDemo();
+  const [status, setStatus] = useState('loading');
+  const [loadError, setLoadError] = useState('');
+  const [query, setQuery] = useState('');
+  const [period, setPeriod] = useState('all');
+  const [attempt, setAttempt] = useState(0);
+  const mountedRef = useRef(true);
+
+  useEffect(() => {
+    mountedRef.current = true;
+    return () => { mountedRef.current = false; };
+  }, []);
+
+  useEffect(() => {
+    let active = true;
+    setStatus('loading');
+    waitAdminDemoLatency().then(() => {
+      if (!active || !mountedRef.current) return;
+      const result = simulateLoad();
+      setLoadError(result.ok ? '' : result.message);
+      setStatus(result.ok ? 'ready' : 'error');
+    });
+    return () => { active = false; };
+  }, [attempt]);
+
+  if (!session) {
+    return (
+      <AdminMissing
+        title="Sessão indisponível"
+        message="Abra a Área Admin novamente a partir do aplicativo."
+        actionLabel="VOLTAR"
+        onAction={() => navigation.goBack()}
+      />
+    );
+  }
+
+  const items = status === 'ready' ? listHistory(session, { query, period }) : [];
+  const hasAny = status === 'ready' && listHistory(session).length > 0;
+
+  return (
+    <AdminScreen
+      title="Histórico"
+      highlight="de Eventos"
+      subtitle="Eventos encerrados e seus resultados agregados da demonstração."
+      backLabel="Painel"
+      onBack={() => navigation.goBack()}
+    >
+      <AdminNotice
+        tone="warning"
+        title="Resultados fictícios"
+        message="Os números desta área são simulados para a demonstração. Não são resultados reais de nenhum evento."
+      />
+
+      <AdminField
+        label="Buscar no histórico"
+        hint="Por nome ou código de ingresso."
+        value={query}
+        onChangeText={setQuery}
+        placeholder="Ex.: SUMMER"
+        autoCapitalize="none"
+      />
+      <AdminOptions label="Período (início do evento)" options={PERIODS} value={period} onChange={setPeriod} />
+
+      {status === 'loading' ? (
+        <AdminNotice tone="neutral" title="Carregando histórico..." message="Carregamento simulado da demonstração." />
+      ) : null}
+
+      {status === 'error' ? (
+        <AdminNotice tone="error" title="Não foi possível carregar" message={loadError}>
+          <AdminButton compact variant="secondary" label="Tentar novamente" onPress={() => setAttempt((n) => n + 1)} />
+        </AdminNotice>
+      ) : null}
+
+      {status === 'ready' && !hasAny ? (
+        <AdminNotice tone="neutral" title="Nenhum evento encerrado" message="Quando um evento for encerrado, ele aparecerá aqui." />
+      ) : null}
+
+      {status === 'ready' && hasAny && items.length === 0 ? (
+        <AdminNotice tone="neutral" title="Nenhum evento encontrado" message="Ajuste a busca ou o período." />
+      ) : null}
+
+      {items.map((item) => (
+        <AdminCard
+          key={item.event.id}
+          onPress={() => navigation.navigate('AdminEventBi', { eventId: item.event.id })}
+          accessibilityLabel={`Abrir BI de ${item.event.name}, código ${item.event.accessCode}`}
+        >
+          <Text style={styles.name}>{item.event.name}</Text>
+          <Text style={styles.code}>Código: {item.event.accessCode}</Text>
+          <AdminPhaseBadge phase={item.info.phase} />
+          <Text style={styles.line}>{ADMIN_CLOSURE_LABELS[item.closureKind]}</Text>
+          <Text style={styles.line}>
+            {formatInstant(item.event.startsAt, item.event.timezone)} → encerrado em {formatInstant(item.closedAt, item.event.timezone)}
+          </Text>
+          <Text style={styles.line}>Fuso: {item.event.timezone}</Text>
+          <Text style={styles.value}>
+            {item.participations.finished} participação(ões) finalizada(s) (simulado)
+          </Text>
+          {item.participations.adminFinalized > 0 ? (
+            <Text style={styles.note}>
+              {item.participations.adminFinalized} delas finalizada(s) pelo encerramento administrativo.
+            </Text>
+          ) : null}
+        </AdminCard>
+      ))}
+
+      <AdminDemoTools />
+    </AdminScreen>
+  );
+}
+
+const styles = StyleSheet.create({
+  name: { color: adminColors.text, fontSize: 16, fontWeight: 'bold' },
+  code: { color: adminColors.accent, fontSize: 13, fontWeight: '600', marginTop: 2 },
+  line: { color: adminColors.muted, fontSize: 13, marginTop: 6 },
+  value: { color: adminColors.text, fontSize: 14, fontWeight: '600', marginTop: 8 },
+  note: { color: adminColors.warning, fontSize: 12, lineHeight: 17, marginTop: 6 },
+});
diff --git a/app/screens/admin/AdminOverviewScreen.js b/app/screens/admin/AdminOverviewScreen.js
new file mode 100644
--- /dev/null
+++ b/app/screens/admin/AdminOverviewScreen.js
@@ -0,0 +1,262 @@
+import { useEffect, useRef, useState } from 'react';
+import { StyleSheet, Text, View } from 'react-native';
+
+import { adminBiPeriods } from '../../data/adminDemoData';
+import AdminButton from './components/AdminButton';
+import AdminCard from './components/AdminCard';
+import AdminDemoTools from './components/AdminDemoTools';
+import AdminMissing from './components/AdminMissing';
+import AdminNotice from './components/AdminNotice';
+import AdminOptions from './components/AdminOptions';
+import AdminRatings, { AdminDuration } from './components/AdminRatings';
+import AdminScreen from './components/AdminScreen';
+import { adminColors } from './components/adminTheme';
+import { useAdminDemo } from './AdminDemoContext';
+import { waitAdminDemoLatency } from './adminDemoLatency';
+import { getOverview, listPeriodEvents } from './adminInsights';
+
+const PERIODS = adminBiPeriods.map((item) => ({
+  value: item.id,
+  label: item.label,
+  accessibilityLabel: `Período: ${item.label}`,
+}));
+
+function Tile({ label, value }) {
+  return (
+    <View style={styles.tile} accessible accessibilityLabel={`${label}: ${value}`}>
+      <Text style={styles.tileValue}>{value}</Text>
+      <Text style={styles.tileLabel}>{label}</Text>
+    </View>
+  );
+}
+
+// Visão Geral / BI consolidado (ADM03). Mesma sessão das ADM01–ADM02:
+// período (início do evento até o relógio de teste) e seleção de eventos
+// (nenhum marcado = todos do período). Só agregados (D10).
+export default function AdminOverviewScreen({ navigation }) {
+  const { session, simulateLoad } = useAdminDemo();
+  const [status, setStatus] = useState('loading');
+  const [loadError, setLoadError] = useState('');
+  const [attempt, setAttempt] = useState(0);
+  const [period, setPeriod] = useState('all');
+  const [selected, setSelected] = useState([]);
+  const mountedRef = useRef(true);
+
+  useEffect(() => {
+    mountedRef.current = true;
+    return () => { mountedRef.current = false; };
+  }, []);
+
+  useEffect(() => {
+    let active = true;
+    setStatus('loading');
+    waitAdminDemoLatency().then(() => {
+      if (!active || !mountedRef.current) return;
+      const result = simulateLoad();
+      setLoadError(result.ok ? '' : result.message);
+      setStatus(result.ok ? 'ready' : 'error');
+    });
+    return () => { active = false; };
+  }, [attempt]);
+
+  if (!session) {
+    return (
+      <AdminMissing
+        title="Sessão indisponível"
+        message="Abra a Área Admin novamente a partir do aplicativo."
+        actionLabel="VOLTAR"
+        onAction={() => navigation.goBack()}
+      />
+    );
+  }
+
+  const periodEvents = listPeriodEvents(session, period);
+  // Seleção fora do período é ignorada (sem estado paralelo de eventos).
+  const activeSelection = selected.filter((id) => periodEvents.some((event) => event.id === id));
+  const overview = status === 'ready' ? getOverview(session, { period, eventIds: activeSelection }) : null;
+
+  function toggle(eventId) {
+    setSelected((current) => (current.includes(eventId)
+      ? current.filter((id) => id !== eventId)
+      : [...current, eventId]));
+  }
+
+  return (
+    <AdminScreen
+      title="Visão"
+      highlight="Geral"
+      subtitle="BI consolidado da demonstração da plataforma."
+      backLabel="Painel"
+      onBack={() => navigation.goBack()}
+    >
+      <AdminNotice
+        tone="warning"
+        title="Indicadores fictícios"
+        message="Calculados a partir dos dados simulados desta sessão e do relógio de teste. Nenhum resultado real é exibido."
+      />
+
+      <AdminOptions
+        label="Período"
+        hint="Considera a data de início do evento até o relógio da demonstração. Todo o período inclui eventos futuros."
+        options={PERIODS}
+        value={period}
+        onChange={setPeriod}
+      />
+
+      <Text style={styles.label}>Eventos</Text>
+      <Text style={styles.hint}>Nenhum marcado = todos os eventos do período.</Text>
+      <View style={styles.wrap}>
+        {periodEvents.map((event) => (
+          <View key={event.id} style={styles.item}>
+            <AdminButton
+              compact
+              multiple
+              variant="secondary"
+              label={event.accessCode}
+              accessibilityLabel={`Selecionar ${event.name}`}
+              selected={activeSelection.includes(event.id)}
+              onPress={() => toggle(event.id)}
+            />
+          </View>
+        ))}
+      </View>
+      {activeSelection.length > 0 ? (
+        <AdminButton compact variant="ghost" label="Limpar seleção (todos)" onPress={() => setSelected([])} />
+      ) : null}
+      {activeSelection.length === 1 ? (
+        <AdminButton
+          label="Abrir BI do evento selecionado"
+          onPress={() => navigation.navigate('AdminEventBi', { eventId: activeSelection[0] })}
+        />
+      ) : null}
+
+      {status === 'loading' ? (
+        <AdminNotice tone="neutral" title="Carregando indicadores..." message="Carregamento simulado da demonstração." />
+      ) : null}
+
+      {status === 'error' ? (
+        <AdminNotice tone="error" title="Não foi possível carregar" message={loadError}>
+          <AdminButton compact variant="secondary" label="Tentar novamente" onPress={() => setAttempt((n) => n + 1)} />
+        </AdminNotice>
+      ) : null}
+
+      {overview && overview.empty ? (
+        <AdminNotice tone="neutral" title="Nenhum evento no período" message="Escolha outro período para ver indicadores." />
+      ) : null}
+
+      {overview && overview.insufficient ? (
+        <AdminNotice
+          tone="info"
+          title="Dados insuficientes"
+          message="Os eventos escolhidos ainda não têm participações, atendimentos nem avaliações."
+        />
+      ) : null}
+
+      {overview && !overview.empty ? (
+        <>
+          <Text style={styles.scope}>
+            {overview.period.label} · {overview.events.length} evento(s) {activeSelection.length > 0 ? 'selecionado(s)' : 'no período'}
+          </Text>
+
+          <Text style={styles.heading} accessibilityRole="header">Eventos por fase</Text>
+          <View style={styles.grid}>
+            <Tile label="Eventos" value={overview.phases.total} />
+            <Tile label="Agendados" value={overview.phases.scheduled} />
+            <Tile label="Abertos" value={overview.phases.open} />
+            <Tile label="Encerrando" value={overview.phases.closing} />
+            <Tile label="Encerrados" value={overview.phases.closed} />
+            <Tile label="Não prontos" value={overview.phases.notReady} />
+          </View>
+
+          <Text style={styles.heading} accessibilityRole="header">Participações (estado atual)</Text>
+          <View style={styles.grid}>
+            <Tile label="Registradas" value={overview.participations.registered} />
+            <Tile label="Ativas" value={overview.participations.active} />
+            <Tile label="Na fila externa" value={overview.participations.externalWaiting} />
+            <Tile label="Finalizadas" value={overview.participations.finished} />
+          </View>
+          <Text style={styles.note}>
+            {overview.participations.adminFinalized} das finalizadas foram finalizadas pelo encerramento administrativo
+            (não contam como experiência concluída nem avaliação).
+          </Text>
+
+          <Text style={styles.heading} accessibilityRole="header">Experiências e estações</Text>
+          <View style={styles.grid}>
+            <Tile label="Atendimentos concluídos" value={overview.completions.completed} />
+            <Tile label="Ausências marcadas" value={overview.completions.absences} />
+            <Tile label="Estações com atendimento" value={`${overview.completions.stationsWithCompletions}/${overview.completions.stations}`} />
+          </View>
+          <AdminCard>
+            <Text style={styles.cardTitle}>Experiências mais utilizadas</Text>
+            {overview.topExperiences.length === 0 ? (
+              <Text style={styles.line}>Sem atendimentos registrados nos eventos escolhidos.</Text>
+            ) : overview.topExperiences.map((item, index) => (
+              <Text key={item.id} style={styles.line}>
+                {index + 1}. {item.name} ({item.eventName}): {item.completed} atendimento(s)
+              </Text>
+            ))}
+          </AdminCard>
+
+          <Text style={styles.heading} accessibilityRole="header">Avaliações</Text>
+          <AdminCard>
+            <Text style={styles.line}>
+              Participações finalizadas fora do encerramento administrativo: {overview.participations.finishedOutsideAdmin}
+            </Text>
+            <AdminRatings summary={overview.evaluations} />
+          </AdminCard>
+
+          <Text style={styles.heading} accessibilityRole="header">Tempo</Text>
+          <AdminCard>
+            <AdminDuration label="Entrada até a última experiência concluída" summary={overview.time.lastCompletion} population="participação(ões) com experiência concluída" />
+            <AdminDuration label="Entrada até a saída voluntária" summary={overview.time.voluntaryExit} population="saída(s) voluntária(s)" />
+          </AdminCard>
+        </>
+      ) : null}
+
+      <Text style={styles.heading} accessibilityRole="header">Exportação</Text>
+      <AdminButton
+        variant="secondary"
+        label="Exportar CSV/XLSX (indisponível)"
+        disabled
+        onPress={() => {}}
+        accessibilityHint="Exportação ainda não especificada"
+      />
+      <Text style={styles.note}>
+        A exportação manual por download está prevista (RA-01), mas formatos, filtros e permissões ainda não foram
+        aprovados. Nenhum arquivo é gerado nesta demonstração.
+      </Text>
+
+      <AdminNotice
+        tone="neutral"
+        title="Privacidade (D10)"
+        message="Só números agregados: nenhum participante é identificado. Perfil do público indisponível até haver política aprovada."
+      />
+
+      <AdminDemoTools />
+    </AdminScreen>
+  );
+}
+
+const styles = StyleSheet.create({
+  heading: { color: adminColors.text, fontSize: 18, fontWeight: 'bold', marginTop: 24 },
+  label: { color: adminColors.text, fontSize: 14, fontWeight: 'bold', marginTop: 16 },
+  hint: { color: adminColors.muted, fontSize: 12, lineHeight: 17, marginTop: 2 },
+  wrap: { flexDirection: 'row', flexWrap: 'wrap', marginHorizontal: -4 },
+  item: { paddingHorizontal: 4 },
+  scope: { color: adminColors.accent, fontSize: 13, fontWeight: '600', marginTop: 16 },
+  grid: { flexDirection: 'row', flexWrap: 'wrap', marginHorizontal: -6, marginTop: 6 },
+  tile: {
+    backgroundColor: adminColors.surface,
+    borderColor: adminColors.border,
+    borderRadius: 12,
+    borderWidth: 1,
+    margin: 6,
+    padding: 12,
+    width: '45%',
+  },
+  tileValue: { color: adminColors.text, fontSize: 22, fontWeight: 'bold' },
+  tileLabel: { color: adminColors.muted, fontSize: 12, marginTop: 2 },
+  cardTitle: { color: adminColors.text, fontSize: 15, fontWeight: 'bold' },
+  line: { color: adminColors.muted, fontSize: 13, lineHeight: 19, marginTop: 6 },
+  note: { color: adminColors.muted, fontSize: 12, lineHeight: 17, marginTop: 8 },
+});
