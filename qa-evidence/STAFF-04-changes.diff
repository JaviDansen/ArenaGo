+        if (g.fail) throw g.fail;
+      }
+      if (ackGate && key === ackKey) {
+        const g = ackGate;
+        ackGate = null;
+        await g.promise;
+      }
+    },
+    onSecureDelete: async (key) => {
+      if (clearGate && key === primaryKey) {
+        const g = clearGate;
+        clearGate = null;
