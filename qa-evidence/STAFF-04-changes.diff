+  let currentState = makeStateFor(EV_A, true);
+
+  const reservedSeed = new Map([
+    [entrySlot, JSON.stringify({
+      userId: USER_1,
+      sessionId: SESSION_1,
+      eventId: EV_A,
+      key: '50000000-0000-4000-8000-000000000093',
