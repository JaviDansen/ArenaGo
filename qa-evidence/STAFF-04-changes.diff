+          id: SESS_1,
+          queueEntryId: ENTRY_1,
+          experienceId: EXP_1,
+          station: { id: ST_1, label: 'Cabine 01' },
+          status: 'pending',
+          calledAt: '2026-11-19T15:00:00.000Z',
