+      } else if (transition === 'new_session_same_account') {
+        participantName = 'Fila Nova Sessão';
+        await h.rerender({
+          auth: {
+            isAuthenticated: true,
+            user: { id: USER_1, roles: ['staff'] },
+            sessionId: SESSION_2,
+            isIdentityVerified: () => true,
+            getSessionEpoch: () => 2,
+            getIdentityRevision: () => 1,
+          },
