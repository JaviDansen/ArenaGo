+  assert.equal(store.getSnapshot().queueError, null);
+  assert.equal(store.getSnapshot().queue.waitingCount, 3);
+
+  // Negativa de autorização (403) bloqueia acesso e impede novas consultas em pollQueue
+  queueMode = '403';
