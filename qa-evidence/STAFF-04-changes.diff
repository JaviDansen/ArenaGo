+    get: async (path, opts) => {
+      calls.push({ method: 'GET', path, opts });
+      if (mode === 'timeout') throw Object.assign(new Error('timeout'), { isTimeout: true });
+      if (mode === '503') throw Object.assign(new Error('unavailable'), { status: 503 });
