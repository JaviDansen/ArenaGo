+        return { eventId: EV_A, experienceId: EXP_1, waitingCount: 1, canCallWaitingEntries: true, firstWaitingQueueEntryId: ENTRY_1 };
+      }
+      return activeState;
+    },
+    onPost: async () => {
+      postCalls += 1;
+      if (postDeferred) {
+        const d = postDeferred;
+        postDeferred = null;
