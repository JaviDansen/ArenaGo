+  let nextState = initialState;
+
+  const h = createStationHarness({
+    onAccessDenied: (kind) => {
+      accessDeniedKind = kind;
+      void h.rerender({ accessDenied: true, accessDeniedKind: kind });
+    },
+    onGet: async (url) => {
+      if (url.endsWith('/operational-state')) {
+        opGets += 1;
+        if (deferredOp) {
