+      manualDeferred.resolve(updatedState);
+      await pManual;
+    });
+    assert.ok(h.hasQueueRow(1, 'Camila Souza'));
+
+    await h.act(async () => {
+      poll1Deferred.resolve(initialState);
+      await pPoll1;
+    });
