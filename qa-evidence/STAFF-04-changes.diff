+test('STAFF04-AUD-01: pause/resume via enabled, foco e AppState durante leitura pendente nunca sobrepõe execuções nem duplica timers', { skip }, async () => {
+  globalThis.IS_REACT_ACT_ENVIRONMENT = true;
