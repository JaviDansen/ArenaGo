+    assert.equal(calls, 4);
+    assert.equal(f.timers.size, 1);
+    void rejecting;
+    rejectPending3?.(new Error('unused'));
+    rejecting.catch(() => {});
+  } finally {
+    pending1.resolve();
+    pending2.resolve();
+    pending3.resolve();
+    try { if (renderer) await Renderer.act(async () => renderer.unmount()); } finally { f.restore(); }
