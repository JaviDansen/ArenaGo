+      qGate.resolve({ eventId: EV_A, experienceId: EXP_1, waitingCount: 1, canCallWaitingEntries: true, firstWaitingQueueEntryId: ENTRY_1 });
+      sGate.resolve({ eventId: EV_A, stations: [] });
+      if (pCall) await pCall.catch(() => {});
