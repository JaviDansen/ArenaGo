+  noDevice: number;
+  expired: number;
+  retried: number;
+  failed: number;
+}
+
+type ClaimedOutboxRow = {
+  id: string;
+  serviceSessionId: string;
+  userId: string;
+  eventId: string;
+  experienceId: string;
+  payload: QueueCallOutboxPayload;
+  attempts: number;
+};
+
+type AcceptedOutboxRow = {
+  id: string;
+  serviceSessionId: string;
+  userId: string;
+  ticketId: string;
+  payload?: QueueCallOutboxPayload;
+  attempts: number;
+};
+
+interface ExpoPushTicket {
+  status: "ok" | "error";
+  id?: string;
+  message?: string;
+  details?: {
+    error?: string;
+  };
+}
+
+interface ExpoPushReceipt {
+  status: "ok" | "error";
+  message?: string;
+  details?: {
+    error?: string;
+  };
+}
+
+class TicketDispatchError extends Error {
+  constructor(
+    message: string,
+    public readonly retryable: boolean,
+  ) {
+    super(message);
+    this.name = "TicketDispatchError";
+  }
+}
+
+export function getOutboxRetryDelaySeconds(attemptNumber: number): number {
+  const index = Math.max(0, Math.min(attemptNumber - 1, OUTBOX_RETRY_DELAYS_SECONDS.length - 1));
+  return OUTBOX_RETRY_DELAYS_SECONDS[index];
+}
+
+@Injectable()
+export class QueueCallPushService implements OnApplicationBootstrap, BeforeApplicationShutdown {
+  private readonly logger = new Logger(QueueCallPushService.name);
+  private inFlightDispatch: Promise<DispatchOutboxResult> | null = null;
+  private pollTimer: ReturnType<typeof setTimeout> | null = null;
+  private stopped = false;
+  private httpTimeoutMs = EXPO_HTTP_TIMEOUT_MS;
+  private readonly ticketTokenCache = new Map<string, string>();
+
+  constructor(
+    @Inject(DRIZZLE_DATABASE)
+    private readonly database: NodePgDatabase<typeof schema>,
+    @Inject(DeviceTokensService)
+    private readonly deviceTokensService: DeviceTokensService,
+    @Optional()
+    @Inject(PUSH_HTTP_TRANSPORT)
+    private readonly transport?: PushHttpTransport,
+  ) {}
+
+  setHttpTimeoutMs(timeoutMs: number): void {
+    if (Number.isFinite(timeoutMs) && timeoutMs > 0) {
+      this.httpTimeoutMs = Math.floor(timeoutMs);
+    }
+  }
+
+  getHttpTimeoutMs(): number {
+    return this.httpTimeoutMs;
+  }
+
+  async onApplicationBootstrap(): Promise<void> {
+    const enabled =
+      process.env.NODE_ENV !== "test" ||
+      process.env.QUEUE_CALL_OUTBOX_JOB_TEST_ENABLED === "true";
+    if (!enabled) {
+      return;
+    }
+    await this.recoverOnStartup();
+    this.startScheduler();
+  }
+
+  async beforeApplicationShutdown(): Promise<void> {
+    await this.stopScheduler();
+  }
+
+  /**
+   * Retoma pendências após reinício do servidor:
+   * - Expira ou libera registros presos em `processing` com lock expirado.
+   * - Reprocessa registros `pending` elegíveis e verifica recibos de registros `accepted`.
+   */
+  async recoverOnStartup(): Promise<DispatchOutboxResult> {
+    try {
+      return await this.dispatchPending();
+    } catch (err) {
+      this.logger.error("Falha na recuperação inicial da outbox de chamadas:", err);
+      return {
+        processed: 0,
+        accepted: 0,
+        delivered: 0,
+        noDevice: 0,
+        expired: 0,
+        retried: 0,
+        failed: 0,
+      };
+    }
+  }
+
+  startScheduler(intervalMs = DEFAULT_OUTBOX_POLL_INTERVAL_MS): void {
+    this.stopped = false;
+    if (this.pollTimer) {
+      clearTimeout(this.pollTimer);
+      this.pollTimer = null;
+    }
+    const scheduleNext = () => {
+      if (this.stopped) return;
+      this.pollTimer = setTimeout(() => {
+        void this.dispatchPending()
+          .catch((err) => {
+            this.logger.error("Erro no ciclo periódico da outbox de chamadas:", err);
+          })
+          .finally(() => {
+            scheduleNext();
+          });
+      }, intervalMs);
+      this.pollTimer.unref?.();
+    };
+    scheduleNext();
+  }
+
+  async stopScheduler(): Promise<void> {
+    this.stopped = true;
+    if (this.pollTimer) {
+      clearTimeout(this.pollTimer);
+      this.pollTimer = null;
+    }
+    if (this.inFlightDispatch) {
+      await this.inFlightDispatch.catch(() => undefined);
+    }
+  }
+
+  /**
+   * Insere o registro de outbox na mesma transação que confirmou a chamada do Staff.
+   * A chave única em service_session_id garante no máximo um evento de alerta por atendimento.
+   */
+  async createOutboxEntryWithTx(
+    tx: { execute: (query: unknown) => Promise<unknown> },
+    input: CreateOutboxEntryInput,
+  ): Promise<string> {
+    const outboxId = randomUUID();
+    const payload: QueueCallOutboxPayload = {
+      type: "queue.called",
+      serviceSessionId: input.sessionId,
+      participationId: input.participationId,
+      eventId: input.eventId,
+      userId: input.userId,
+      calledAt: input.calledAt.toISOString(),
+      version: 1,
+    };
+
+    await tx.execute(sql`
+      INSERT INTO queue_call_outbox (
+        id,
+        service_session_id,
+        user_id,
+        event_id,
+        experience_id,
+        payload,
+        status,
+        attempts,
+        created_at
+      ) VALUES (
+        ${outboxId},
+        ${input.sessionId},
+        ${input.userId},
+        ${input.eventId},
+        ${input.experienceId},
+        ${JSON.stringify(payload)}::jsonb,
+        'pending',
+        0,
+        ${input.calledAt}
+      )
+      ON CONFLICT (service_session_id) DO NOTHING
+    `);
+
+    return outboxId;
+  }
+
+  /**
+   * Dispara a entrega de forma assíncrona pós-commit, sem bloquear nem propagar erros.
+   */
+  triggerDispatch(): void {
+    setImmediate(() => {
+      this.dispatchPending().catch((err) => {
+        this.logger.error("Erro no processamento da outbox de chamadas:", err);
+      });
+    });
+  }
+
+  /**
+   * Processa a fila de outbox com reserva atômica por registro:
+   * 1. Finaliza registros órfãos em `processing` que já esgotaram `MAX_OUTBOX_ATTEMPTS`.
+   * 2. Reserva atomicamente registros `pending` elegíveis ou `processing` com lock expirado (`FOR UPDATE SKIP LOCKED`).
+   * 3. Valida que a `service_session` segue `pending`.
+   * 4. Não marca como entregue quando não há dispositivo ativo (`status = 'no_device'`).
+   * 5. Distingue envio aceito pelo Expo (`status = 'accepted'`), erro de ticket (`pending` com backoff ou `failed`)
+   *    e entrega confirmada por recibo do provedor (`status = 'delivered'`).
+   */
+  async dispatchPending(): Promise<DispatchOutboxResult> {
+    if (this.inFlightDispatch) {
+      return this.inFlightDispatch;
+    }
+
+    const run = this.executeDispatchCycle();
+    this.inFlightDispatch = run;
+    try {
+      return await run;
+    } finally {
+      if (this.inFlightDispatch === run) {
+        this.inFlightDispatch = null;
+      }
+    }
+  }
+
+  private async executeDispatchCycle(): Promise<DispatchOutboxResult> {
+    let processed = 0;
+    let accepted = 0;
+    let delivered = 0;
+    let noDevice = 0;
+    let expired = 0;
+    let retried = 0;
+    let failed = 0;
+
+    // 1. Marcar como falha registros presos em processing que já atingiram o limite de tentativas
+    const exhaustedStale = await this.database.execute<{ id: string }>(sql`
+      UPDATE queue_call_outbox
+      SET status = 'failed',
+          locked_at = NULL,
+          processed_at = clock_timestamp(),
+          last_error = COALESCE(last_error, 'Processamento interrompido após atingir o limite máximo de tentativas')
+      WHERE status = 'processing'
+        AND locked_at <= clock_timestamp() - (${OUTBOX_PROCESSING_LOCK_TIMEOUT_SECONDS} * INTERVAL '1 second')
+        AND attempts >= ${MAX_OUTBOX_ATTEMPTS}
+      RETURNING id
+    `);
+    failed += exhaustedStale.rows?.length ?? 0;
+
+    // 2. Reserva atômica: UPDATE ... WHERE id IN (SELECT ... FOR UPDATE SKIP LOCKED) RETURNING ...
+    // Impede que múltiplas instâncias processem o mesmo registro simultaneamente.
+    const claimedEntries = await this.database.execute<ClaimedOutboxRow>(sql`
+      UPDATE queue_call_outbox
+      SET status = 'processing',
+          attempts = attempts + 1,
+          locked_at = clock_timestamp()
+      WHERE id IN (
+        SELECT id
+        FROM queue_call_outbox
+        WHERE (
+          (status = 'pending' AND (next_attempt_at IS NULL OR next_attempt_at <= clock_timestamp()))
+          OR
+          (status = 'processing' AND locked_at <= clock_timestamp() - (${OUTBOX_PROCESSING_LOCK_TIMEOUT_SECONDS} * INTERVAL '1 second'))
+        )
+        AND attempts < ${MAX_OUTBOX_ATTEMPTS}
+        ORDER BY created_at ASC
+        LIMIT 20
+        FOR UPDATE SKIP LOCKED
+      )
+      RETURNING
+        id,
+        service_session_id AS "serviceSessionId",
+        user_id AS "userId",
+        event_id AS "eventId",
+        experience_id AS "experienceId",
+        payload,
+        attempts
+    `);
+
+    for (const entry of claimedEntries.rows ?? []) {
+      processed++;
+      const currentAttempt = Number(entry.attempts ?? 1);
+
+      // 2.1. Evitar despachar alertas de chamadas já encerradas, ausentes ou invalidadas
+      const sessionCheck = await this.database.execute<{ status: string }>(
+        sql`SELECT status FROM service_sessions WHERE id = ${entry.serviceSessionId}`,
+      );
+
+      if (!sessionCheck.rows.length || sessionCheck.rows[0].status !== "pending") {
+        const expUpdate = await this.database.execute<{ id: string }>(sql`
+          UPDATE queue_call_outbox
+          SET status = 'expired',
+              locked_at = NULL,
+              processed_at = clock_timestamp(),
+              last_error = 'Sessão de atendimento não está mais pendente'
+          WHERE id = ${entry.id}
+            AND status = 'processing'
+            AND attempts = ${currentAttempt}
+          RETURNING id
+        `);
+        if ((expUpdate.rowCount ?? expUpdate.rows?.length ?? 0) > 0) {
+          expired++;
+        }
+        continue;
+      }
+
+      // 2.2. Consultar tokens ativos do participante chamado
+      const tokens = await this.deviceTokensService.getActiveTokensForUser(entry.userId);
+
+      if (tokens.length === 0) {
+        // IMPORTANTE: Não marcar como entregue quando não há dispositivo destinatário
+        const noDevUpdate = await this.database.execute<{ id: string }>(sql`
+          UPDATE queue_call_outbox
+          SET status = 'no_device',
+              locked_at = NULL,
+              processed_at = clock_timestamp(),
+              last_error = 'Nenhum dispositivo ativo registrado para o participante'
+          WHERE id = ${entry.id}
+            AND status = 'processing'
+            AND attempts = ${currentAttempt}
+          RETURNING id
+        `);
+        if ((noDevUpdate.rowCount ?? noDevUpdate.rows?.length ?? 0) > 0) {
+          noDevice++;
+        }
+        continue;
+      }
+
+      // 2.3. Confirmar posse do lease antes de iniciar a chamada externa ao provedor
+      const leaseRefresh = await this.database.execute<{ id: string }>(sql`
+        UPDATE queue_call_outbox
+        SET locked_at = clock_timestamp()
+        WHERE id = ${entry.id}
+          AND status = 'processing'
+          AND attempts = ${currentAttempt}
+        RETURNING id
+      `);
+      if ((leaseRefresh.rowCount ?? leaseRefresh.rows?.length ?? 0) === 0) {
+        // Outra instância assumiu o registro após expiração do lease; aborta para impedir envio concorrente
+        continue;
+      }
+
+      // Mantém o lease renovado enquanto a requisição externa ainda estiver em andamento (dentro do timeout HTTP)
+      const heartbeatIntervalMs = Math.max(
+        15,
+        Math.floor(
+          Math.min(
+            this.httpTimeoutMs,
+            OUTBOX_PROCESSING_LOCK_TIMEOUT_SECONDS * 1000,
+          ) / 4,
+        ),
+      );
+      const leaseHeartbeat = setInterval(() => {
+        void this.database
+          .execute(sql`
+            UPDATE queue_call_outbox
+            SET locked_at = clock_timestamp()
+            WHERE id = ${entry.id}
+              AND status = 'processing'
+              AND attempts = ${currentAttempt}
+          `)
+          .catch(() => undefined);
+      }, heartbeatIntervalMs);
+      leaseHeartbeat.unref?.();
+
+      // 2.4. Transmitir push silencioso e avaliar tickets individuais
+      try {
+        const dispatchOutcome = await this.sendSilentPush(
+          tokens.map((t) => t.pushToken),
+          entry.payload,
+        );
+
+        const joinedTicketIds =
+          dispatchOutcome.acceptedTicketIds.length > 0
+            ? dispatchOutcome.acceptedTicketIds.join(",")
+            : null;
+
+        const payloadWithTicketMap: QueueCallOutboxPayload = {
+          ...entry.payload,
+          _ticketTokens: dispatchOutcome.ticketTokenMap,
+        };
+
+        const acceptUpdate = await this.database.execute<{ id: string }>(sql`
+          UPDATE queue_call_outbox
+          SET status = 'accepted',
+              ticket_id = ${joinedTicketIds},
+              payload = ${JSON.stringify(payloadWithTicketMap)}::jsonb,
+              locked_at = NULL,
+              last_error = ${dispatchOutcome.partialErrorSummary}
+          WHERE id = ${entry.id}
+            AND status = 'processing'
+            AND attempts = ${currentAttempt}
+          RETURNING id
+        `);
+        if ((acceptUpdate.rowCount ?? acceptUpdate.rows?.length ?? 0) > 0) {
+          accepted++;
+        }
+      } catch (pushError: unknown) {
+        const errorMessage =
+          pushError instanceof Error ? pushError.message : String(pushError);
+        const isRetryable =
+          pushError instanceof TicketDispatchError ? pushError.retryable : true;
+
+        if (!isRetryable || currentAttempt >= MAX_OUTBOX_ATTEMPTS) {
+          const failUpdate = await this.database.execute<{ id: string }>(sql`
+            UPDATE queue_call_outbox
+            SET status = 'failed',
+                 locked_at = NULL,
+                 processed_at = clock_timestamp(),
+                 last_error = ${errorMessage}
+            WHERE id = ${entry.id}
+              AND status = 'processing'
+              AND attempts = ${currentAttempt}
+            RETURNING id
+          `);
+          if ((failUpdate.rowCount ?? failUpdate.rows?.length ?? 0) > 0) {
+            failed++;
+          }
+        } else {
+          const delaySeconds = getOutboxRetryDelaySeconds(currentAttempt);
+          const retryUpdate = await this.database.execute<{ id: string }>(sql`
+            UPDATE queue_call_outbox
+            SET status = 'pending',
+                locked_at = NULL,
+                next_attempt_at = clock_timestamp() + (${delaySeconds} * INTERVAL '1 second'),
+                last_error = ${errorMessage}
+            WHERE id = ${entry.id}
+              AND status = 'processing'
+              AND attempts = ${currentAttempt}
+            RETURNING id
+          `);
+          if ((retryUpdate.rowCount ?? retryUpdate.rows?.length ?? 0) > 0) {
+            retried++;
+          }
+        }
+      } finally {
+        clearInterval(leaseHeartbeat);
+      }
+    }
+
+    // 3. Verificar recibos de entrega de registros já aceitos pelo Expo (status = 'accepted')
+    const receiptStats = await this.verifyAcceptedReceipts();
+    delivered += receiptStats.delivered;
+    expired += receiptStats.expired;
+    retried += receiptStats.retried;
+    failed += receiptStats.failed;
+
+    return {
+      processed,
+      accepted,
+      delivered,
+      noDevice,
+      expired,
+      retried,
+      failed,
+    };
+  }
+
+  /**
+   * Consulta a API de Push Receipts do Expo para confirmar a entrega real ao provedor (FCM/APNs)
+   * dos registros em estado `accepted`.
+   */
+  async verifyAcceptedReceipts(): Promise<{
+    delivered: number;
+    expired: number;
+    retried: number;
+    failed: number;
+  }> {
+    let delivered = 0;
+    let expired = 0;
+    let retried = 0;
+    let failed = 0;
+
+    const acceptedRows = await this.database.execute<AcceptedOutboxRow>(sql`
+      UPDATE queue_call_outbox
+      SET locked_at = clock_timestamp()
+      WHERE id IN (
+        SELECT id
+        FROM queue_call_outbox
+        WHERE status = 'accepted'
+          AND ticket_id IS NOT NULL
+          AND (
+            locked_at IS NULL
+            OR locked_at <= clock_timestamp() - (${OUTBOX_PROCESSING_LOCK_TIMEOUT_SECONDS} * INTERVAL '1 second')
+          )
+        ORDER BY created_at ASC
+        LIMIT 20
+        FOR UPDATE SKIP LOCKED
+      )
+      RETURNING
+        id,
+        service_session_id AS "serviceSessionId",
+        user_id AS "userId",
+        ticket_id AS "ticketId",
+        payload,
+        attempts
+    `);
+
+    for (const row of acceptedRows.rows ?? []) {
+      const sessionCheck = await this.database.execute<{ status: string }>(
+        sql`SELECT status FROM service_sessions WHERE id = ${row.serviceSessionId}`,
+      );
+
+      if (!sessionCheck.rows.length || sessionCheck.rows[0].status !== "pending") {
+        await this.database.execute(sql`
+          UPDATE queue_call_outbox
+          SET status = 'expired',
+              locked_at = NULL,
+              processed_at = clock_timestamp(),
+              last_error = 'Sessão de atendimento encerrada antes da confirmação do recibo'
+          WHERE id = ${row.id}
+            AND status = 'accepted'
+        `);
+        expired++;
+        continue;
+      }
+
+      const ticketIds = row.ticketId
+        .split(",")
+        .map((id) => id.trim())
+        .filter(Boolean);
+
+      if (ticketIds.length === 0) {
+        await this.database.execute(sql`
+          UPDATE queue_call_outbox
+          SET locked_at = NULL
+          WHERE id = ${row.id}
+            AND status = 'accepted'
+        `);
+        continue;
+      }
+
+      const persistedTicketTokens =
+        row.payload &&
+        typeof row.payload === "object" &&
+        row.payload._ticketTokens &&
+        typeof row.payload._ticketTokens === "object"
+          ? row.payload._ticketTokens
+          : {};
+
+      try {
+        const receiptsOutcome = await this.fetchExpoReceipts(
+          ticketIds,
+          persistedTicketTokens,
+        );
+
+        if (receiptsOutcome.kind === "delivered") {
+          await this.database.execute(sql`
+            UPDATE queue_call_outbox
+            SET status = 'delivered',
+                locked_at = NULL,
+                processed_at = clock_timestamp(),
+                last_error = ${receiptsOutcome.partialErrorSummary}
+            WHERE id = ${row.id}
+              AND status = 'accepted'
+          `);
+          delivered++;
+        } else if (receiptsOutcome.kind === "pending_receipt") {
+          // O recibo ainda não foi gerado pelo provedor; permanece em 'accepted'
+          await this.database.execute(sql`
+            UPDATE queue_call_outbox
+            SET locked_at = NULL
+            WHERE id = ${row.id}
+              AND status = 'accepted'
+          `);
+        } else {
+          // Todos os recibos retornaram erro
+          const currentAttempt = Number(row.attempts ?? 1);
+          if (!receiptsOutcome.retryable || currentAttempt >= MAX_OUTBOX_ATTEMPTS) {
+            await this.database.execute(sql`
+              UPDATE queue_call_outbox
+              SET status = 'failed',
+                  locked_at = NULL,
+                  processed_at = clock_timestamp(),
+                  last_error = ${receiptsOutcome.errorMessage}
+              WHERE id = ${row.id}
+                AND status = 'accepted'
+            `);
+            failed++;
+          } else {
+            const delaySeconds = getOutboxRetryDelaySeconds(currentAttempt);
+            await this.database.execute(sql`
+              UPDATE queue_call_outbox
+              SET status = 'pending',
+                  ticket_id = NULL,
+                  locked_at = NULL,
+                  next_attempt_at = clock_timestamp() + (${delaySeconds} * INTERVAL '1 second'),
+                  last_error = ${receiptsOutcome.errorMessage}
+              WHERE id = ${row.id}
+                AND status = 'accepted'
+            `);
+            retried++;
+          }
+        }
+      } catch (err: unknown) {
+        // Falha transitória ao consultar getReceipts: mantém 'accepted' para nova checagem
+        const errorMessage = err instanceof Error ? err.message : String(err);
+        await this.database.execute(sql`
+          UPDATE queue_call_outbox
+          SET locked_at = NULL,
+              last_error = ${errorMessage}
+          WHERE id = ${row.id}
+            AND status = 'accepted'
+        `);
+      }
+    }
+
+    return { delivered, expired, retried, failed };
+  }
+
+  private async sendSilentPush(
+    tokens: string[],
+    payload: QueueCallOutboxPayload,
+  ): Promise<{
+    acceptedTicketIds: string[];
+    ticketTokenMap: Record<string, string>;
+    partialErrorSummary: string | null;
+  }> {
+    const messages = tokens.map((token) => ({
+      to: token,
+      data: {
+        type: payload.type,
+        serviceSessionId: payload.serviceSessionId,
+        participationId: payload.participationId,
+        eventId: payload.eventId,
+        ...(payload.userId ? { userId: payload.userId } : {}),
+        ...(payload.calledAt ? { calledAt: payload.calledAt } : {}),
+        version: payload.version,
+      },
+      priority: "high",
+      _contentAvailable: true,
+    }));
+
+    const bodyString = JSON.stringify(messages);
+    const headers = {
+      "Accept": "application/json",
+      "Accept-Encoding": "gzip, deflate",
+      "Content-Type": "application/json",
+    };
+
+    const response = await this.performHttpPost(EXPO_PUSH_URL, headers, bodyString);
+
+    if (!response.ok) {
+      const retryable = response.status >= 500 || response.status === 429;
+      throw new TicketDispatchError(
+        `Expo Push API retornou status HTTP ${response.status}`,
+        retryable,
+      );
+    }
+
+    const result = (await response.json()) as {
+      data?: ExpoPushTicket[];
+      errors?: Array<{ code?: string; message?: string }>;
+    };
+
+    const tickets: ExpoPushTicket[] | undefined = Array.isArray(result?.data)
+      ? result.data
+      : undefined;
+
+    if (!tickets || tickets.length === 0) {
+      const topError =
+        Array.isArray(result?.errors) && result.errors.length > 0
+          ? result.errors.map((e) => e.message || e.code || "Erro Expo").join("; ")
+          : "Resposta da Expo Push API sem tickets de envio";
+      throw new TicketDispatchError(topError, true);
+    }
+
+    const acceptedTicketIds: string[] = [];
+    const ticketTokenMap: Record<string, string> = {};
+    const ticketErrors: string[] = [];
+    let hasRetryableError = false;
+
+    for (let i = 0; i < tickets.length; i++) {
+      const ticket: ExpoPushTicket | undefined = tickets[i];
+      const token = tokens[i];
+
+      if (!ticket || typeof ticket !== "object") {
+        ticketErrors.push("Ticket malformado na resposta do Expo");
+        hasRetryableError = true;
+        continue;
+      }
+
+      if (ticket.status === "ok") {
+        if (typeof ticket.id === "string" && ticket.id.trim().length > 0) {
+          const validTicketId = ticket.id.trim();
+          acceptedTicketIds.push(validTicketId);
+          if (token) {
+            ticketTokenMap[validTicketId] = token;
+            this.ticketTokenCache.set(validTicketId, token);
+          }
+        } else {
+          // P2: Não gerar identificadores fictícios como accepted-0; classificar como resposta inconclusiva e elegível a retry
+          ticketErrors.push(
+            "Ticket ok sem identificador válido (resposta inconclusiva da Expo Push API)",
+          );
+          hasRetryableError = true;
+        }
+        continue;
+      }
+
+      const errorCode = ticket.details?.error || "UnknownTicketError";
+      const errorDesc = ticket.message
+        ? `${errorCode}: ${ticket.message}`
+        : errorCode;
+      ticketErrors.push(errorDesc);
+
+      if (errorCode === "DeviceNotRegistered" && token) {
+        await this.deviceTokensService.revokeInvalidToken(token).catch(() => undefined);
+      }
+
+      if (!NON_RETRYABLE_EXPO_ERRORS.has(errorCode)) {
+        hasRetryableError = true;
+      }
+    }
+
+    if (acceptedTicketIds.length === 0) {
+      const summary =
+        ticketErrors.join("; ") || "Todos os tickets de push falharam no Expo";
+      throw new TicketDispatchError(summary, hasRetryableError);
+    }
+
+    return {
+      acceptedTicketIds,
+      ticketTokenMap,
+      partialErrorSummary: ticketErrors.length > 0 ? ticketErrors.join("; ") : null,
+    };
+  }
+
+  private async fetchExpoReceipts(
+    ticketIds: string[],
+    ticketTokenMap: Record<string, string> = {},
+  ): Promise<
+    | { kind: "delivered"; partialErrorSummary: string | null }
+    | { kind: "pending_receipt" }
+    | { kind: "failed"; errorMessage: string; retryable: boolean }
+  > {
+    const headers = {
+      "Accept": "application/json",
+      "Accept-Encoding": "gzip, deflate",
+      "Content-Type": "application/json",
+    };
+    const bodyString = JSON.stringify({ ids: ticketIds });
+
+    const response = await this.performHttpPost(EXPO_RECEIPTS_URL, headers, bodyString);
+    if (!response.ok) {
+      throw new Error(`Expo Push Receipts API retornou status HTTP ${response.status}`);
+    }
+
+    const result = (await response.json()) as {
+      data?: Record<string, ExpoPushReceipt>;
+    };
+
+    const receiptsMap = result?.data;
+    if (!receiptsMap || typeof receiptsMap !== "object" || Array.isArray(receiptsMap)) {
+      return { kind: "pending_receipt" };
+    }
+
+    let okCount = 0;
+    let missingCount = 0;
+    let hasRetryableError = false;
+    const receiptErrors: string[] = [];
+
+    for (const ticketId of ticketIds) {
+      const receipt = receiptsMap[ticketId];
+      if (!receipt) {
+        missingCount++;
+        continue;
+      }
+
+      if (receipt.status === "ok") {
+        okCount++;
+        this.ticketTokenCache.delete(ticketId);
+        continue;
+      }
+
+      const errorCode = receipt.details?.error || "UnknownReceiptError";
+      const errorDesc = receipt.message
+        ? `${errorCode}: ${receipt.message}`
+        : errorCode;
+      receiptErrors.push(errorDesc);
+
+      if (errorCode === "DeviceNotRegistered") {
+        // P1: Revogar apenas o token correspondente ao recibo inválido, preservando outros dispositivos do usuário
+        const invalidToken =
+          ticketTokenMap[ticketId] ?? this.ticketTokenCache.get(ticketId);
+        if (invalidToken) {
+          await this.deviceTokensService
+            .revokeInvalidToken(invalidToken)
+            .catch(() => undefined);
+        }
+        this.ticketTokenCache.delete(ticketId);
+      }
+
+      if (!NON_RETRYABLE_EXPO_ERRORS.has(errorCode)) {
+        hasRetryableError = true;
+      }
+    }
+
+    if (okCount > 0) {
+      return {
+        kind: "delivered",
+        partialErrorSummary: receiptErrors.length > 0 ? receiptErrors.join("; ") : null,
+      };
+    }
+
+    if (missingCount > 0 && receiptErrors.length === 0) {
+      return { kind: "pending_receipt" };
+    }
+
+    return {
+      kind: "failed",
+      errorMessage: receiptErrors.join("; ") || "Recibo de push indicou falha na entrega",
+      retryable: hasRetryableError,
+    };
+  }
+
+  private async performHttpPost(
+    url: string,
+    headers: Record<string, string>,
+    body: string,
+  ): Promise<{ ok: boolean; status: number; json: () => Promise<unknown> }> {
+    const timeoutMs = this.httpTimeoutMs;
+    const controller =
+      typeof AbortController === "function" ? new AbortController() : null;
+    let timeoutHandle: ReturnType<typeof setTimeout> | null = null;
+
+    const timeoutPromise = new Promise<never>((_, reject) => {
+      timeoutHandle = setTimeout(() => {
+        controller?.abort();
+        reject(
+          new TicketDispatchError(
+            `Timeout na requisição para a Expo Push API após ${timeoutMs}ms (resposta do provedor incerta)`,
+            true,
+          ),
+        );
+      }, timeoutMs);
+      timeoutHandle.unref?.();
+    });
+
+    const executeRequest = async (): Promise<{
+      ok: boolean;
+      status: number;
+      json: () => Promise<unknown>;
+    }> => {
+      try {
+        if (this.transport) {
+          return await this.transport(url, {
+            method: "POST",
+            headers,
+            body,
+            ...(controller ? { signal: controller.signal } : {}),
+          });
+        }
+
+        const res = await fetch(url, {
+          method: "POST",
+          headers,
+          body,
+          ...(controller ? { signal: controller.signal } : {}),
+        });
+        return {
+          ok: res.ok,
+          status: res.status,
+          json: () => res.json(),
+        };
+      } catch (err: unknown) {
+        const isAbortOrTimeout =
+          (err instanceof Error &&
+            (err.name === "AbortError" ||
+              /timeout|timed out|aborted/i.test(err.message))) ||
+          controller?.signal.aborted;
+        if (isAbortOrTimeout) {
+          throw new TicketDispatchError(
+            `Timeout na requisição para a Expo Push API após ${timeoutMs}ms (resposta do provedor incerta)`,
+            true,
+          );
+        }
+        throw err;
+      }
+    };
+
+    try {
+      return await Promise.race([executeRequest(), timeoutPromise]);
+    } finally {
+      if (timeoutHandle !== null) {
+        clearTimeout(timeoutHandle);
+      }
+    }
+  }
+}
diff --git a/backend/test/unit/call-next-outbox.test.ts b/backend/test/unit/call-next-outbox.test.ts
new file mode 100644
index 0000000..2c60854
--- /dev/null
+++ b/backend/test/unit/call-next-outbox.test.ts
@@ -0,0 +1,138 @@
+import "reflect-metadata";
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { drizzle } from "drizzle-orm/node-postgres";
+import type { Client } from "pg";
+import * as schema from "../../src/database/schema";
+import {
+  CALL_NEXT_OPERATION,
+  CallNextService,
+  createCallNextFingerprint,
+} from "../../src/events/call-next.service";
+import type { CallNextInput } from "../../src/events/call-next.types";
+import type { QueueCallPushService } from "../../src/notifications/queue-call-push.service";
+
+const input: CallNextInput = {
+  staffUserId: "staff-1",
+  eventId: "event-1",
+  experienceId: "exp-1",
+  stationId: "station-1",
+  idempotencyKey: "call-intent-outbox",
+  expiresAt: new Date("2099-01-01"),
+};
+const at = new Date("2026-11-10T12:00:00Z");
+
+function createFixture(options: {
+  isReplay?: boolean;
+  failOutbox?: boolean;
+} = {}) {
+  const queries: Array<{ text: string; params: unknown[] }> = [];
+  let triggerDispatchCalls = 0;
+
+  const mockPushService: Partial<QueueCallPushService> = {
+    triggerDispatch: () => {
+      triggerDispatchCalls++;
+    },
+  };
+
+  const payload = {
+    serviceSession: {
+      id: "session-1",
+      queueEntryId: "entry-1",
+      experienceId: input.experienceId,
+      station: { id: input.stationId, label: "Estação 1" },
+      status: "pending",
+      calledAt: at.toISOString(),
+    },
+  };
+
+  const client = {
+    async query(config: { text: string }, params: unknown[]) {
+      const text = config.text;
+      queries.push({ text, params });
+
+      if (text.includes("SELECT id FROM events")) return { rows: [{ id: input.eventId }] };
+      if (text.includes("SELECT id FROM experiences")) return { rows: [{ id: input.experienceId }] };
+      if (text.includes("SELECT availability, label")) return { rows: [{ availability: "available", label: "Estação 1" }] };
+      if (text.includes("SELECT r.id FROM users")) return { rows: [{ id: "role-1" }] };
+
+      if (text.includes('insert into "idempotency_operations"')) {
+        return { rows: options.isReplay ? [] : [["reservation"]] };
+      }
+      if (text.includes('from "idempotency_operations"')) {
+        return {
+          rows: [
+            [
+              "reservation",
+              createCallNextFingerprint(input.eventId, input.experienceId, input.stationId),
+              options.isReplay ? "completed" : "in_progress",
+              201,
+              "session-1",
+              payload,
+            ],
+          ],
+        };
+      }
+
+      if (text.includes("AS operating")) return { rows: [{ operating: true }] };
+      if (text.includes("WHERE station_id=")) return { rows: [] };
+      if (text.includes('participation_id AS "participationId"')) return { rows: [{ id: "entry-1", participationId: "person-1" }] };
+      if (text.includes('AS "currentId"')) return { rows: [{ status: "active", currentId: "entry-1", userId: "participant-user-1" }] };
+      if (text.includes("SELECT id FROM queue_entries")) return { rows: [{ id: "entry-1" }] };
+      if (text.includes("WHERE queue_entry_id=")) return { rows: [] };
+      if (text.includes("INSERT INTO service_sessions")) return { rows: [{ calledAtMs: at.getTime() }] };
+      if (text.includes("UPDATE queue_entries SET")) return { rows: [{ id: "entry-1" }] };
+
+      if (text.includes("INSERT INTO queue_call_outbox")) {
+        if (options.failOutbox) throw new Error("OUTBOX_INSERT_FAILED");
+        return { rows: [], rowCount: 1 };
+      }
+
+      if (text.includes('update "idempotency_operations"')) {
+        return { rows: [["reservation", 201, "session-1", payload]] };
+      }
+
+      return { rows: [] };
+    },
+  };
+
+  const db = drizzle(client as unknown as Client, { schema });
+  const service = new CallNextService(db, mockPushService as QueueCallPushService);
+
+  return {
+    service,
+    queries,
+    getTriggerCalls: () => triggerDispatchCalls,
+  };
+}
+
+test("CallNext outbox: nova chamada insere registro na queue_call_outbox e dispara triggerDispatch", async () => {
+  const fixture = createFixture({ isReplay: false });
+  const result = await fixture.service.callNext(input);
+
+  assert.equal(result.kind, "created");
+  const outboxQuery = fixture.queries.find((q) => q.text.includes("INSERT INTO queue_call_outbox"));
+  assert.ok(outboxQuery, "Deveria ter executado INSERT na queue_call_outbox");
+  assert.ok(outboxQuery.text.includes("service_session_id"));
+  assert.ok(outboxQuery.text.includes("ON CONFLICT (service_session_id) DO NOTHING"));
+  assert.equal(fixture.getTriggerCalls(), 1);
+});
+
+test("CallNext outbox: replay idempotente NÃO grava outbox e NÃO dispara triggerDispatch", async () => {
+  const fixture = createFixture({ isReplay: true });
+  const result = await fixture.service.callNext(input);
+
+  assert.equal(result.kind, "replay");
+  const outboxQuery = fixture.queries.find((q) => q.text.includes("INSERT INTO queue_call_outbox"));
+  assert.equal(outboxQuery, undefined, "Replay idempotente não deve inserir na outbox");
+  assert.equal(fixture.getTriggerCalls(), 0, "Replay idempotente não deve disparar triggerDispatch");
+});
+
+test("CallNext outbox: falha ao inserir na outbox reverte a transação de chamada", async () => {
+  const fixture = createFixture({ isReplay: false, failOutbox: true });
+  await assert.rejects(
+    async () => fixture.service.callNext(input),
+    (err: any) => err.message.includes("OUTBOX_INSERT_FAILED") || err.cause?.message === "OUTBOX_INSERT_FAILED",
+  );
+  assert.equal(fixture.getTriggerCalls(), 0);
+});
diff --git a/backend/test/unit/notifications-device-tokens.test.ts b/backend/test/unit/notifications-device-tokens.test.ts
new file mode 100644
index 0000000..ac221dc
--- /dev/null
+++ b/backend/test/unit/notifications-device-tokens.test.ts
@@ -0,0 +1,180 @@
+import "reflect-metadata";
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { Module, type INestApplication } from "@nestjs/common";
+import { NestFactory } from "@nestjs/core";
+import supertest from "supertest";
+import { AuthService } from "../../src/auth/auth.service";
+import { SessionAuthGuard } from "../../src/auth/session-auth.guard";
+import { ProblemDetailsExceptionFilter } from "../../src/common/errors/problem-details.filter";
+import { ProblemException } from "../../src/common/errors/problem.exception";
+import { DeviceTokensController } from "../../src/notifications/device-tokens.controller";
+import {
+  registerPushTokenSchema,
+  unregisterPushTokenSchema,
+  validateDto,
+} from "../../src/notifications/device-tokens.dto";
+import { DeviceTokensService } from "../../src/notifications/device-tokens.service";
+
+const userId = "00000000-0000-4000-8000-000000000001";
+const sessionId = "00000000-0000-4000-8000-000000000099";
+const validToken = "ExponentPushToken[xxxxxxxxxxxxxxxxxxxxxx]";
+
+const capturedCalls: Array<{ op: string; userId: string; dto: unknown }> = [];
+
+@Module({
+  controllers: [DeviceTokensController],
+  providers: [
+    SessionAuthGuard,
+    {
+      provide: AuthService,
+      useValue: {
+        authenticateBearerToken: async (token: string) => {
+          if (token !== "valid-bearer-token") {
+            throw new ProblemException({
+              typeSlug: "invalid-access-token",
+              title: "Token inválido",
+              status: 401,
+              code: "INVALID_ACCESS_TOKEN",
+              detail: "O token de acesso informado é inválido.",
+            });
+          }
+          return { userId, sessionId, roles: ["participante"] };
+        },
+      },
+    },
+    {
+      provide: DeviceTokensService,
+      useValue: {
+        registerToken: async (uid: string, dto: unknown) => {
+          capturedCalls.push({ op: "register", userId: uid, dto });
+          return { status: "registered" as const };
+        },
+        unregisterToken: async (uid: string, dto: unknown) => {
+          capturedCalls.push({ op: "unregister", userId: uid, dto });
+          return { unlinked: true };
+        },
+      },
+    },
+  ],
+})
+class DeviceTokensHttpTestModule {}
+
+let app: INestApplication;
+
+before(async () => {
+  app = await NestFactory.create(DeviceTokensHttpTestModule, { logger: false });
+  app.setGlobalPrefix("api/v1");
+  app.useGlobalFilters(new ProblemDetailsExceptionFilter());
+  await app.listen(0, "127.0.0.1");
+});
+
+after(async () => {
+  await app?.close();
+});
+
+test("DeviceTokens DTO: valida limites de tamanho de pushToken e opções de plataforma", () => {
+  const valid = validateDto(registerPushTokenSchema, { pushToken: validToken });
+  assert.equal(valid.pushToken, validToken);
+  assert.equal(valid.platform, "android");
+
+  const validIos = validateDto(registerPushTokenSchema, { pushToken: validToken, platform: "ios" });
+  assert.equal(validIos.platform, "ios");
+
+  assert.throws(
+    () => validateDto(registerPushTokenSchema, { pushToken: "short" }),
+    (err: unknown) => err instanceof ProblemException && err.problem.code === "INVALID_REQUEST_BODY",
+  );
+
+  assert.throws(
+    () => validateDto(registerPushTokenSchema, { pushToken: validToken, platform: "windows" }),
+    (err: unknown) => err instanceof ProblemException && err.problem.code === "INVALID_REQUEST_BODY",
+  );
+
+  const unreg = validateDto(unregisterPushTokenSchema, { pushToken: validToken });
+  assert.equal(unreg.pushToken, validToken);
+});
+
+test("DeviceTokensService: registra novo token e atualiza token existente em caso de troca de usuário", async () => {
+  const queries: Array<{ sql: string; params: unknown[] }> = [];
+
+  let queryIndex = 0;
+  const mockDb = {
+    execute: async (_query: unknown) => {
+      queries.push({ sql: String(_query), params: [] });
+      queryIndex++;
+      if (queryIndex === 1) {
+        return { rows: [] };
+      }
+      if (queryIndex === 3) {
+        return { rows: [{ id: "token-id-1", userId: "other-user" }] };
+      }
+      return { rows: [], rowCount: 1 };
+    },
+  };
+
+  const service = new DeviceTokensService(mockDb as any);
+
+  const r1 = await service.registerToken(userId, { pushToken: validToken, platform: "android" });
+  assert.equal(r1.status, "registered");
+
+  const r2 = await service.registerToken(userId, { pushToken: validToken, platform: "android" });
+  assert.equal(r2.status, "updated");
+});
+
+test("DeviceTokensService: unregisterToken e revogação de tokens inválidos", async () => {
+  const executed: string[] = [];
+  const mockDb = {
+    execute: async (q: unknown) => {
+      executed.push(String(q));
+      return { rows: [], rowCount: 1 };
+    },
+  };
+
+  const service = new DeviceTokensService(mockDb as any);
+
+  const unreg = await service.unregisterToken(userId, { pushToken: validToken });
+  assert.equal(unreg.unlinked, true);
+
+  await service.revokeAllUserTokens(userId);
+  await service.revokeInvalidToken(validToken);
+
+  assert.equal(executed.length, 3);
+});
+
+test("DeviceTokensController HTTP: exige Bearer Token em POST e DELETE /api/v1/devices/push-token", async () => {
+  capturedCalls.length = 0;
+
+  // Sem Authorization -> 401
+  const postNoAuth = await supertest(app.getHttpServer())
+    .post("/api/v1/devices/push-token")
+    .send({ pushToken: validToken, platform: "android" });
+  assert.equal(postNoAuth.status, 401);
+
+  const delNoAuth = await supertest(app.getHttpServer())
+    .delete("/api/v1/devices/push-token")
+    .send({ pushToken: validToken });
+  assert.equal(delNoAuth.status, 401);
+  assert.equal(capturedCalls.length, 0);
+
+  // Com Authorization válido -> 200 OK
+  const postOk = await supertest(app.getHttpServer())
+    .post("/api/v1/devices/push-token")
+    .set("Authorization", "Bearer valid-bearer-token")
+    .send({ pushToken: validToken, platform: "android" });
+  assert.equal(postOk.status, 200);
+  assert.deepEqual(postOk.body, { status: "registered" });
+  assert.equal(capturedCalls.length, 1);
+  assert.equal(capturedCalls[0].op, "register");
+  assert.equal(capturedCalls[0].userId, userId);
+
+  const delOk = await supertest(app.getHttpServer())
+    .delete("/api/v1/devices/push-token")
+    .set("Authorization", "Bearer valid-bearer-token")
+    .send({ pushToken: validToken });
+  assert.equal(delOk.status, 200);
+  assert.deepEqual(delOk.body, { unlinked: true });
+  assert.equal(capturedCalls.length, 2);
+  assert.equal(capturedCalls[1].op, "unregister");
+  assert.equal(capturedCalls[1].userId, userId);
+});
diff --git a/backend/test/unit/queue-call-push.test.ts b/backend/test/unit/queue-call-push.test.ts
new file mode 100644
index 0000000..71cf446
--- /dev/null
+++ b/backend/test/unit/queue-call-push.test.ts
@@ -0,0 +1,1141 @@
+import "reflect-metadata";
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { drizzle } from "drizzle-orm/node-postgres";
+import type { Client } from "pg";
+import * as schema from "../../src/database/schema";
+import {
+  EXPO_PUSH_URL,
+  EXPO_RECEIPTS_URL,
+  MAX_OUTBOX_ATTEMPTS,
+  OUTBOX_RETRY_DELAYS_SECONDS,
+  QueueCallPushService,
+  getOutboxRetryDelaySeconds,
+  type PushHttpTransport,
+  type QueueCallOutboxPayload,
+} from "../../src/notifications/queue-call-push.service";
+import { DeviceTokensService } from "../../src/notifications/device-tokens.service";
+
+const sessionId = "11111111-1111-4000-8000-000000000001";
+const userId = "22222222-2222-4000-8000-000000000002";
+const eventId = "33333333-3333-4000-8000-000000000003";
+const experienceId = "44444444-4444-4000-8000-000000000004";
+const participationId = "55555555-5555-4000-8000-000000000005";
+const pushToken = "ExponentPushToken[unit-test-token-abcdef]";
+
+interface SimulatedOutboxRow {
+  id: string;
+  serviceSessionId: string;
+  userId: string;
+  eventId: string;
+  experienceId: string;
+  payload: QueueCallOutboxPayload;
+  status: string;
+  attempts: number;
+  nextAttemptAtMs: number | null;
+  lockedAtMs: number | null;
+  ticketId: string | null;
+  lastError: string | null;
+  createdAtMs: number;
+  processedAtMs: number | null;
+}
+
+function createStatefulOutboxDb(options: {
+  initialRows: SimulatedOutboxRow[];
+  sessionStatus?: string;
+  nowMs?: () => number;
+}) {
+  const rows = options.initialRows.map((r) => ({ ...r }));
+  const getNow = options.nowMs ?? (() => Date.now());
+  const sessionStatus = options.sessionStatus ?? "pending";
+  const queries: Array<{ text: string; values: unknown[] }> = [];
+
+  const client = {
+    async query(config: { text: string; values?: unknown[] }, extraValues?: unknown[]) {
+      const text = config.text;
+      const values = config.values ?? extraValues ?? [];
+      queries.push({ text, values });
+      const now = getNow();
+
+      // 1. Limpeza de processing órfãos esgotados
+      if (text.includes("AND attempts >=") && text.includes("SET status = 'failed'")) {
+        const lockTimeoutSec = Number(values[0] ?? 60);
+        const maxAttempts = Number(values[1] ?? 3);
+        const updated: Array<{ id: string }> = [];
+        for (const row of rows) {
+          if (
+            row.status === "processing" &&
+            row.lockedAtMs !== null &&
+            row.lockedAtMs <= now - lockTimeoutSec * 1000 &&
+            row.attempts >= maxAttempts
+          ) {
+            row.status = "failed";
+            row.lockedAtMs = null;
+            row.processedAtMs = now;
+            row.lastError = row.lastError ?? "Processamento interrompido após atingir o limite máximo de tentativas";
+            updated.push({ id: row.id });
+          }
+        }
+        return { rows: updated, rowCount: updated.length };
+      }
+
+      // 2. Reserva atômica de registros pendentes ou órfãos em processing
+      if (text.includes("SET status = 'processing'") && text.includes("FOR UPDATE SKIP LOCKED")) {
+        const lockTimeoutSec = Number(values[0] ?? 60);
+        const maxAttempts = Number(values[1] ?? 3);
+        const claimed: unknown[] = [];
+        for (const row of rows) {
+          const isEligiblePending =
+            row.status === "pending" &&
+            (row.nextAttemptAtMs === null || row.nextAttemptAtMs <= now);
+          const isStaleProcessing =
+            row.status === "processing" &&
+            row.lockedAtMs !== null &&
+            row.lockedAtMs <= now - lockTimeoutSec * 1000;
+
+          if ((isEligiblePending || isStaleProcessing) && row.attempts < maxAttempts) {
+            row.status = "processing";
+            row.attempts += 1;
+            row.lockedAtMs = now;
+            claimed.push({
+              id: row.id,
+              serviceSessionId: row.serviceSessionId,
+              userId: row.userId,
+              eventId: row.eventId,
+              experienceId: row.experienceId,
+              payload: row.payload,
+              attempts: row.attempts,
+            });
+          }
+        }
+        return { rows: claimed, rowCount: claimed.length };
+      }
+
+      // 3. Verificação da service_session
+      if (text.includes("FROM service_sessions")) {
+        if (sessionStatus === "missing") return { rows: [], rowCount: 0 };
+        return { rows: [{ status: sessionStatus }], rowCount: 1 };
+      }
+
+      // 4. Reserva para verificação de recibos de registros accepted
+      if (text.includes("WHERE status = 'accepted'") && text.includes("FOR UPDATE SKIP LOCKED")) {
+        const lockTimeoutSec = Number(values[0] ?? 60);
+        const claimedAccepted: unknown[] = [];
+        for (const row of rows) {
+          if (
+            row.status === "accepted" &&
+            row.ticketId !== null &&
+            (row.lockedAtMs === null || row.lockedAtMs <= now - lockTimeoutSec * 1000)
+          ) {
+            row.lockedAtMs = now;
+            claimedAccepted.push({
+              id: row.id,
+              serviceSessionId: row.serviceSessionId,
+              userId: row.userId,
+              ticketId: row.ticketId,
+              payload: row.payload,
+              attempts: row.attempts,
+            });
+          }
+        }
+        return { rows: claimedAccepted, rowCount: claimedAccepted.length };
+      }
+
+      // 4.1. Renovação de lease / heartbeat de registro em processing
+      if (
+        text.includes("UPDATE queue_call_outbox") &&
+        text.includes("SET locked_at = clock_timestamp()") &&
+        text.includes("AND status = 'processing'")
+      ) {
+        const targetId = String(values[0]);
+        const expectedAttempts = Number(values[1]);
+        const row = rows.find((r) => r.id === targetId);
+        if (!row || row.status !== "processing" || row.attempts !== expectedAttempts) {
+          return { rows: [], rowCount: 0 };
+        }
+        row.lockedAtMs = now;
+        return { rows: [{ id: row.id }], rowCount: 1 };
+      }
+
+      // 5. Atualizações individuais de status da outbox
+      if (text.includes("UPDATE queue_call_outbox")) {
+        const hasProcessingFence =
+          text.includes("AND status = 'processing'") && text.includes("AND attempts =");
+        const hasAcceptedFence = text.includes("AND status = 'accepted'");
+
+        const targetId = hasProcessingFence
+          ? String(values[values.length - 2])
+          : String(values[values.length - 1]);
+        const expectedAttempts = hasProcessingFence
+          ? Number(values[values.length - 1])
+          : null;
+
+        const row = rows.find((r) => r.id === targetId);
+        if (!row) return { rows: [], rowCount: 0 };
+
+        if (hasProcessingFence && (row.status !== "processing" || row.attempts !== expectedAttempts)) {
+          return { rows: [], rowCount: 0 };
+        }
+        if (hasAcceptedFence && row.status !== "accepted") {
+          return { rows: [], rowCount: 0 };
+        }
+
+        if (text.includes("SET status = 'expired'")) {
+          row.status = "expired";
+          row.lockedAtMs = null;
+          row.processedAtMs = now;
+          row.lastError = "Sessão de atendimento não está mais pendente";
+        } else if (text.includes("SET status = 'no_device'")) {
+          row.status = "no_device";
+          row.lockedAtMs = null;
+          row.processedAtMs = now;
+          row.lastError = "Nenhum dispositivo ativo registrado para o participante";
+        } else if (text.includes("SET status = 'accepted'")) {
+          row.status = "accepted";
+          row.ticketId = (values[0] as string | null) ?? null;
+          if (typeof values[1] === "string") {
+            try {
+              row.payload = JSON.parse(values[1]) as QueueCallOutboxPayload;
+            } catch {
+              // ignore
+            }
+          }
+          row.lockedAtMs = null;
+          row.lastError = (values[2] as string | null) ?? null;
+        } else if (text.includes("SET status = 'delivered'")) {
+          row.status = "delivered";
+          row.lockedAtMs = null;
+          row.processedAtMs = now;
+          row.lastError = (values[0] as string | null) ?? null;
+        } else if (text.includes("SET status = 'failed'")) {
+          row.status = "failed";
+          row.lockedAtMs = null;
+          row.processedAtMs = now;
+          row.lastError = String(values[0] ?? "");
+        } else if (text.includes("SET status = 'pending'")) {
+          const delaySec = Number(values[0] ?? 5);
+          row.status = "pending";
+          if (text.includes("ticket_id = NULL")) {
+            row.ticketId = null;
+          }
+          row.lockedAtMs = null;
+          row.nextAttemptAtMs = now + delaySec * 1000;
+          row.lastError = String(values[1] ?? "");
+        } else if (text.includes("SET locked_at = NULL")) {
+          row.lockedAtMs = null;
+          if (values.length > 1) {
+            row.lastError = String(values[0] ?? "");
+          }
+        }
+        return { rows: [{ id: row.id }], rowCount: 1 };
+      }
+
+      return { rows: [], rowCount: 0 };
+    },
+  };
+
+  return {
+    db: drizzle(client as unknown as Client, { schema }),
+    rows,
+    queries,
+  };
+}
+
+function makeSampleRow(overrides: Partial<SimulatedOutboxRow> = {}): SimulatedOutboxRow {
+  return {
+    id: "outbox-1",
+    serviceSessionId: sessionId,
+    userId,
+    eventId,
+    experienceId,
+    payload: {
+      type: "queue.called",
+      serviceSessionId: sessionId,
+      participationId,
+      eventId,
+      userId,
+      calledAt: "2026-11-10T12:00:00.000Z",
+      version: 1,
+    },
+    status: "pending",
+    attempts: 0,
+    nextAttemptAtMs: null,
+    lockedAtMs: null,
+    ticketId: null,
+    lastError: null,
+    createdAtMs: 1000,
+    processedAtMs: null,
+    ...overrides,
+  };
+}
