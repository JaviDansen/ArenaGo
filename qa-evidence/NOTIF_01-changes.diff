+  assert.equal(httpRequests[0].url, 'http://127.0.0.1:3000/api/v1/devices/push-token');
+  assert.equal(httpRequests[0].headers.Authorization, 'Bearer jwt-token-user-A');
+  assert.deepEqual(httpRequests[0].body, {
