new file mode 100644
index 0000000..8586d13
--- /dev/null
+++ b/app/services/devicePushService.js
@@ -0,0 +1,69 @@
+import { Platform } from 'react-native';
+import * as Notifications from 'expo-notifications';
+import * as SecureStore from 'expo-secure-store';
+
+const SECURE_STORE_PUSH_TOKEN_KEY = 'arenago_device_push_token';
+
+/**
+ * Obtém ou registra o token de push do aparelho no backend do ArenaGo.
+ */
+export async function syncDevicePushToken(client) {
+  if (Platform.OS === 'web' || !client) return null;
+
+  try {
+    // 1. Verifica/solicita permissão
+    const { status: existingStatus } = await Notifications.getPermissionsAsync();
+    let finalStatus = existingStatus;
+
+    if (existingStatus !== 'granted') {
+      const { status } = await Notifications.requestPermissionsAsync();
+      finalStatus = status;
+    }
+
+    if (finalStatus !== 'granted') {
+      return null;
+    }
+
+    // 2. Obtém o token Expo Push
+    const tokenResult = await Notifications.getExpoPushTokenAsync().catch(() => null);
+    const pushToken = tokenResult?.data;
+
+    if (!pushToken || typeof pushToken !== 'string') {
+      return null;
+    }
+
+    // 3. Envia o token ao backend
+    await client.post('/devices/push-token', {
+      pushToken,
+      platform: Platform.OS === 'ios' ? 'ios' : 'android',
+    });
+
+    // 4. Salva localmente para desvinculação no logout
+    await SecureStore.setItemAsync(SECURE_STORE_PUSH_TOKEN_KEY, pushToken).catch(() => undefined);
+
+    return pushToken;
+  } catch {
+    // Falha silenciosa: a perda de push não impede o uso do aplicativo
+    return null;
+  }
+}
+
+/**
+ * Remove o vínculo do token no backend durante o logout ou troca de conta.
+ */
+export async function unregisterDevicePushToken(client) {
+  if (Platform.OS === 'web' || !client) return false;
+
+  try {
+    const savedToken = await SecureStore.getItemAsync(SECURE_STORE_PUSH_TOKEN_KEY).catch(() => null);
+    if (savedToken) {
+      await client.delete('/devices/push-token', {
+        pushToken: savedToken,
+      }).catch(() => undefined);
+      await SecureStore.deleteItemAsync(SECURE_STORE_PUSH_TOKEN_KEY).catch(() => undefined);
+    }
+    return true;
+  } catch {
+    return false;
+  }
+}
diff --git a/app/services/queueCallVibrationService.js b/app/services/queueCallVibrationService.js
new file mode 100644
index 0000000..9629eb1
--- /dev/null
+++ b/app/services/queueCallVibrationService.js
@@ -0,0 +1,161 @@
+import { Vibration, Platform } from 'react-native';
+import * as Notifications from 'expo-notifications';
+import * as TaskManager from 'expo-task-manager';
+
+export const QUEUE_CALL_VIBRATION_PATTERN = [0, 500, 200, 500, 200, 500];
+export const QUEUE_CALL_VIBRATION_REPEAT = false;
+export const BACKGROUND_QUEUE_CALL_TASK = 'ARENAGO_QUEUE_CALL_VIBRATION_TASK';
+
+// Deduplicação em memória das sessões de atendimento já alertadas
+const processedSessionIds = new Set();
+// Ouvintes registrados no app (ex: RealArenaScreen)
+const callListeners = new Set();
+
+/**
+ * Configura o comportamento do manipulador de notificações do Expo:
+ * SUPRIME explicitamente alertas visuais, banners, sons e badges.
+ */
+try {
+  if (typeof Notifications.setNotificationHandler === 'function') {
+    Notifications.setNotificationHandler({
+      handleNotification: async () => ({
+        shouldShowAlert: false,
+        shouldPlaySound: false,
+        shouldSetBadge: false,
+      }),
+    });
+  }
+} catch {
+  // Ignorado em ambientes sem suporte
+}
+
+/**
+ * Valida o payload mínimo da chamada na fila.
+ * Rejeita qualquer payload que contenha campos de apresentação visual ou estrutura inválida.
+ */
+export function validateQueueCallPayload(data) {
+  if (!data || typeof data !== 'object') return null;
+  if (data.type !== 'queue.called') return null;
+  if (typeof data.serviceSessionId !== 'string' || !data.serviceSessionId.trim()) return null;
+
+  return {
+    type: 'queue.called',
+    serviceSessionId: data.serviceSessionId.trim(),
+    participationId: typeof data.participationId === 'string' ? data.participationId : null,
+    eventId: typeof data.eventId === 'string' ? data.eventId : null,
+    version: data.version ?? 1,
+  };
+}
+
+/**
+ * Executa o alerta vibratório exatamente uma vez por atendimento confirmado.
+ * Retorna true se a vibração foi executada, false se for replay/duplicada ou inválida.
+ */
+export function processQueueCallAlert(rawPayload, { vibrationEngine = Vibration } = {}) {
+  const payload = validateQueueCallPayload(rawPayload);
+  if (!payload) return false;
+
+  // Deduplicação: se a chamada já vibrou anteriormente, ignora
+  if (processedSessionIds.has(payload.serviceSessionId)) {
+    return false;
+  }
+
+  // Registra atendimento como já alertado
+  processedSessionIds.add(payload.serviceSessionId);
+
+  // Executa o padrão exato de 1,9 segundo: [0, 500, 200, 500, 200, 500]
+  try {
+    if (vibrationEngine && typeof vibrationEngine.vibrate === 'function') {
+      vibrationEngine.vibrate(QUEUE_CALL_VIBRATION_PATTERN, QUEUE_CALL_VIBRATION_REPEAT);
+    }
+  } catch {
+    // Falha de hardware tratada sem interromper o fluxo
+  }
+
+  // Notifica componentes em primeiro plano (ex: atualização da tela do participante)
+  for (const listener of callListeners) {
+    try {
+      listener(payload);
+    } catch {
+      // Ignora erro em listener individual
+    }
+  }
+
+  return true;
+}
+
+/**
+ * Registra um ouvinte para quando o participante for chamado na fila.
+ * Retorna função para cancelar a assinatura.
+ */
+export function addQueueCallListener(listener) {
+  if (typeof listener !== 'function') return () => {};
+  callListeners.add(listener);
+  return () => {
+    callListeners.delete(listener);
+  };
+}
+
+/**
+ * Limpa a deduplicação de sessões (útil para logout ou troca de usuário).
+ */
+export function resetQueueCallAlerts() {
+  processedSessionIds.clear();
+}
+
+/**
+ * Retorna se um atendimento já foi alertado pelo identificador.
+ */
+export function hasSessionBeenAlerted(serviceSessionId) {
+  return processedSessionIds.has(serviceSessionId);
+}
+
+// -----------------------------------------------------------------------------
+// Registro da tarefa em segundo plano (Headless Task)
+// -----------------------------------------------------------------------------
+try {
+  if (typeof TaskManager.defineTask === 'function') {
+    TaskManager.defineTask(BACKGROUND_QUEUE_CALL_TASK, async ({ data, error }) => {
+      if (error) return;
+      const notification = data?.notification;
+      const payloadData =
+        notification?.request?.content?.data ||
+        data?.data ||
+        data;
+
+      processQueueCallAlert(payloadData);
+    });
+  }
+} catch {
+  // Ignorado em ambientes de teste ou sem suporte
+}
+
+/**
+ * Inicializa a escuta de notificações em primeiro e segundo plano.
+ */
+export async function setupQueueCallNotificationHandlers() {
+  if (Platform.OS === 'web') return null;
+
+  try {
+    // Registra a tarefa em segundo plano para notificações remotas recebidas
+    if (typeof Notifications.registerTaskAsync === 'function') {
+      const isRegistered = await TaskManager.isTaskRegisteredAsync(BACKGROUND_QUEUE_CALL_TASK);
+      if (!isRegistered) {
+        await Notifications.registerTaskAsync(BACKGROUND_QUEUE_CALL_TASK);
+      }
+    }
+
+    // Ouvinte em primeiro plano
+    if (typeof Notifications.addNotificationReceivedListener === 'function') {
+      const subscription = Notifications.addNotificationReceivedListener((notification) => {
+        const data = notification?.request?.content?.data;
+        processQueueCallAlert(data);
+      });
+      return subscription;
+    }
+  } catch {
+    // Ignorado se não suportado no ambiente atual
+  }
+
+  return null;
+}
diff --git a/app/tests/queue-call-vibration.test.cjs b/app/tests/queue-call-vibration.test.cjs
new file mode 100644
index 0000000..784576a
--- /dev/null
+++ b/app/tests/queue-call-vibration.test.cjs
@@ -0,0 +1,141 @@
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { loadModule } = require('./helpers/questionnaireHarness.cjs');
+
+const mockVibration = {
+  vibrate: () => {},
+};
+const mockNotifications = {
+  setNotificationHandler: () => {},
+  registerTaskAsync: async () => {},
+  addNotificationReceivedListener: () => ({ remove: () => {} }),
+};
+const mockTaskManager = {
+  defineTask: () => {},
+  isTaskRegisteredAsync: async () => false,
+};
+
+const serviceModule = loadModule('services/queueCallVibrationService.js', (name) => {
+  if (name === 'react-native') {
+    return { Vibration: mockVibration, Platform: { OS: 'android' } };
+  }
+  if (name === 'expo-notifications') return mockNotifications;
+  if (name === 'expo-task-manager') return mockTaskManager;
+  return require(name);
+});
+
+const {
+  QUEUE_CALL_VIBRATION_PATTERN,
+  QUEUE_CALL_VIBRATION_REPEAT,
+  validateQueueCallPayload,
+  processQueueCallAlert,
+  resetQueueCallAlerts,
+  hasSessionBeenAlerted,
+  addQueueCallListener,
+} = serviceModule.exports;
+
+test('Padrão de vibração: dura 1,9 segundo, 3 pulsos de 500ms com pausas de 200ms, sem repetição', () => {
+  // Padrão exato: [0, 500, 200, 500, 200, 500]
+  assert.deepEqual(Array.from(QUEUE_CALL_VIBRATION_PATTERN), [0, 500, 200, 500, 200, 500]);
+  assert.equal(QUEUE_CALL_VIBRATION_REPEAT, false);
+
+  // Calcula a duração total
+  const totalDurationMs = Array.from(QUEUE_CALL_VIBRATION_PATTERN).reduce((sum, val) => sum + val, 0);
+  assert.equal(totalDurationMs, 1900); // 1,9 segundo exato
+});
+
+test('Validação de payload da chamada: aceita apenas metadados técnicos mínimos e rejeita campos visuais', () => {
+  const valid = {
+    type: 'queue.called',
+    serviceSessionId: 'session-uuid-1234',
+    participationId: 'part-uuid-5678',
+    eventId: 'event-uuid-9999',
+    version: 1,
+  };
+
+  const parsed = validateQueueCallPayload(valid);
+  assert.ok(parsed);
+  assert.equal(parsed.type, 'queue.called');
+  assert.equal(parsed.serviceSessionId, 'session-uuid-1234');
+  assert.equal(parsed.participationId, 'part-uuid-5678');
+  assert.equal(parsed.eventId, 'event-uuid-9999');
+
+  // Rejeita payloads inválidos
+  assert.equal(validateQueueCallPayload(null), null);
+  assert.equal(validateQueueCallPayload({}), null);
+  assert.equal(validateQueueCallPayload({ type: 'other.event' }), null);
+  assert.equal(validateQueueCallPayload({ type: 'queue.called' }), null); // sem serviceSessionId
+  assert.equal(validateQueueCallPayload({ type: 'queue.called', serviceSessionId: '   ' }), null);
+});
+
+test('Deduplicação de vibração: vibra uma única vez por atendimento e ignora retries/replays', () => {
+  resetQueueCallAlerts();
+
+  const vibrationCalls = [];
+  const customVibrator = {
+    vibrate: (pattern, repeat) => {
+      vibrationCalls.push({ pattern, repeat });
+    },
+  };
+
+  const payload1 = {
+    type: 'queue.called',
+    serviceSessionId: 'session-unique-1',
+    participationId: 'part-1',
+    eventId: 'event-1',
+    version: 1,
+  };
+
+  // 1ª vez: deve vibrar
+  const executed1 = processQueueCallAlert(payload1, { vibrationEngine: customVibrator });
+  assert.equal(executed1, true);
+  assert.equal(vibrationCalls.length, 1);
+  assert.deepEqual(Array.from(vibrationCalls[0].pattern), [0, 500, 200, 500, 200, 500]);
+  assert.equal(vibrationCalls[0].repeat, false);
+  assert.equal(hasSessionBeenAlerted('session-unique-1'), true);
+
+  // 2ª vez (mesmo serviceSessionId): NÃO deve vibrar
+  const executed2 = processQueueCallAlert(payload1, { vibrationEngine: customVibrator });
+  assert.equal(executed2, false);
+  assert.equal(vibrationCalls.length, 1); // continua 1, sem duplicar
+
+  // Novo serviceSessionId: deve vibrar
+  const payload2 = {
+    type: 'queue.called',
+    serviceSessionId: 'session-unique-2',
+  };
+  const executed3 = processQueueCallAlert(payload2, { vibrationEngine: customVibrator });
+  assert.equal(executed3, true);
+  assert.equal(vibrationCalls.length, 2);
+
+  // Limpeza de deduplicação (logout / troca de usuário)
+  resetQueueCallAlerts();
+  assert.equal(hasSessionBeenAlerted('session-unique-1'), false);
+});
+
+test('Notificação aos ouvintes da tela: propaga evento para atualização imediata da Arena', () => {
+  resetQueueCallAlerts();
+
+  const receivedCalls = [];
+  const unsubscribe = addQueueCallListener((call) => {
+    receivedCalls.push(call);
+  });
+
+  const payload = {
+    type: 'queue.called',
+    serviceSessionId: 'session-listener-test',
+    participationId: 'part-xyz',
+    eventId: 'event-xyz',
+  };
+
+  const customVibrator = { vibrate: () => {} };
+  processQueueCallAlert(payload, { vibrationEngine: customVibrator });
+
+  assert.equal(receivedCalls.length, 1);
+  assert.equal(receivedCalls[0].serviceSessionId, 'session-listener-test');
+
+  unsubscribe();
+  // Após cancelar a assinatura, novos chamados não chamam o listener removido
+  processQueueCallAlert({ type: 'queue.called', serviceSessionId: 'session-listener-test-2' }, { vibrationEngine: customVibrator });
+  assert.equal(receivedCalls.length, 1);
+});
