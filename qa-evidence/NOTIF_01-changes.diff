+    generation: currentGeneration,
+    userId: targetUserId,
+    accessToken: capturedAccessToken,
+    pushToken: null,
+    platform: platformOS === 'ios' ? 'ios' : 'android',
+    postCompleted: false,
+    unlinkedByLogout: false,
+  };
