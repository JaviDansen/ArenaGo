diff --git a/backend/src/notifications/queue-call-push.service.ts b/backend/src/notifications/queue-call-push.service.ts
new file mode 100644
index 0000000..e6824e8
--- /dev/null
+++ b/backend/src/notifications/queue-call-push.service.ts
@@ -0,0 +1,293 @@
+import { Inject, Injectable, Logger, Optional } from "@nestjs/common";
+import { randomUUID } from "node:crypto";
+import { sql } from "drizzle-orm";
+import type { NodePgDatabase } from "drizzle-orm/node-postgres";
+import { DRIZZLE_DATABASE } from "../database/database.module";
+import type * as schema from "../database/schema";
+import { DeviceTokensService } from "./device-tokens.service";
+
+export const EXPO_PUSH_URL = "https://exp.host/--/api/v2/push/send";
+export const PUSH_HTTP_TRANSPORT = Symbol("PUSH_HTTP_TRANSPORT");
+
+export type PushHttpTransport = (
+  url: string,
+  options: {
+    method: string;
+    headers: Record<string, string>;
+    body: string;
+  },
+) => Promise<{ ok: boolean; status: number; json: () => Promise<unknown> }>;
+
+export interface QueueCallOutboxPayload {
+  type: "queue.called";
+  serviceSessionId: string;
+  participationId: string;
+  eventId: string;
+  version: 1;
+}
+
+export interface CreateOutboxEntryInput {
+  sessionId: string;
+  userId: string;
+  eventId: string;
+  experienceId: string;
+  participationId: string;
+  calledAt: Date;
+}
+
+@Injectable()
+export class QueueCallPushService {
+  private readonly logger = new Logger(QueueCallPushService.name);
+  private isProcessing = false;
+
+  constructor(
+    @Inject(DRIZZLE_DATABASE)
+    private readonly database: NodePgDatabase<typeof schema>,
+    @Inject(DeviceTokensService)
+    private readonly deviceTokensService: DeviceTokensService,
+    @Optional()
+    @Inject(PUSH_HTTP_TRANSPORT)
+    private readonly transport?: PushHttpTransport,
+  ) {}
+
+  /**
+   * Insere o registro de outbox na mesma transação que confirmou a chamada do Staff.
+   * A chave única em service_session_id garante no máximo um evento de alerta por atendimento.
+   */
+  async createOutboxEntryWithTx(
+    tx: { execute: (query: unknown) => Promise<unknown> },
+    input: CreateOutboxEntryInput,
+  ): Promise<string> {
+    const outboxId = randomUUID();
+    const payload: QueueCallOutboxPayload = {
+      type: "queue.called",
+      serviceSessionId: input.sessionId,
+      participationId: input.participationId,
+      eventId: input.eventId,
+      version: 1,
+    };
+
+    await tx.execute(sql`
+      INSERT INTO queue_call_outbox (
+        id,
+        service_session_id,
+        user_id,
+        event_id,
+        experience_id,
+        payload,
+        status,
+        attempts,
+        created_at
+      ) VALUES (
+        ${outboxId},
+        ${input.sessionId},
+        ${input.userId},
+        ${input.eventId},
+        ${input.experienceId},
+        ${JSON.stringify(payload)}::jsonb,
+        'pending',
+        0,
+        ${input.calledAt}
+      )
+      ON CONFLICT (service_session_id) DO NOTHING
+    `);
+
+    return outboxId;
+  }
+
+  /**
+   * Dispara a entrega de forma assíncrona pós-commit, sem bloquear nem propagar erros.
+   */
+  triggerDispatch(): void {
+    setImmediate(() => {
+      this.dispatchPending().catch((err) => {
+        this.logger.error("Erro no processamento da outbox de chamadas:", err);
+      });
+    });
+  }
+
+  /**
+   * Processa a fila de outbox: verifica integridade da sessão, consulta tokens ativos,
+   * envia push estritamente de dados (silencioso) e atualiza o status.
+   */
+  async dispatchPending(): Promise<{
+    processed: number;
+    delivered: number;
+    expired: number;
+    failed: number;
+  }> {
+    if (this.isProcessing) {
+      return { processed: 0, delivered: 0, expired: 0, failed: 0 };
+    }
+
+    this.isProcessing = true;
+    let processed = 0;
+    let delivered = 0;
+    let expired = 0;
+    let failed = 0;
+
+    try {
+      const pendingEntries = await this.database.execute<{
+        id: string;
+        serviceSessionId: string;
+        userId: string;
+        eventId: string;
+        experienceId: string;
+        payload: QueueCallOutboxPayload;
+        attempts: number;
+      }>(sql`
+        SELECT
+          id,
+          service_session_id AS "serviceSessionId",
+          user_id AS "userId",
+          event_id AS "eventId",
+          experience_id AS "experienceId",
+          payload,
+          attempts
+        FROM queue_call_outbox
+        WHERE status = 'pending' AND attempts < 3
+        ORDER BY created_at ASC
+        LIMIT 20
+        FOR UPDATE SKIP LOCKED
+      `);
+
+      for (const entry of pendingEntries.rows) {
+        processed++;
+
+        // 1. Evitar despachar alertas de chamadas encerradas ou invalidadas
+        const sessionCheck = await this.database.execute<{ status: string }>(
+          sql`SELECT status FROM service_sessions WHERE id = ${entry.serviceSessionId}`,
+        );
+
+        if (!sessionCheck.rows.length || sessionCheck.rows[0].status !== "pending") {
+          await this.database.execute(sql`
+            UPDATE queue_call_outbox
+            SET status = 'expired',
+                processed_at = clock_timestamp(),
+                last_error = 'Sessão de atendimento não está mais pendente'
+            WHERE id = ${entry.id}
+          `);
+          expired++;
+          continue;
+        }
+
+        // 2. Consultar tokens do participante chamado
+        const tokens = await this.deviceTokensService.getActiveTokensForUser(entry.userId);
+
+        if (tokens.length === 0) {
+          // Sem dispositivos cadastrados: registrar conclusão da tentativa sem falha
+          await this.database.execute(sql`
+            UPDATE queue_call_outbox
+            SET status = 'delivered',
+                processed_at = clock_timestamp(),
+                last_error = 'Nenhum dispositivo ativo registrado para o participante'
+            WHERE id = ${entry.id}
+          `);
+          delivered++;
+          continue;
+        }
+
+        // 3. Montar e transmitir push estritamente data-only
+        try {
+          await this.sendSilentPush(tokens.map((t) => t.pushToken), entry.payload);
+
+          await this.database.execute(sql`
+            UPDATE queue_call_outbox
+            SET status = 'delivered',
+                processed_at = clock_timestamp(),
+                last_error = NULL
+            WHERE id = ${entry.id}
+          `);
+          delivered++;
+        } catch (pushError: unknown) {
+          const errorMessage =
+            pushError instanceof Error ? pushError.message : String(pushError);
+          const nextAttempts = entry.attempts + 1;
+          const newStatus = nextAttempts >= 3 ? "failed" : "pending";
+
+          await this.database.execute(sql`
+            UPDATE queue_call_outbox
+            SET attempts = ${nextAttempts},
+                status = ${newStatus},
+                last_error = ${errorMessage}
+            WHERE id = ${entry.id}
+          `);
+
+          if (newStatus === "failed") {
+            failed++;
+          }
+        }
+      }
+    } finally {
+      this.isProcessing = false;
+    }
+
+    return { processed, delivered, expired, failed };
+  }
+
+  private async sendSilentPush(
+    tokens: string[],
+    payload: QueueCallOutboxPayload,
+  ): Promise<void> {
+    const messages = tokens.map((token) => ({
+      to: token,
+      data: {
+        type: payload.type,
+        serviceSessionId: payload.serviceSessionId,
+        participationId: payload.participationId,
+        eventId: payload.eventId,
+        version: payload.version,
+      },
+      priority: "high",
+      _contentAvailable: true,
+    }));
+
+    const bodyString = JSON.stringify(messages);
+    const headers = {
+      "Accept": "application/json",
+      "Accept-Encoding": "gzip, deflate",
+      "Content-Type": "application/json",
+    };
+
+    let response: { ok: boolean; status: number; json: () => Promise<unknown> };
+
+    if (this.transport) {
+      response = await this.transport(EXPO_PUSH_URL, {
+        method: "POST",
+        headers,
+        body: bodyString,
+      });
+    } else {
+      const res = await fetch(EXPO_PUSH_URL, {
+        method: "POST",
+        headers,
+        body: bodyString,
+      });
+      response = {
+        ok: res.ok,
+        status: res.status,
+        json: () => res.json(),
+      };
+    }
+
+    if (!response.ok) {
+      throw new Error(`Expo Push API retornou status HTTP ${response.status}`);
+    }
+
+    const result = (await response.json()) as {
+      data?: Array<{ status: string; message?: string; details?: { error?: string } }>;
+    };
+
+    if (Array.isArray(result?.data)) {
+      for (let i = 0; i < result.data.length; i++) {
+        const ticket = result.data[i];
+        if (ticket.status === "error" && ticket.details?.error === "DeviceNotRegistered") {
+          const invalidToken = tokens[i];
+          if (invalidToken) {
+            await this.deviceTokensService.revokeInvalidToken(invalidToken).catch(() => undefined);
+          }
+        }
+      }
+    }
+  }
+}
diff --git a/backend/test/unit/call-next-outbox.test.ts b/backend/test/unit/call-next-outbox.test.ts
new file mode 100644
index 0000000..2c60854
--- /dev/null
+++ b/backend/test/unit/call-next-outbox.test.ts
@@ -0,0 +1,138 @@
+import "reflect-metadata";
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { drizzle } from "drizzle-orm/node-postgres";
+import type { Client } from "pg";
+import * as schema from "../../src/database/schema";
+import {
+  CALL_NEXT_OPERATION,
+  CallNextService,
+  createCallNextFingerprint,
+} from "../../src/events/call-next.service";
+import type { CallNextInput } from "../../src/events/call-next.types";
+import type { QueueCallPushService } from "../../src/notifications/queue-call-push.service";
+
+const input: CallNextInput = {
+  staffUserId: "staff-1",
+  eventId: "event-1",
+  experienceId: "exp-1",
+  stationId: "station-1",
+  idempotencyKey: "call-intent-outbox",
+  expiresAt: new Date("2099-01-01"),
+};
+const at = new Date("2026-11-10T12:00:00Z");
+
+function createFixture(options: {
+  isReplay?: boolean;
+  failOutbox?: boolean;
+} = {}) {
+  const queries: Array<{ text: string; params: unknown[] }> = [];
+  let triggerDispatchCalls = 0;
+
+  const mockPushService: Partial<QueueCallPushService> = {
+    triggerDispatch: () => {
+      triggerDispatchCalls++;
+    },
+  };
+
+  const payload = {
+    serviceSession: {
+      id: "session-1",
+      queueEntryId: "entry-1",
+      experienceId: input.experienceId,
+      station: { id: input.stationId, label: "Estação 1" },
+      status: "pending",
+      calledAt: at.toISOString(),
+    },
+  };
+
+  const client = {
+    async query(config: { text: string }, params: unknown[]) {
+      const text = config.text;
+      queries.push({ text, params });
+
+      if (text.includes("SELECT id FROM events")) return { rows: [{ id: input.eventId }] };
+      if (text.includes("SELECT id FROM experiences")) return { rows: [{ id: input.experienceId }] };
+      if (text.includes("SELECT availability, label")) return { rows: [{ availability: "available", label: "Estação 1" }] };
+      if (text.includes("SELECT r.id FROM users")) return { rows: [{ id: "role-1" }] };
+
+      if (text.includes('insert into "idempotency_operations"')) {
+        return { rows: options.isReplay ? [] : [["reservation"]] };
+      }
+      if (text.includes('from "idempotency_operations"')) {
+        return {
+          rows: [
+            [
+              "reservation",
+              createCallNextFingerprint(input.eventId, input.experienceId, input.stationId),
+              options.isReplay ? "completed" : "in_progress",
+              201,
+              "session-1",
+              payload,
+            ],
+          ],
+        };
+      }
+
+      if (text.includes("AS operating")) return { rows: [{ operating: true }] };
+      if (text.includes("WHERE station_id=")) return { rows: [] };
+      if (text.includes('participation_id AS "participationId"')) return { rows: [{ id: "entry-1", participationId: "person-1" }] };
+      if (text.includes('AS "currentId"')) return { rows: [{ status: "active", currentId: "entry-1", userId: "participant-user-1" }] };
+      if (text.includes("SELECT id FROM queue_entries")) return { rows: [{ id: "entry-1" }] };
+      if (text.includes("WHERE queue_entry_id=")) return { rows: [] };
+      if (text.includes("INSERT INTO service_sessions")) return { rows: [{ calledAtMs: at.getTime() }] };
+      if (text.includes("UPDATE queue_entries SET")) return { rows: [{ id: "entry-1" }] };
+
+      if (text.includes("INSERT INTO queue_call_outbox")) {
+        if (options.failOutbox) throw new Error("OUTBOX_INSERT_FAILED");
+        return { rows: [], rowCount: 1 };
+      }
+
+      if (text.includes('update "idempotency_operations"')) {
+        return { rows: [["reservation", 201, "session-1", payload]] };
+      }
+
+      return { rows: [] };
+    },
+  };
+
+  const db = drizzle(client as unknown as Client, { schema });
+  const service = new CallNextService(db, mockPushService as QueueCallPushService);
+
+  return {
+    service,
+    queries,
+    getTriggerCalls: () => triggerDispatchCalls,
+  };
+}
+
+test("CallNext outbox: nova chamada insere registro na queue_call_outbox e dispara triggerDispatch", async () => {
+  const fixture = createFixture({ isReplay: false });
+  const result = await fixture.service.callNext(input);
+
+  assert.equal(result.kind, "created");
+  const outboxQuery = fixture.queries.find((q) => q.text.includes("INSERT INTO queue_call_outbox"));
+  assert.ok(outboxQuery, "Deveria ter executado INSERT na queue_call_outbox");
+  assert.ok(outboxQuery.text.includes("service_session_id"));
+  assert.ok(outboxQuery.text.includes("ON CONFLICT (service_session_id) DO NOTHING"));
+  assert.equal(fixture.getTriggerCalls(), 1);
+});
+
+test("CallNext outbox: replay idempotente NÃO grava outbox e NÃO dispara triggerDispatch", async () => {
+  const fixture = createFixture({ isReplay: true });
+  const result = await fixture.service.callNext(input);
+
+  assert.equal(result.kind, "replay");
+  const outboxQuery = fixture.queries.find((q) => q.text.includes("INSERT INTO queue_call_outbox"));
+  assert.equal(outboxQuery, undefined, "Replay idempotente não deve inserir na outbox");
+  assert.equal(fixture.getTriggerCalls(), 0, "Replay idempotente não deve disparar triggerDispatch");
+});
+
+test("CallNext outbox: falha ao inserir na outbox reverte a transação de chamada", async () => {
+  const fixture = createFixture({ isReplay: false, failOutbox: true });
+  await assert.rejects(
+    async () => fixture.service.callNext(input),
+    (err: any) => err.message.includes("OUTBOX_INSERT_FAILED") || err.cause?.message === "OUTBOX_INSERT_FAILED",
+  );
+  assert.equal(fixture.getTriggerCalls(), 0);
+});
diff --git a/backend/test/unit/notifications-device-tokens.test.ts b/backend/test/unit/notifications-device-tokens.test.ts
new file mode 100644
index 0000000..a29fa18
--- /dev/null
+++ b/backend/test/unit/notifications-device-tokens.test.ts
@@ -0,0 +1,90 @@
+import "reflect-metadata";
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import {
+  registerPushTokenSchema,
+  unregisterPushTokenSchema,
+  validateDto,
+} from "../../src/notifications/device-tokens.dto";
+import { DeviceTokensService } from "../../src/notifications/device-tokens.service";
+import { ProblemException } from "../../src/common/errors/problem.exception";
+
+const userId = "00000000-0000-4000-8000-000000000001";
+const validToken = "ExponentPushToken[xxxxxxxxxxxxxxxxxxxxxx]";
+
+test("DeviceTokens DTO: valida limites de tamanho de pushToken e opções de plataforma", () => {
+  // Válido
+  const valid = validateDto(registerPushTokenSchema, { pushToken: validToken });
+  assert.equal(valid.pushToken, validToken);
+  assert.equal(valid.platform, "android");
+
+  const validIos = validateDto(registerPushTokenSchema, { pushToken: validToken, platform: "ios" });
+  assert.equal(validIos.platform, "ios");
+
+  // Rejeita curto (<10)
+  assert.throws(
+    () => validateDto(registerPushTokenSchema, { pushToken: "short" }),
+    (err: unknown) => err instanceof ProblemException && err.problem.code === "INVALID_REQUEST_BODY",
+  );
+
+  // Rejeita plataforma inválida
+  assert.throws(
+    () => validateDto(registerPushTokenSchema, { pushToken: validToken, platform: "windows" }),
+    (err: unknown) => err instanceof ProblemException && err.problem.code === "INVALID_REQUEST_BODY",
+  );
+
+  // Unregister DTO valida token
+  const unreg = validateDto(unregisterPushTokenSchema, { pushToken: validToken });
+  assert.equal(unreg.pushToken, validToken);
+});
+
+test("DeviceTokensService: registra novo token e atualiza token existente em caso de troca de usuário", async () => {
+  const queries: Array<{ sql: string; params: unknown[] }> = [];
+
+  let queryIndex = 0;
+  const mockDb = {
+    execute: async (_query: unknown) => {
+      queries.push({ sql: String(_query), params: [] });
+      queryIndex++;
+      if (queryIndex === 1) {
+        // Primeira busca: não existe
+        return { rows: [] };
+      }
+      if (queryIndex === 3) {
+        // Terceira busca: token já existe para outro usuário
+        return { rows: [{ id: "token-id-1", userId: "other-user" }] };
+      }
+      return { rows: [], rowCount: 1 };
+    },
+  };
+
+  const service = new DeviceTokensService(mockDb as any);
+
+  // 1. Inserção
+  const r1 = await service.registerToken(userId, { pushToken: validToken, platform: "android" });
+  assert.equal(r1.status, "registered");
+
+  // 2. Atualização / rotação de conta no mesmo aparelho
+  const r2 = await service.registerToken(userId, { pushToken: validToken, platform: "android" });
+  assert.equal(r2.status, "updated");
+});
+
+test("DeviceTokensService: unregisterToken e revogação de tokens inválidos", async () => {
+  const executed: string[] = [];
+  const mockDb = {
+    execute: async (q: unknown) => {
+      executed.push(String(q));
+      return { rows: [], rowCount: 1 };
+    },
+  };
+
+  const service = new DeviceTokensService(mockDb as any);
+
+  const unreg = await service.unregisterToken(userId, { pushToken: validToken });
+  assert.equal(unreg.unlinked, true);
+
+  await service.revokeAllUserTokens(userId);
+  await service.revokeInvalidToken(validToken);
+
+  assert.equal(executed.length, 3);
+});
