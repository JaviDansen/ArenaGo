+  }
+
+  return {
+    getSnapshot: () => state,
+    isCurrent,
+    isAccessLocked: () => accessLocked && isCurrent(),
+    setContext,
+    reportAccessDenied,
+    refreshStations,
+    refreshExperiences,
+    refreshEntryControl,
+    refreshPanel,
+    revalidateOnReturn,
+    refreshQueue,
+    pollStations,
+    pollExperiences,
+    pollEntryControl,
+    pollQueue,
+    clearQueue,
+    subscribe(listener) { listeners.add(listener); return () => listeners.delete(listener); },
+  };
 }
