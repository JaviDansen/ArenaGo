+      const prevInst = activeInst;
+      const prevCursor = activeCursor;
+      const prevRendering = renderingNow;
+      activeInst = inst;
+      activeCursor = 0;
+      renderingNow = true;
+      let rendered;
+      try {
+        rendered = node.type(node.props);
+      } finally {
+        activeInst = prevInst;
+        activeCursor = prevCursor;
+        renderingNow = prevRendering;
