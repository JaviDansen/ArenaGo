+        for (const { inst, idx, cb } of pendingEffects) {
+          if (!inst.mounted) continue;
+          const prevCleanup = inst.cleanups.get(idx);
+          if (typeof prevCleanup === 'function') prevCleanup();
+          const nextCleanup = cb();
