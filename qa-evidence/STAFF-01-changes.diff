+    assert.ok(rig.pollingRegistrations.some((r) => r.intervalMs === 60000 && r.enabled === true));
+    await rig.press('Sair da conta');
+    assert.equal(logoutCalls, 1);
+  } finally {
+    rig.dispose();
+  }
+});
