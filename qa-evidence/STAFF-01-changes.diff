+  return {
+    react,
+    createNativeStackNavigator,
+    mount(renderFn) {
+      rootRenderFn = renderFn;
+      dirty = true;
+      flushWork();
+    },
+    update(renderFn) {
+      rootRenderFn = renderFn;
+      dirty = true;
+      flushWork();
+    },
+    async act(fn) {
+      batchDepth += 1;
+      try {
+        await fn();
+      } finally {
+        batchDepth -= 1;
+      }
+      dirty = true;
+      flushWork();
+      await new Promise((r) => setTimeout(r, 0));
+      if (dirty) flushWork();
+    },
+    async settle() {
+      await new Promise((r) => setTimeout(r, 0));
