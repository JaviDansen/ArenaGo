+  for (const value of [null, "0000-01-01T00:00:00.000000Z", "2026-02-29T00:00:00.000000Z", "2026-11-03T24:00:00.000000Z", at.replace("Z", "+00:00"), at.replace("123456", "123")]) assert.equal(isPreciseInstant(value), false);
+});
