+```powershell
+Set-Location C:\DoJob\ProgramacaoMobile\backend
+$env:NODE_ENV = 'test'
+$env:EVENTS_TEST_DATABASE_URL = 'postgresql://USUARIO:SENHA@127.0.0.1:55432/arenago_events_test'
