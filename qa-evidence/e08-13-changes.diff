diff --git a/backend/src/events/admin-configuration-query.service.ts b/backend/src/events/admin-configuration-query.service.ts
new file mode 100644
index 0000000000000000000000000000000000000000..063a0585e706a68e17e241360182075591b8cb35
--- /dev/null
+++ b/backend/src/events/admin-configuration-query.service.ts
@@ -0,0 +1,50 @@
+import { Inject, Injectable } from "@nestjs/common";
+import { sql } from "drizzle-orm";
+import type { NodePgDatabase } from "drizzle-orm/node-postgres";
+import { DRIZZLE_DATABASE } from "../database/database.module";
+import type { DatabaseTransactionExecutor } from "../database/database-executor";
+import type * as schema from "../database/schema";
+import { configurationEventViewSchema,configurationExperienceViewSchema,configurationStationViewSchema,encodeConfigurationCursor,type ConfigurationPage } from "./admin-configuration.dto";
+import { configurationEventView,configurationProjection,experienceSelection,readinessView,stationSelection,type ConfigurationRow } from "./admin-configuration.projection";
+import { failConfiguration } from "./admin-configuration.problem";
+
+export interface ConfigurationActor {userId:string;sessionId:string}
+export async function authorizeConfigurationRead(tx:DatabaseTransactionExecutor,actor:ConfigurationActor){
+  const row=(await tx.execute<{active:boolean;admin:boolean;valid:boolean;revoked:boolean;expired:boolean;secondFactor:boolean}>(sql`
+    SELECT u.is_active AS active,EXISTS(SELECT 1 FROM user_roles r WHERE r.user_id=u.id AND r.role='admin' AND r.event_id IS NULL AND r.revoked_at IS NULL) AS admin,
+      s.id IS NOT NULL AS valid,s.revoked_at IS NOT NULL AS revoked,s.expires_at<=clock_timestamp() AS expired,s.admin_2fa_verified_at IS NOT NULL AS "secondFactor"
+    FROM users u LEFT JOIN sessions s ON s.id=${actor.sessionId}::uuid AND s.user_id=u.id WHERE u.id=${actor.userId}::uuid`)).rows[0];
+  if(!row?.active)failConfiguration('account_inactive');if(!row.admin)failConfiguration('admin_required');if(!row.valid)failConfiguration('invalid_session');
+  if(row.revoked)failConfiguration('session_revoked');if(row.expired)failConfiguration('session_expired');if(!row.secondFactor)failConfiguration('admin_2fa_required');
+}
+@Injectable()
+export class AdminConfigurationQueryService {
+  constructor(@Inject(DRIZZLE_DATABASE) private readonly database:NodePgDatabase<typeof schema>){}
+  private snapshot<T>(actor:ConfigurationActor,read:(tx:DatabaseTransactionExecutor)=>Promise<T>){return this.database.transaction(async tx=>{
+    await authorizeConfigurationRead(tx,actor);return read(tx);
+  },{isolationLevel:'repeatable read',accessMode:'read only'});}
+  events(actor:ConfigurationActor,page:ConfigurationPage){return this.snapshot(actor,async tx=>{
+    const after=page.cursor?sql`(e.created_at,e.id)<(${page.cursor.createdAt}::timestamptz,${page.cursor.id}::uuid)`:sql`true`;
+    const query=configurationProjection(sql`${after} AND ${page.statusStored?sql`e.status=${page.statusStored}::varchar(20)`:sql`true`}`);
+    const rows=(await tx.execute<ConfigurationRow>(sql`SELECT * FROM (${query}) p WHERE ${page.phase?sql`p."effectivePhase"=${page.phase}::text`:sql`true`}
+      ORDER BY "createdAt" DESC,id DESC LIMIT ${page.limit+1}`)).rows,visible=rows.slice(0,page.limit),last=visible.at(-1);
+    return {items:visible.map(r=>configurationEventViewSchema.parse(configurationEventView(r))),nextCursor:rows.length>page.limit&&last?encodeConfigurationCursor(last.createdAt,last.id):null};
+  });}
+  event(actor:ConfigurationActor,eventId:string){return this.snapshot(actor,async tx=>{
+    const row=(await tx.execute<ConfigurationRow>(configurationProjection(sql`e.id=${eventId}::uuid`))).rows[0];if(!row)failConfiguration('resource_not_found');
+    return {event:configurationEventViewSchema.parse(configurationEventView(row))};
+  });}
+  readiness(actor:ConfigurationActor,eventId:string){return this.snapshot(actor,async tx=>{
+    const row=(await tx.execute<ConfigurationRow>(configurationProjection(sql`e.id=${eventId}::uuid`))).rows[0];if(!row)failConfiguration('resource_not_found');
+    // Parse do DTO fechado também verifica instantes antes de formar a visão reduzida.
+    configurationEventViewSchema.parse(configurationEventView(row));
+    return {eventId:row.id,statusStored:row.statusStored,effectivePhase:row.effectivePhase,...readinessView(row),acceptingNewParticipations:row.acceptingNewParticipations,observedAt:row.observedAt};
+  });}
+  experiences(actor:ConfigurationActor,eventId:string){return this.snapshot(actor,async tx=>{
+    if(!(await tx.execute(sql`SELECT id FROM events WHERE id=${eventId}::uuid`)).rows.length)failConfiguration('resource_not_found');
+    const experiences=(await tx.execute(sql`${experienceSelection} WHERE event_id=${eventId}::uuid ORDER BY id`)).rows.map(r=>configurationExperienceViewSchema.parse(r));
+    const stations=(await tx.execute(sql`${stationSelection} JOIN experiences x ON x.id=s.experience_id WHERE x.event_id=${eventId}::uuid ORDER BY s.id`)).rows.map(r=>configurationStationViewSchema.parse(r));
+    const grouped=new Map<string,typeof stations>();for(const s of stations){const group=grouped.get(s.experienceId)??[];group.push(s);grouped.set(s.experienceId,group);}
+    return {eventId,items:experiences.map(x=>({...x,stations:grouped.get(x.id)??[]}))};
+  });}
+}
diff --git a/backend/src/events/admin-configuration.controller.ts b/backend/src/events/admin-configuration.controller.ts
new file mode 100644
index 0000000000000000000000000000000000000000..522e28c0f3dbcd0826974005211ecf26e8216a67
--- /dev/null
+++ b/backend/src/events/admin-configuration.controller.ts
@@ -0,0 +1,57 @@
+import { Body,Controller,Get,HttpCode,Inject,Param,Patch,Post,Query,Req } from "@nestjs/common";
+import { CurrentUserId,RequireSessionAuth } from "../auth/current-user.decorator";
+import { CurrentUser } from "../auth/current-user.decorator";
+import type { AuthenticatedRequest } from "../auth/session-auth.guard";
+import { ProblemException } from "../common/errors/problem.exception";
+import { validateOperationBody,validateOperationIdempotencyKey,validateOperationParams } from "../common/http/operation-validation";
+import { configurationBodies,configurationEventParams,configurationExperienceParams,configurationStationParams,configurationQuery,type ConfigOperation } from "./admin-configuration.dto";
+import { AdminConfigurationQueryService } from "./admin-configuration-query.service";
+import { AdminConfigurationService } from "./admin-configuration.service";
+import { executeConfiguration } from "./admin-configuration.problem";
+import { AdminIdempotencyPolicy } from "./admin-idempotency.policy";
+
+@Controller('admin/events')
+@RequireSessionAuth()
+export class AdminConfigurationController {
+  constructor(@Inject(AdminConfigurationQueryService) private readonly queries:AdminConfigurationQueryService,
+    @Inject(AdminConfigurationService) private readonly writes:AdminConfigurationService,@Inject(AdminIdempotencyPolicy) private readonly policy:AdminIdempotencyPolicy){}
+  @Get()
+  @HttpCode(200)
+  list(@CurrentUserId() userId:string,@CurrentUser('sessionId') sessionId:string,@Query() query:unknown){
+    const parsed=configurationQuery.safeParse(query);if(!parsed.success)throw new ProblemException({status:400,code:'VALIDATION_ERROR',typeSlug:'validation-error',title:'Requisição inválida',detail:'Confira filtros e cursor.'});
+    return executeConfiguration(()=>this.queries.events({userId,sessionId},parsed.data));
+  }
+  @Post()
+  @HttpCode(201)
+  create(@CurrentUserId() userId:string,@CurrentUser('sessionId') sessionId:string,@Body() body:unknown,@Req() request:AuthenticatedRequest){return this.mutate('create_event',userId,sessionId,{},body,request);}
+  @Get(':eventId/readiness')
+  @HttpCode(200)
+  readiness(@CurrentUserId() userId:string,@CurrentUser('sessionId') sessionId:string,@Param() params:unknown){const {eventId}=validateOperationParams(configurationEventParams,params);return executeConfiguration(()=>this.queries.readiness({userId,sessionId},eventId));}
+  @Get(':eventId/experiences')
+  @HttpCode(200)
+  experiences(@CurrentUserId() userId:string,@CurrentUser('sessionId') sessionId:string,@Param() params:unknown){const {eventId}=validateOperationParams(configurationEventParams,params);return executeConfiguration(()=>this.queries.experiences({userId,sessionId},eventId));}
+  @Get(':eventId')
+  @HttpCode(200)
+  event(@CurrentUserId() userId:string,@CurrentUser('sessionId') sessionId:string,@Param() params:unknown){const {eventId}=validateOperationParams(configurationEventParams,params);return executeConfiguration(()=>this.queries.event({userId,sessionId},eventId));}
+  @Patch(':eventId')
+  @HttpCode(200)
+  update(@CurrentUserId() userId:string,@CurrentUser('sessionId') sessionId:string,@Param() params:unknown,@Body() body:unknown,@Req() request:AuthenticatedRequest){return this.mutate('update_event',userId,sessionId,params,body,request);}
+  @Post(':eventId/experiences')
+  @HttpCode(201)
+  createExperience(@CurrentUserId() userId:string,@CurrentUser('sessionId') sessionId:string,@Param() params:unknown,@Body() body:unknown,@Req() request:AuthenticatedRequest){return this.mutate('create_experience',userId,sessionId,params,body,request);}
+  @Patch(':eventId/experiences/:experienceId')
+  @HttpCode(200)
+  updateExperience(@CurrentUserId() userId:string,@CurrentUser('sessionId') sessionId:string,@Param() params:unknown,@Body() body:unknown,@Req() request:AuthenticatedRequest){return this.mutate('update_experience',userId,sessionId,params,body,request);}
+  @Post(':eventId/experiences/:experienceId/stations')
+  @HttpCode(201)
+  createStation(@CurrentUserId() userId:string,@CurrentUser('sessionId') sessionId:string,@Param() params:unknown,@Body() body:unknown,@Req() request:AuthenticatedRequest){return this.mutate('create_station',userId,sessionId,params,body,request);}
+  @Patch(':eventId/experiences/:experienceId/stations/:stationId')
+  @HttpCode(200)
+  updateStation(@CurrentUserId() userId:string,@CurrentUser('sessionId') sessionId:string,@Param() params:unknown,@Body() body:unknown,@Req() request:AuthenticatedRequest){return this.mutate('update_station',userId,sessionId,params,body,request);}
+  private mutate(operation:ConfigOperation,userId:string,sessionId:string,params:unknown,body:unknown,request:AuthenticatedRequest){
+    const ids=operation==='create_event'?{}:validateOperationParams(operation==='update_station'?configurationStationParams:
+      operation==='create_station'||operation==='update_experience'?configurationExperienceParams:configurationEventParams,params);
+    const payload=validateOperationBody<unknown>(configurationBodies[operation],body,request),idempotencyKey=validateOperationIdempotencyKey(request);
+    return executeConfiguration(async()=>{const result=await this.writes.mutate({operation,userId,sessionId,...ids,payload,idempotencyKey,expiresAt:this.policy.expiresAt()});return result.body;});
+  }
+}
diff --git a/backend/src/events/admin-configuration.dto.ts b/backend/src/events/admin-configuration.dto.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d50bd23e4b289d08a34346b5b698a737ad592c06
--- /dev/null
+++ b/backend/src/events/admin-configuration.dto.ts
@@ -0,0 +1,57 @@
+import { z } from "zod";
+import { operationUuid } from "../common/http/operation-validation";
+import { isPreciseInstant } from "../evaluations/evaluation-read.dto";
+import { normalizeEventAccessCode } from "./access-code";
+import { normalizeScheduleInstant } from "./admin-schedule.dto";
+import { adminExternalQueueBody } from "./admin-external-queue.dto";
+
+export function configurationName(limit: number) {
+  return z.string().trim().refine(value => {
+    const chars=Array.from(value);
+    return chars.length>0&&chars.length<=limit&&chars.every(c=>c.charCodeAt(0)>=32&&c.charCodeAt(0)!==127
+      &&!(c.length===1&&c.charCodeAt(0)>=0xd800&&c.charCodeAt(0)<=0xdfff));
+  },"Identificação inválida.");
+}
+export const configurationTimezone=z.string().trim().min(1).max(80).refine(value=>{
+  if(/^[+-]/.test(value))return false;
+  try{new Intl.DateTimeFormat('en',{timeZone:value}).format(0);return true;}catch{return false;}
+},"Fuso IANA inválido.").transform(value=>new Intl.DateTimeFormat('en',{timeZone:value}).resolvedOptions().timeZone);
+const instant=z.string().transform((value,ctx)=>{
+  const normalized=normalizeScheduleInstant(value);
+  if(!normalized){ctx.addIssue({code:'custom',message:'Instante absoluto com fuso explícito obrigatório.'});return z.NEVER;}return normalized;
+});
+const code=z.string().transform((value,ctx)=>{
+  try{return normalizeEventAccessCode(value);}catch{ctx.addIssue({code:'custom',message:'Código de ingresso inválido.'});return z.NEVER;}
+});
+const reason=adminExternalQueueBody.shape.reason.optional();
+export const createEventBody=z.object({name:configurationName(180),accessCode:code,timezone:configurationTimezone,
+  startsAt:instant,officialEndsAt:instant,operationalDeadlineAt:instant,externalQueueEnabled:z.boolean(),reason}).strict()
+  .refine(v=>Date.parse(v.startsAt)<Date.parse(v.officialEndsAt)&&Date.parse(v.operationalDeadlineAt)>=Date.parse(v.officialEndsAt)
+    &&Date.parse(v.operationalDeadlineAt)-Date.parse(v.officialEndsAt)<=3_600_000,"Horários inválidos.");
+export const updateEventBody=z.object({name:configurationName(180),reason}).strict();
+export const experienceBody=z.object({name:configurationName(160),reason}).strict();
+export const stationBody=z.object({label:configurationName(120),reason}).strict();
+export const configurationBodies={create_event:createEventBody,update_event:updateEventBody,create_experience:experienceBody,
+  update_experience:experienceBody,create_station:stationBody,update_station:stationBody};
+export type ConfigOperation=keyof typeof configurationBodies;
+export const configurationEventParams=z.object({eventId:operationUuid}).strict();
+export const configurationExperienceParams=configurationEventParams.extend({experienceId:operationUuid}).strict();
+export const configurationStationParams=configurationExperienceParams.extend({stationId:operationUuid}).strict();
+export const effectivePhase=z.enum(['scheduled','not_ready','open','closing','closed']);
+const cursorValue=z.object({v:z.literal(1),createdAt:z.custom<string>(isPreciseInstant),id:operationUuid}).strict();
+export function encodeConfigurationCursor(createdAt:string,id:string){return Buffer.from(JSON.stringify(cursorValue.parse({v:1,createdAt,id}))).toString('base64url');}
+function decodeCursor(value:string){
+  try{if(!/^[A-Za-z0-9_-]{1,512}$/.test(value))return;const raw=Buffer.from(value,'base64url');if(raw.toString('base64url')!==value)return;
+    return cursorValue.parse(JSON.parse(new TextDecoder('utf-8',{fatal:true}).decode(raw)));}catch{return;}
+}
+export const configurationQuery=z.object({limit:z.string().regex(/^[1-9]\d?$/).transform(Number).pipe(z.number().max(50)).optional().default(20),
+  cursor:z.string().transform((value,ctx)=>{const cursor=decodeCursor(value);if(!cursor){ctx.addIssue({code:'custom',message:'Cursor inválido.'});return z.NEVER;}return cursor;}).optional(),
+  phase:effectivePhase.optional(),statusStored:z.enum(['scheduled','open','closing','closed']).optional()}).strict();
+export type ConfigurationPage=z.infer<typeof configurationQuery>;
+const precise=z.custom<string>(isPreciseInstant);
+const checks=z.object({nameAndAccessCode:z.boolean(),validScheduleAndTimezone:z.boolean(),externalQueueConfigured:z.boolean(),hasExperienceWithAvailableStation:z.boolean(),hasVerifiedActiveStaff:z.boolean()}).strict();
+export const configurationEventViewSchema=z.object({id:operationUuid,name:z.string(),accessCode:z.string(),timezone:z.string(),startsAt:precise,officialEndsAt:precise,operationalDeadlineAt:precise,
+  statusStored:z.enum(['scheduled','open','closing','closed']),closureMode:z.enum(['immediate','controlled']).nullable(),closureRequestedAt:precise.nullable(),adminDeadlineAt:precise.nullable(),
+  externalQueueEnabled:z.boolean(),effectivePhase,readiness:z.object({ready:z.boolean(),missing:z.array(z.string()),checks}).strict(),acceptingNewParticipations:z.boolean(),createdAt:precise,updatedAt:precise}).strict();
+export const configurationExperienceViewSchema=z.object({id:operationUuid,eventId:operationUuid,name:z.string(),queueAcceptingEntries:z.boolean(),lastQueueOrder:z.string().regex(/^(0|[1-9]\d*)$/),createdAt:precise,updatedAt:precise}).strict();
+export const configurationStationViewSchema=z.object({id:operationUuid,experienceId:operationUuid,label:z.string(),availability:z.enum(['available','unavailable']),pendingServiceSessionId:operationUuid.nullable(),createdAt:precise,updatedAt:precise}).strict();
diff --git a/backend/src/events/admin-configuration.mutation.ts b/backend/src/events/admin-configuration.mutation.ts
new file mode 100644
index 0000000000000000000000000000000000000000..25a7b5c474f2fc56f320124ef87d65eb5c4cd833
--- /dev/null
+++ b/backend/src/events/admin-configuration.mutation.ts
@@ -0,0 +1,23 @@
+import { sql, type SQL } from "drizzle-orm";
+import type { ConfigOperation } from "./admin-configuration.dto";
+import { effectiveEventDeadline } from "./event-closure.projection";
+
+/** Todos os predicados temporais/históricos e o efeito usam o mesmo relógio após os locks. */
+export function configurationMutation(operation:Exclude<ConfigOperation,'create_event'>,eventId:string,id:string,experienceId:string|undefined,body:Record<string,string|boolean|undefined>):SQL{
+  const allowed=sql`NOT f.ended AND (${operation==='create_station'}::boolean OR NOT f.history)`;
+  let write:SQL;
+  if(operation==='create_experience')write=sql`INSERT INTO experiences(id,event_id,name,queue_accepting_entries,last_queue_order,created_at,updated_at)
+    SELECT ${id}::uuid,${eventId}::uuid,${body.name}::varchar(160),true,0,f.at,f.at FROM facts f WHERE ${allowed} RETURNING id`;
+  else if(operation==='create_station')write=sql`INSERT INTO stations(id,experience_id,label,availability,created_at,updated_at)
+    SELECT ${id}::uuid,${experienceId}::uuid,${body.label}::varchar(120),'available',f.at,f.at FROM facts f WHERE ${allowed} RETURNING id`;
+  else if(operation==='update_event')write=sql`UPDATE events e SET name=${body.name}::varchar(180),updated_at=f.at FROM facts f WHERE e.id=${id}::uuid AND ${allowed} RETURNING e.id`;
+  else if(operation==='update_experience')write=sql`UPDATE experiences x SET name=${body.name}::varchar(160),updated_at=f.at FROM facts f
+    WHERE x.id=${id}::uuid AND x.event_id=${eventId}::uuid AND ${allowed} RETURNING x.id`;
+  else write=sql`UPDATE stations s SET label=${body.label}::varchar(120),updated_at=f.at FROM facts f
+    WHERE s.id=${id}::uuid AND s.experience_id=${experienceId}::uuid AND ${allowed} RETURNING s.id`;
+  return sql`WITH decision AS MATERIALIZED (SELECT clock_timestamp() AS at),facts AS MATERIALIZED (
+    SELECT d.at,(e.status='closed' OR ${effectiveEventDeadline()}<=d.at) AS ended,
+      EXISTS(SELECT 1 FROM participations p WHERE p.event_id=e.id) AS history FROM events e CROSS JOIN decision d WHERE e.id=${eventId}::uuid
+  ),written AS (${write}) SELECT f.ended,f.history,to_char(f.at AT TIME ZONE 'UTC','YYYY-MM-DD"T"HH24:MI:SS.US"Z"') AS at,w.id AS "writtenId"
+    FROM facts f LEFT JOIN written w ON true`;
+}
diff --git a/backend/src/events/admin-configuration.problem.ts b/backend/src/events/admin-configuration.problem.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9e2dd8e28efca7d3d20c331ef36d22bf5f85717c
--- /dev/null
+++ b/backend/src/events/admin-configuration.problem.ts
@@ -0,0 +1,17 @@
+import { ProblemException } from "../common/errors/problem.exception";
+import type { AdminAuthFailure } from "./admin-operation-auth";
+
+export type ConfigurationFailure=AdminAuthFailure|'resource_not_found'|'configuration_locked'|'event_ended'|'access_code_used'|'request_conflict'|'in_progress';
+export class AdminConfigurationError extends Error { constructor(readonly kind:ConfigurationFailure){super(kind);} }
+export function failConfiguration(kind:ConfigurationFailure):never{throw new AdminConfigurationError(kind);}
+const errors:Record<ConfigurationFailure,[number,string]>={account_inactive:[401,'ACCOUNT_DEACTIVATED'],admin_required:[403,'ADMIN_REQUIRED'],invalid_session:[401,'INVALID_SESSION'],
+  session_revoked:[401,'SESSION_REVOKED'],session_expired:[401,'SESSION_EXPIRED'],admin_2fa_required:[401,'ADMIN_2FA_REQUIRED'],resource_not_found:[404,'RESOURCE_NOT_FOUND'],
+  configuration_locked:[409,'EVENT_CONFIGURATION_LOCKED'],event_ended:[409,'EVENT_OPERATION_ENDED'],access_code_used:[409,'ACCESS_CODE_ALREADY_USED'],request_conflict:[409,'IDEMPOTENCY_KEY_REUSED'],in_progress:[409,'IDEMPOTENCY_IN_PROGRESS']};
+export async function executeConfiguration<T>(action:()=>Promise<T>):Promise<T>{
+  try{return await action();}catch(error){
+    if(error instanceof AdminConfigurationError){const [status,code]=errors[error.kind];throw new ProblemException({status,code,typeSlug:code.toLowerCase().replaceAll('_','-'),
+      title:status===404?'Recurso não encontrado':status===401?'Autenticação obrigatória':status===403?'Acesso negado':'Conflito de configuração',
+      detail:status===404?'Recurso não encontrado.':'A operação administrativa não pode ser aplicada ao estado atual.'});}
+    throw new Error('ADMIN_CONFIGURATION_INTERNAL_ERROR',{cause:error});
+  }
+}
diff --git a/backend/src/events/admin-configuration.projection.ts b/backend/src/events/admin-configuration.projection.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9a4dcb28c34989f5e0f80d7fd74bcc4ff6020d46
--- /dev/null
+++ b/backend/src/events/admin-configuration.projection.ts
@@ -0,0 +1,60 @@
+import { sql, type SQL } from "drizzle-orm";
+import { effectiveEventDeadline } from "./event-closure.projection";
+const trimCharacters="\u0009\u000a\u000b\u000c\u000d\u0020\u00a0\u1680\u2000\u2001\u2002\u2003\u2004\u2005\u2006\u2007\u2008\u2009\u200a\u2028\u2029\u202f\u205f\u3000\ufeff";
+
+/** Prontidão e fase em um único snapshot PostgreSQL; não materializa estado ou ocupação. */
+export function configurationProjection(condition:SQL=sql`true`,clock:SQL=sql`clock_timestamp()`):SQL{
+  return sql`WITH observation AS MATERIALIZED (SELECT ${clock} AS at), checks AS (
+    SELECT e.*,d.at,
+      (length(btrim(e.name,${trimCharacters}))>0 AND length(e.access_code_normalized) BETWEEN 4 AND 64
+        AND (e.access_code_normalized COLLATE "C") ~ '^[A-Z0-9]+(-[A-Z0-9]+)*$') AS "nameAndAccessCode",
+      (e.starts_at<e.official_ends_at AND e.official_ends_at<=e.operational_deadline_at
+        AND e.operational_deadline_at<=e.official_ends_at+interval '1 hour'
+        AND EXISTS(SELECT 1 FROM pg_timezone_names tz WHERE lower(tz.name)=lower(e.timezone))) AS "validScheduleAndTimezone",
+      (e.external_queue_enabled IS NOT NULL) AS "externalQueueConfigured",
+      EXISTS(SELECT 1 FROM experiences x JOIN stations s ON s.experience_id=x.id WHERE x.event_id=e.id AND s.availability='available') AS "hasExperienceWithAvailableStation",
+      EXISTS(SELECT 1 FROM user_roles r JOIN users u ON u.id=r.user_id WHERE r.event_id=e.id AND r.role='staff'
+        AND r.revoked_at IS NULL AND u.is_active AND u.email_verified_at IS NOT NULL) AS "hasVerifiedActiveStaff"
+    FROM events e CROSS JOIN observation d WHERE ${condition}
+  ), readiness AS (SELECT c.*,("nameAndAccessCode" AND "validScheduleAndTimezone" AND "externalQueueConfigured"
+    AND "hasExperienceWithAvailableStation" AND "hasVerifiedActiveStaff") AS ready FROM checks c),
+  projected AS (SELECT e.*,
+    CASE WHEN e.status='closed' OR ${effectiveEventDeadline()}<=e.at THEN 'closed'
+      WHEN e.status='closing' OR e.closure_requested_at IS NOT NULL OR e.official_ends_at<=e.at THEN 'closing'
+      WHEN e.at<e.starts_at THEN 'scheduled' WHEN NOT e.ready THEN 'not_ready' ELSE 'open' END AS phase,
+    (e.ready AND e.status NOT IN ('closing','closed') AND e.closure_requested_at IS NULL AND e.starts_at<=e.at AND e.at<e.official_ends_at) AS accepting
+    FROM readiness e)
+  SELECT id,name,access_code_normalized AS "accessCode",timezone,status AS "statusStored",phase AS "effectivePhase",external_queue_enabled AS "externalQueueEnabled",
+    closure_mode AS "closureMode",
+    to_char(starts_at AT TIME ZONE 'UTC','YYYY-MM-DD"T"HH24:MI:SS.US"Z"') AS "startsAt",
+    to_char(official_ends_at AT TIME ZONE 'UTC','YYYY-MM-DD"T"HH24:MI:SS.US"Z"') AS "officialEndsAt",
+    to_char(operational_deadline_at AT TIME ZONE 'UTC','YYYY-MM-DD"T"HH24:MI:SS.US"Z"') AS "operationalDeadlineAt",
+    to_char(closure_requested_at AT TIME ZONE 'UTC','YYYY-MM-DD"T"HH24:MI:SS.US"Z"') AS "closureRequestedAt",
+    to_char(admin_deadline_at AT TIME ZONE 'UTC','YYYY-MM-DD"T"HH24:MI:SS.US"Z"') AS "adminDeadlineAt",
+    to_char(created_at AT TIME ZONE 'UTC','YYYY-MM-DD"T"HH24:MI:SS.US"Z"') AS "createdAt",
+    to_char(updated_at AT TIME ZONE 'UTC','YYYY-MM-DD"T"HH24:MI:SS.US"Z"') AS "updatedAt",
+    to_char(at AT TIME ZONE 'UTC','YYYY-MM-DD"T"HH24:MI:SS.US"Z"') AS "observedAt",
+    ready,"nameAndAccessCode","validScheduleAndTimezone","externalQueueConfigured","hasExperienceWithAvailableStation","hasVerifiedActiveStaff",
+    accepting AS "acceptingNewParticipations" FROM projected`;
+}
+export interface ConfigurationRow extends Record<string,unknown>{id:string;name:string;accessCode:string;timezone:string;statusStored:string;effectivePhase:string;
+  startsAt:string;officialEndsAt:string;operationalDeadlineAt:string;closureMode:string|null;closureRequestedAt:string|null;adminDeadlineAt:string|null;
+  externalQueueEnabled:boolean;createdAt:string;updatedAt:string;observedAt:string;ready:boolean;acceptingNewParticipations:boolean;
+  nameAndAccessCode:boolean;validScheduleAndTimezone:boolean;externalQueueConfigured:boolean;hasExperienceWithAvailableStation:boolean;hasVerifiedActiveStaff:boolean;}
+export function readinessView(row:ConfigurationRow){
+  const checks={nameAndAccessCode:row.nameAndAccessCode,validScheduleAndTimezone:row.validScheduleAndTimezone,externalQueueConfigured:row.externalQueueConfigured,
+    hasExperienceWithAvailableStation:row.hasExperienceWithAvailableStation,hasVerifiedActiveStaff:row.hasVerifiedActiveStaff};
+  const missing=[...(!checks.nameAndAccessCode?['EVENT_NAME_OR_ACCESS_CODE_INVALID']:[]),...(!checks.validScheduleAndTimezone?['EVENT_SCHEDULE_INVALID']:[]),
+    ...(!checks.externalQueueConfigured?['EVENT_EXTERNAL_QUEUE_NOT_CONFIGURED']:[]),...(!checks.hasExperienceWithAvailableStation?['EXPERIENCE_WITH_AVAILABLE_STATION']:[]),...(!checks.hasVerifiedActiveStaff?['VERIFIED_ACTIVE_STAFF']:[])];
+  return {ready:row.ready,missing,checks};
+}
+export function configurationEventView(row:ConfigurationRow){
+  return {id:row.id,name:row.name,accessCode:row.accessCode,timezone:row.timezone,startsAt:row.startsAt,officialEndsAt:row.officialEndsAt,operationalDeadlineAt:row.operationalDeadlineAt,
+    statusStored:row.statusStored,closureMode:row.closureMode,closureRequestedAt:row.closureRequestedAt,adminDeadlineAt:row.adminDeadlineAt,externalQueueEnabled:row.externalQueueEnabled,
+    effectivePhase:row.effectivePhase,readiness:readinessView(row),acceptingNewParticipations:row.acceptingNewParticipations,createdAt:row.createdAt,updatedAt:row.updatedAt};
+}
+export const experienceSelection=sql`SELECT id,event_id AS "eventId",name,queue_accepting_entries AS "queueAcceptingEntries",last_queue_order::text AS "lastQueueOrder",
+  to_char(created_at AT TIME ZONE 'UTC','YYYY-MM-DD"T"HH24:MI:SS.US"Z"') AS "createdAt",to_char(updated_at AT TIME ZONE 'UTC','YYYY-MM-DD"T"HH24:MI:SS.US"Z"') AS "updatedAt" FROM experiences`;
+export const stationSelection=sql`SELECT s.id,s.experience_id AS "experienceId",s.label,s.availability,
+  (SELECT p.id FROM service_sessions p WHERE p.station_id=s.id AND p.status='pending') AS "pendingServiceSessionId",
+  to_char(s.created_at AT TIME ZONE 'UTC','YYYY-MM-DD"T"HH24:MI:SS.US"Z"') AS "createdAt",to_char(s.updated_at AT TIME ZONE 'UTC','YYYY-MM-DD"T"HH24:MI:SS.US"Z"') AS "updatedAt" FROM stations s`;
