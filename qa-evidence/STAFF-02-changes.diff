+
+  let tree = null;
+  const flatten = (value) => (Array.isArray(value)
+    ? value.map(flatten).join('')
+    : value && typeof value === 'object'
+      ? flatten(value.props?.children)
+      : String(value ?? ''));
+
+  return {
+    secureValues,
+    getPolling: () => pollingRegistration,
+    async mount() {
+      await Renderer.act(async () => {
