+  const renderEl = () => React.createElement(
+    AuthCtx.Provider,
+    { value: { ...authState, httpClient } },
+    React.createElement(StaffStationOperationalScreen, {
+      event: eventProp,
+      experience: experienceProp,
+      station: stationProp,
+      isEventCurrent: () => eventCurrentFlag,
+      onChanged,
+      onRefresh,
+      accessDenied: accessDeniedProp,
+      onAccessDenied,
+      getNow,
+    }),
