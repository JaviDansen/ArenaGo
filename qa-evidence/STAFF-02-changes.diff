+        }
+        return {
+          body: {
+            serviceSession: { id: prev.serviceSessionId, status: 'absent' },
+            previousQueueEntry: { id: prev.queueEntryId, status: 'closed', closeReason: 'absent' },
+            requeued: false,
+            newQueueEntry: null,
+          },
+        };
+      }
+      return undefined;
+    },
+  };
