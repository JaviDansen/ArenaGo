+        return {
+          eventId: staffEvent.id,
+          experienceId: realExperienceId,
+          waitingCount: waiting.length,
+          canCallWaitingEntries: waiting.length > 0,
+          firstWaitingQueueEntryId: waiting[0]?.queueEntryId ?? null,
