+type Options={access?:boolean;owner?:boolean;status?:string;entry?:"waiting"|"called";intent?:"replay"|"conflict"|"in_progress";fail?:string;ended?:boolean;badReplay?:boolean;brokenPointer?:boolean;completed?:number};
