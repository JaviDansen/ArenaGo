+  kind: "ok";
+  eventId: string;
+  experienceId: string;
+  observedAt: Date;
+  waitingCount: number;
+  acceptingNewEntries: boolean;
+  canCallWaitingEntries: boolean;
+  firstWaitingQueueEntryId: string | null;
+};
