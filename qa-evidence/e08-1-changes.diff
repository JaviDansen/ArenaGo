+if ($LASTEXITCODE -ne 0) { throw 'Revisar HTTP E08.1 antes da regressão.' }
+npm.cmd run test:integration
+if ($LASTEXITCODE -ne 0) { throw 'Revisar regressão PostgreSQL.' }
