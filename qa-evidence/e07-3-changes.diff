+async function mutate(c: PoolClient, p: Context, action: Action): Promise<{
+    changed: boolean;
+    newEntryId?: string;
+}> {
+    await c.query(`SELECT id FROM events WHERE id=$1 FOR ${action === "immediate" || action === "controlled" ? "UPDATE" : "SHARE"}`, [p.eventId]);
