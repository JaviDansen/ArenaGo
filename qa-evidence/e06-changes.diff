@@ -0,0 +1,30 @@
+/** Disponibilidade configurada; `available` não indica ausência de chamada pendente. */
+export interface ExperienceStationState {
+  id: string;
+  label: string;
+  available: boolean;
+}
+
+export interface ExperienceState {
+  id: string;
+  name: string;
+  acceptingNewQueueEntries: boolean;
+  /** Somente queue_entries waiting; uma fila compartilhada por todas as estações. */
+  waitingCount: number;
+  stations: ExperienceStationState[];
+}
+
+export interface EventExperiencesState {
+  eventId: string;
+  /** Relógio PostgreSQL no início da primeira consulta do snapshot; serializa como ISO 8601. */
+  observedAt: Date;
+  /** Existe ao menos uma experiência apta, respeitadas todas as condições globais. */
+  acceptingNewQueueEntries: boolean;
+  /** Experiências e suas estações são ordenadas por UUID crescente. */
+  experiences: ExperienceState[];
+}
+
+/** Ausência de evento e falta de participação ativa são indistinguíveis para o chamador. */
+export type EventExperiencesResult =
+  | { kind: "access_denied" }
+  | ({ kind: "ok" } & EventExperiencesState);
diff --git a/backend/test/unit/experiences.test.ts b/backend/test/unit/experiences.test.ts
new file mode 100644
index 0000000..9bc2b1c
--- /dev/null
+++ b/backend/test/unit/experiences.test.ts
@@ -0,0 +1,176 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { drizzle } from "drizzle-orm/node-postgres";
+import type { Client } from "pg";
+import * as schema from "../../src/database/schema";
+import { buildEventAvailabilityResult, evaluateEventConfigurationReadiness, type EventAvailabilityResult } from "../../src/events/event-availability";
+import { evaluateEventEntryWindow } from "../../src/events/event-entry-window";
+import { buildEventOperationalCapacityResult } from "../../src/events/event-operational-capacity";
+import { EventsService } from "../../src/events/events.service";
+import { ExperiencesService } from "../../src/events/experiences.service";
+
+const eventId = "00000000-0000-4000-8000-000000000001";
+const userId = "00000000-0000-4000-8000-000000000002";
+const observedAt = new Date("2026-10-29T15:00:00Z");
+const baseRow = {
+  id: "experience-a", name: "Just Dance", queueAcceptingEntries: true,
+  waitingCount: "3", stationId: "station-a", stationLabel: "Estação A", stationAvailable: true,
+};
+
+function fixture(options: {
+  access?: boolean;
+  clock?: number;
+  status?: string;
+  startsAt?: Date;
+  officialEndsAt?: Date;
+  closureRequestedAt?: Date | null;
+  staff?: boolean;
+  station?: boolean;
+  rows?: Array<Record<string, unknown>>;
+} = {}) {
+  const queries: Array<{ text: string; params: unknown[] }> = [];
+  let availabilityCalls = 0;
+  let availability: EventAvailabilityResult | undefined;
+  const client = {
+    async query(config: { text: string }, params: unknown[]) {
+      queries.push({ text: config.text, params });
+      if (config.text.startsWith("select") && config.text.includes('from "participations"')) {
+        return { rows: options.access === false ? [] : [[options.clock ?? observedAt.getTime()]] };
+      }
+      if (config.text.includes("WITH waiting_counts")) return { rows: options.rows ?? [baseRow] };
+      return { rows: [] };
+    },
+  };
+  const database = drizzle(client as unknown as Client, { schema });
+  const events = new EventsService(database);
+  events.evaluateEventAvailabilityById = async (id, at, executor) => {
+    availabilityCalls += 1;
+    assert.equal(id, eventId);
+    assert.equal(at.getTime(), observedAt.getTime());
+    assert.ok(executor);
+    assert.notEqual(executor, database);
+    const officialEndsAt = options.officialEndsAt ?? new Date("2026-10-29T16:00:00Z");
+    const event = {
+      name: "E06 unit", accessCodeNormalized: "E06-UNIT", timezone: "America/Sao_Paulo",
+      externalQueueEnabled: false,
+      startsAt: options.startsAt ?? new Date(officialEndsAt.getTime() - 2 * 60 * 60_000),
+      officialEndsAt,
+      operationalDeadlineAt: new Date(officialEndsAt.getTime() + 60 * 60_000),
+      closureRequestedAt: options.closureRequestedAt ?? null, adminDeadlineAt: null,
+    };
+    const configuration = evaluateEventConfigurationReadiness(event);
+    assert.equal(configuration.ready, true, "A fixture deve manter a configuração válida em todos os cenários.");
+    availability = buildEventAvailabilityResult({
+      eventId: id, eventStatus: options.status ?? "open",
+      configuration,
+      entryWindow: evaluateEventEntryWindow(event, at),
+      operationalCapacity: buildEventOperationalCapacityResult(options.staff ?? true, options.station ?? true),
+    });
+    return availability;
+  };
+  return { service: new ExperiencesService(database, events), queries, availabilityCalls: () => availabilityCalls, availability: () => availability };
+}
+
+test("E06 agrupa estações sem multiplicar fila; contrato seguro e transação somente leitura", async () => {
+  const { service, queries, availabilityCalls } = fixture({ rows: [
+    baseRow,
+    { ...baseRow, stationId: "station-b", stationLabel: "Estação B", stationAvailable: false },
+    { ...baseRow, id: "experience-b", name: "VR", stationId: null, stationLabel: null, stationAvailable: null, waitingCount: "0" },
+  ] });
+  assert.deepEqual(await service.getEventExperiences(userId, eventId), {
+    kind: "ok", eventId, observedAt, acceptingNewQueueEntries: true,
+    experiences: [
+      { id: "experience-a", name: "Just Dance", acceptingNewQueueEntries: true, waitingCount: 3,
+        stations: [{ id: "station-a", label: "Estação A", available: true }, { id: "station-b", label: "Estação B", available: false }] },
+      { id: "experience-b", name: "VR", acceptingNewQueueEntries: false, waitingCount: 0, stations: [] },
+    ],
+  });
+  assert.equal(availabilityCalls(), 1);
+  assert.equal(queries[0].text, "begin isolation level repeatable read read only");
+  assert.deepEqual(queries[1].params, [userId, eventId, "active", 1]);
+  assert.match(queries[1].text, /statement_timestamp\(\)/);
+  assert.match(queries[2].text, /status = 'waiting'/);
+  assert.match(queries[2].text, /GROUP BY experience_id/);
+  assert.match(queries[2].text, /ORDER BY e.id ASC, s.id ASC/);
+  assert.deepEqual(queries[2].params, [eventId, eventId]);
+  assert.equal(queries.at(-1)?.text, "commit");
+  assert.equal(queries.some((q) => /\b(update|insert|delete|for update|for share)\b/i.test(q.text)), false);
+});
+
+test("E06 acesso negado é explícito e não consulta dados internos", async () => {
+  const { service, queries, availabilityCalls } = fixture({ access: false });
+  assert.deepEqual(await service.getEventExperiences(userId, eventId), { kind: "access_denied" });
+  assert.equal(availabilityCalls(), 0);
+  assert.equal(queries.length, 3); // BEGIN, titularidade + relógio, COMMIT.
+});
+
+test("E06 cortes exatos, estado administrativo, início e capacidade só bloqueiam novas entradas", async () => {
+  for (const { options, missing } of [
+    { options: { officialEndsAt: observedAt }, missing: "EVENT_ENTRY_CLOSED" },
+    { options: { closureRequestedAt: observedAt }, missing: "EVENT_ENTRY_CLOSED" },
+    { options: { status: "closing" }, missing: "EVENT_ADMIN_CLOSING" },
+    { options: { status: "closed" }, missing: "EVENT_CLOSED" },
+    { options: { startsAt: new Date(observedAt.getTime() + 1) }, missing: "EVENT_NOT_STARTED" },
+    { options: { staff: false }, missing: "EVENT_HAS_NO_AUTHORIZED_STAFF" },
+    { options: { station: false }, missing: "EVENT_HAS_NO_AVAILABLE_STATION" },
+  ]) {
+    const { service, availability } = fixture(options);
+    const result = await service.getEventExperiences(userId, eventId);
+    assert.equal(result.kind, "ok");
+    if (result.kind !== "ok") assert.fail("Participante ativo deve continuar consultando.");
+    assert.equal(result.acceptingNewQueueEntries, false, JSON.stringify(options));
+    assert.equal(result.experiences[0].acceptingNewQueueEntries, false);
+    assert.equal(result.experiences[0].waitingCount, 3);
+    const evaluated = availability();
+    assert.ok(evaluated?.eventExists);
+    assert.deepEqual(evaluated.missing, [missing], "Somente a guarda do cenário pode impedir novas entradas.");
+    if (missing === "EVENT_ENTRY_CLOSED") {
+      assert.equal(evaluated.ready, true);
+      assert.equal(evaluated.withinEntryWindow, false);
+      assert.equal(evaluated.cutoffAt.getTime(), observedAt.getTime());
+    }
+  }
+  const atStart = fixture({ startsAt: observedAt });
+  const result = await atStart.service.getEventExperiences(userId, eventId);
+  assert.ok(result.kind === "ok" && result.acceptingNewQueueEntries);
+  const evaluated = atStart.availability();
+  assert.ok(evaluated?.eventExists);
+  assert.equal(evaluated.withinEntryWindow, true);
+  assert.deepEqual(evaluated.missing, []);
+});
+
+test("E06 fila pausada ou sem estação não bloqueia outra apta; indicador global exige alguma apta", async () => {
+  const blockedRows = [
+    { ...baseRow, queueAcceptingEntries: false },
+    { ...baseRow, id: "experience-b", stationAvailable: false },
+  ];
+  for (const rows of [blockedRows, [...blockedRows, { ...baseRow, id: "experience-c" }], []]) {
+    const { service } = fixture({ rows });
+    const result = await service.getEventExperiences(userId, eventId);
+    assert.ok(result.kind === "ok");
+    assert.equal(result.acceptingNewQueueEntries, rows.length === 3);
+    assert.deepEqual(result.experiences.map((e) => e.acceptingNewQueueEntries), rows.map((_, i) => i === 2));
+  }
+});
+
+test("E06 preserva contagens seguras como number e serializa sem bigint", async () => {
+  const { service } = fixture({ rows: [{ ...baseRow, waitingCount: String(Number.MAX_SAFE_INTEGER) }] });
+  const result = await service.getEventExperiences(userId, eventId);
+  assert.ok(result.kind === "ok");
+  const serialized = JSON.parse(JSON.stringify(result)) as { observedAt: string; experiences: Array<{ waitingCount: number }> };
+  assert.equal(serialized.observedAt, observedAt.toISOString());
+  assert.equal(serialized.experiences[0].waitingCount, Number.MAX_SAFE_INTEGER);
+});
+
+test("E06 rejeita relógio e contagem inválidos, sem devolver informação enganosa", async () => {
+  for (const clock of [NaN, Infinity, 9e15]) {
+    const { service, queries } = fixture({ clock });
+    await assert.rejects(service.getEventExperiences(userId, eventId), /PostgreSQL/);
+    assert.equal(queries.at(-1)?.text, "rollback");
+  }
+  for (const waitingCount of ["-1", "1.5", "9007199254740992", "garbage"]) {
+    const { service, queries } = fixture({ rows: [{ ...baseRow, waitingCount }] });
+    await assert.rejects(service.getEventExperiences(userId, eventId), /contagem/);
+    assert.equal(queries.at(-1)?.text, "rollback");
+  }
+});
diff --git a/backend/test/integration/experiences.integration.test.ts b/backend/test/integration/experiences.integration.test.ts
new file mode 100644
index 0000000..b7839c8
--- /dev/null
+++ b/backend/test/integration/experiences.integration.test.ts
@@ -0,0 +1,416 @@
+import assert from "node:assert/strict";
+import { randomUUID } from "node:crypto";
+import { after, test } from "node:test";
+import { drizzle } from "drizzle-orm/node-postgres";
+import { Pool } from "pg";
+import * as schema from "../../src/database/schema";
+import { EventsService } from "../../src/events/events.service";
+import { ExperiencesService } from "../../src/events/experiences.service";
+import type { EventExperiencesResult } from "../../src/events/experiences.types";
+import { assertSafeTestDatabase } from "./test-db-guard";
+
+// Validar as três fontes, incluindo parâmetros de redirecionamento, antes de criar pools.
+// Os imports do backend carregam a configuração existente; a barreira rejeita destinos
+// de desenvolvimento/homologação antes de qualquer conexão. Exigir preflight do processo.
+const urls = ["DATABASE_URL", "DATABASE_DIRECT_URL", "EVENTS_TEST_DATABASE_URL"].map((name) => {
+  const value = assertSafeTestDatabase(process.env[name]);
+  const url = new URL(value);
+  if (url.hostname !== "127.0.0.1" || url.port !== "55432" || url.pathname !== "/arenago_events_test") {
+    throw new Error(`${name} deve apontar exatamente a 127.0.0.1:55432/arenago_events_test.`);
+  }
+  return value;
+});
+const servicePool = new Pool({ connectionString: urls[2], application_name: `arena-e06-${randomUUID()}`, max: 3 });
+const fixturePool = new Pool({ connectionString: urls[2], max: 3 });
+const database = drizzle(servicePool, { schema });
+const service = new ExperiencesService(database, new EventsService(database));
+const ids = { events: [] as string[], users: [] as string[], versions: [] as string[] };
+const personalNames = new Map<string, string>();
+const orders = new Map<string, number>();
+
+after(async () => {
+  const errors: unknown[] = [];
+  try {
+    await cleanup();
+  } catch (error) {
+    errors.push(error);
+  } finally {
+    const closed = await Promise.allSettled([servicePool.end(), fixturePool.end()]);
+    for (const result of closed) if (result.status === "rejected") errors.push(result.reason);
+  }
+  if (errors.length) throw new AggregateError(errors, "Falha na limpeza/encerramento da suíte E06.");
+});
+
+/** Limpeza atômica limitada aos eventos/usuários próprios; nenhuma tabela global é esvaziada. */
+async function cleanup(): Promise<void> {
+  const client = await fixturePool.connect();
+  try {
+    await client.query("BEGIN");
+    await client.query("UPDATE participations SET current_queue_entry_id=NULL WHERE event_id=ANY($1::uuid[]) AND current_queue_entry_id IS NOT NULL", [ids.events]);
+    await client.query("DELETE FROM service_sessions s USING queue_entries q WHERE s.queue_entry_id=q.id AND q.event_id=ANY($1::uuid[])", [ids.events]);
+    await client.query("DELETE FROM queue_entries WHERE event_id=ANY($1::uuid[])", [ids.events]);
+    await client.query("DELETE FROM participation_profile_snapshots s USING participations p WHERE s.participation_id=p.id AND p.event_id=ANY($1::uuid[])", [ids.events]);
+    await client.query("DELETE FROM participations WHERE event_id=ANY($1::uuid[])", [ids.events]);
+    await client.query("DELETE FROM stations s USING experiences e WHERE s.experience_id=e.id AND e.event_id=ANY($1::uuid[])", [ids.events]);
+    await client.query("DELETE FROM experiences WHERE event_id=ANY($1::uuid[])", [ids.events]);
+    await client.query("DELETE FROM user_roles WHERE event_id=ANY($1::uuid[])", [ids.events]);
+    await client.query("DELETE FROM events WHERE id=ANY($1::uuid[])", [ids.events]);
+    await client.query("DELETE FROM users WHERE id=ANY($1::uuid[])", [ids.users]);
+    await client.query("DELETE FROM questionnaire_versions WHERE id=ANY($1::uuid[])", [ids.versions]);
+    await client.query("COMMIT");
+  } catch (error) {
+    await client.query("ROLLBACK").catch(() => undefined);
+    throw error;
+  } finally {
+    client.release();
+  }
+}
+
+async function createUser(name?: string): Promise<string> {
+  const id = randomUUID();
+  const personalName = name ?? `Pessoa privada E06 ${id}`;
+  await fixturePool.query(`INSERT INTO users(id,name,email,password_hash,email_verified_at,created_at,updated_at)
+    VALUES($1,$3,$2,'hash-privado',clock_timestamp(),clock_timestamp(),clock_timestamp())`,
+  [id, `${id}@example.test`, personalName]);
+  ids.users.push(id);
+  personalNames.set(id, personalName);
+  return id;
+}
+
+async function createEvent(): Promise<string> {
+  const id = randomUUID();
+  await fixturePool.query(`INSERT INTO events(id,name,access_code_normalized,timezone,starts_at,official_ends_at,
+    operational_deadline_at,status,external_queue_enabled,external_last_order,created_at,updated_at)
+    VALUES($1,'E06 fixture',$2,'America/Sao_Paulo',clock_timestamp()-interval '1 hour',clock_timestamp()+interval '1 hour',
+      clock_timestamp()+interval '90 minutes','open',true,9007199254741000,clock_timestamp(),clock_timestamp())`,
+  [id, `E06-${id.toUpperCase()}`]);
+  ids.events.push(id);
+  return id;
+}
+
+async function addParticipation(eventId: string, status: "active" | "waiting" | "finished" | "canceled" = "active", name?: string) {
+  const userId = await createUser(name);
+  const id = randomUUID();
+  const terminal = status === "finished" || status === "canceled";
+  await fixturePool.query(`INSERT INTO participations(id,user_id,event_id,status,joined_at,arena_entered_at,finished_at,finish_reason)
+    VALUES($1,$2,$3,$4,clock_timestamp(),CASE WHEN $4::varchar='active' THEN clock_timestamp() END,
+      CASE WHEN $5 THEN clock_timestamp() END,CASE WHEN $5 THEN 'fixture_finished' END)`,
+  [id, userId, eventId, status, terminal]);
+  return { id, userId };
+}
+
+async function createContext(participantName?: string, staffName?: string) {
+  const eventId = await createEvent();
+  const participant = await addParticipation(eventId, "active", participantName);
+  const staffId = await createUser(staffName);
+  const roleId = randomUUID();
+  await fixturePool.query("INSERT INTO user_roles(id,user_id,role,event_id,granted_at) VALUES($1,$2,'staff',$3,clock_timestamp())", [roleId, staffId, eventId]);
+  return { eventId, ...participant, staffId, roleId };
+}
+
+async function addExperience(eventId: string, id = randomUUID(), name = "Just Dance", accepting = true): Promise<string> {
+  await fixturePool.query(`INSERT INTO experiences(id,event_id,name,queue_accepting_entries,last_queue_order,created_at,updated_at)
+    VALUES($1,$2,$3,$4,9007199254741000,clock_timestamp(),clock_timestamp())`, [id, eventId, name, accepting]);
+  return id;
+}
+
+async function addStation(experienceId: string, available = true, id = randomUUID(), label = "Estação"): Promise<string> {
+  await fixturePool.query(`INSERT INTO stations(id,experience_id,label,availability,created_at,updated_at)
+    VALUES($1,$2,$3,$4,clock_timestamp(),clock_timestamp())`, [id, experienceId, label, available ? "available" : "unavailable"]);
+  return id;
+}
+
+async function addEntry(eventId: string, experienceId: string, status: "waiting" | "called" | "closed" = "waiting", name?: string) {
+  const participation = await addParticipation(eventId, "active", name);
+  const id = randomUUID();
+  const order = (orders.get(experienceId) ?? 0) + 1;
+  orders.set(experienceId, order);
+  await fixturePool.query(`INSERT INTO queue_entries(id,participation_id,event_id,experience_id,queue_order,status,entered_at,closed_at,close_reason)
+    VALUES($1,$2,$3,$4,$5,$6,clock_timestamp(),CASE WHEN $6::varchar='closed' THEN clock_timestamp() END,
+      CASE WHEN $6::varchar='closed' THEN 'fixture_completed' END)`, [id, participation.id, eventId, experienceId, order, status]);
+  if (status !== "closed") {
+    await fixturePool.query("UPDATE participations SET current_queue_entry_id=$2 WHERE id=$1", [participation.id, id]);
+  }
+  return { id, participation };
+}
+
+function requireState(result: EventExperiencesResult) {
+  assert.equal(result.kind, "ok");
+  if (result.kind !== "ok") assert.fail("Participante ativo deve ter acesso à consulta.");
+  return result;
+}
+
+async function persistedState(): Promise<string> {
+  // Texto JSON preserva inclusive bigint acima de MAX_SAFE_INTEGER para comparação integral.
+  const result = await fixturePool.query(`SELECT jsonb_build_object(
+    'events',(SELECT jsonb_agg(to_jsonb(e) ORDER BY e.id) FROM events e WHERE e.id=ANY($1::uuid[])),
+    'experiences',(SELECT jsonb_agg(to_jsonb(e) ORDER BY e.id) FROM experiences e WHERE e.event_id=ANY($1::uuid[])),
+    'stations',(SELECT jsonb_agg(to_jsonb(s) ORDER BY s.id) FROM stations s JOIN experiences e ON e.id=s.experience_id WHERE e.event_id=ANY($1::uuid[])),
+    'participations',(SELECT jsonb_agg(to_jsonb(p) ORDER BY p.id) FROM participations p WHERE p.event_id=ANY($1::uuid[])),
+    'queues',(SELECT jsonb_agg(to_jsonb(q) ORDER BY q.id) FROM queue_entries q WHERE q.event_id=ANY($1::uuid[])),
+    'sessions',(SELECT jsonb_agg(to_jsonb(s) ORDER BY s.id) FROM service_sessions s JOIN experiences e ON e.id=s.experience_id WHERE e.event_id=ANY($1::uuid[])),
+    'roles',(SELECT jsonb_agg(to_jsonb(r) ORDER BY r.id) FROM user_roles r WHERE r.event_id=ANY($1::uuid[])),
+    'users',(SELECT jsonb_agg(to_jsonb(u) ORDER BY u.id) FROM users u WHERE u.id=ANY($2::uuid[])),
+    'snapshots',(SELECT jsonb_agg(to_jsonb(s) ORDER BY s.participation_id) FROM participation_profile_snapshots s JOIN participations p ON p.id=s.participation_id WHERE p.event_id=ANY($1::uuid[]))
+  )::text AS state`, [ids.events, ids.users]);
+  return result.rows[0].state as string;
+}
