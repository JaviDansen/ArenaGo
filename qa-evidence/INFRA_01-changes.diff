+import { createHash } from "node:crypto";
+import { performance } from "node:perf_hooks";
+import { win32 } from "node:path";
+import { inspectPreparationSnapshot, type IntegrationPreflightPoolFactory } from "./integration-db-guard";
+import { integrationBlocked, integrationDestination } from "./integration-environment";
+import {
+  prepareStructuralReference, structuralSchemas, structuralSnapshot,
+} from "./integration-structural-reference";
+
+const postgresVersionNum = 180006;
+const service = "postgresql-x64-18";
+const sha256 = (value: string) => createHash("sha256").update(value).digest("hex");
+const isDigest = (value: unknown): value is string => typeof value === "string" && /^[a-f0-9]{64}$/u.test(value);
+
+export type WindowsPostgresIdentity = Readonly<{
+  address: string;
+  port: number;
+  service: string;
+  listenerPid: number;
+  servicePid: number;
+  postgresVersionNum: number;
+  clusterSha256: string;
+  instanceSha256: string;
+}>;
+
+function confirmIdentity(actual: WindowsPostgresIdentity, expected: WindowsPostgresIdentity) {
+  const { address, port } = integrationDestination;
+  if (actual?.address !== address || actual.port !== port || actual.service !== service
+      || actual.postgresVersionNum !== postgresVersionNum || !isDigest(actual.instanceSha256)
+      || !isDigest(actual.clusterSha256) || actual.clusterSha256 !== expected.clusterSha256
+      || ![actual.listenerPid, actual.servicePid].every(pid => Number.isSafeInteger(pid) && pid > 0)
+      || actual.listenerPid !== expected.listenerPid || actual.servicePid !== expected.servicePid
+      || actual.instanceSha256 !== expected.instanceSha256) {
+    throw integrationBlocked("Identidade operacional Windows ausente, divergente ou alterada.");
+  }
+}
+
+type Clock = Readonly<{ wallMs(): number; monotonicMs(): number }>;
+const systemClock: Clock = { wallMs: () => Date.now(), monotonicMs: () => performance.now() };
+
+export async function measureQuestionnaireClock(read: () => Promise<unknown>, clock: Clock = systemClock) {
+  const start = clock.monotonicMs();
+  const before = clock.wallMs();
+  const sample = await read() as { server_ms?: number; snapshot_ms?: number; activation_ms?: number } | undefined;
+  const after = clock.wallMs();
+  const elapsedMs = clock.monotonicMs() - start;
+  const { server_ms: server, snapshot_ms: snapshot, activation_ms: activation } = sample ?? {};
+  // Wall clock readings are quantized to milliseconds. Allow one tick at each boundary.
+  if (![before, after, elapsedMs].every(Number.isFinite)
+      || typeof server !== "number" || !Number.isFinite(server)
+      || typeof snapshot !== "number" || !Number.isFinite(snapshot)
+      || typeof activation !== "number" || !Number.isFinite(activation)
+      || elapsedMs < 0 || after < before || Math.abs(after - before - elapsedMs) > 2 || snapshot > server) {
+    throw integrationBlocked("Medição dos relógios inconclusiva.");
+  }
+  // The application sends a JavaScript Date back to PostgreSQL, losing submillisecond precision.
+  const applicationCutoff = Math.floor(server);
+  if (activation > snapshot || activation > before - 1 || activation > applicationCutoff - 1) {
+    throw integrationBlocked("Vigência do questionário incompatível com o intervalo observado.");
+  }
+  return {
+    elapsedMs, serverMs: server, snapshotMs: snapshot, activationMs: activation, applicationCutoffMs: applicationCutoff,
+    offsetMinMs: server - after - 1, offsetMaxMs: server - before + 1,
+    activationMarginMs: Math.min(snapshot, before - 1, applicationCutoff - 1) - activation,
+  };
+}
+
+export async function measurePreparationClock(read: () => Promise<unknown>, clock: Clock = systemClock) {
+  const samples: Awaited<ReturnType<typeof measureQuestionnaireClock>>[] = [];
+  for (let i = 0; i < 3; i++) samples.push(await measureQuestionnaireClock(read, clock));
+  const offsetMinMs = Math.max(...samples.map(sample => sample.offsetMinMs));
+  const offsetMaxMs = Math.min(...samples.map(sample => sample.offsetMaxMs));
+  if (offsetMinMs > offsetMaxMs || samples.some((sample, i) => sample.elapsedMs > 250
+      || sample.snapshotMs !== samples[0].snapshotMs || sample.activationMs !== samples[0].activationMs
+      || (i > 0 && sample.serverMs < samples[i - 1].serverMs))) {
+    throw integrationBlocked("Amostras consecutivas dos relógios inconclusivas.");
+  }
+  return { samples, offsetMinMs, offsetMaxMs, activationMarginMs: Math.min(...samples.map(sample => sample.activationMarginMs)) };
+}
+
+export type PreparationOperation =
+  | { kind: "extract-candidate" }
+  | { kind: "qualify"; expectedStructure: unknown };
+
+type PreparationDependencies = Readonly<{
+  env: NodeJS.ProcessEnv;
+  expectedIdentity: WindowsPostgresIdentity;
+  observeIdentity(): Promise<WindowsPostgresIdentity>;
+  createPool: IntegrationPreflightPoolFactory;
+  clock?: Clock;
+}>;
+
+// These operations return local evidence. Authority and artifact storage belong to a separate workflow.
+export async function simulateIntegrationPreparation(operation: PreparationOperation, options: PreparationDependencies & { mode: "simulation" }) {
+  if (options.mode !== "simulation") throw integrationBlocked("Preparação real indisponível nesta etapa.");
+  return collectPreparationEvidence(operation, options);
+}
+
+export async function collectPreparationEvidence(operation: PreparationOperation, options: PreparationDependencies) {
+  if (operation?.kind !== "extract-candidate" && operation?.kind !== "qualify") {
+    throw integrationBlocked("Operação de preparação desconhecida.");
+  }
+  const expected = { ...options.expectedIdentity };
+  const observe = async () => {
+    let actual: WindowsPostgresIdentity;
+    try {
+      actual = await options.observeIdentity();
+    } catch {
+      throw integrationBlocked("Evidência operacional Windows indisponível.");
+    }
+    confirmIdentity(actual, expected);
+  };
+  await observe();
+
+  const statements: string[] = [];
+  let candidate: { bytes: string; sha256: string } | undefined;
+  let structure: { sha256: string; kinds: Record<string, number>; foreignKeys: number } | undefined;
+  let clock: Awaited<ReturnType<typeof measurePreparationClock>> | undefined;
+  // Keep the existing pool options and lifecycle. Record hashes of statements, never driver messages or rows.
+  await inspectPreparationSnapshot(options.env, config => {
+    const pool = options.createPool(config);
+    return {
+      end: () => pool.end(),
+      async connect() {
+        await observe();
+        const client = await pool.connect();
+        return {
+          release: destroy => client.release(destroy),
+          query: sql => {
+            statements.push(sha256(sql));
+            return client.query(sql);
+          },
+        };
+      },
+    };
+  }, postgresVersionNum, (rows, schema) => {
+    const snapshot = structuralSnapshot(rows);
+    const objects = [...snapshot.objects.values()];
+    const kinds: Record<string, number> = {};
+    const foreignKeys = new Set<string>();
+    for (const object of objects) {
+      kinds[object.kind] = (kinds[object.kind] ?? 0) + 1;
+      if (object.kind === "constraint" && object.properties.constraintType === "f") {
+        foreignKeys.add(object.schema + "." + object.relation + "." + object.name);
+      }
+    }
+    // Require the identities discovered from migrations as well as the earlier inventory query.
+    const projected = new Set(objects.filter(object => object.kind !== "column"
+      && !(object.kind === "constraint" && object.properties.constraintType === "n")).map(object =>
+      object.kind + ":" + [object.schema, object.relation, object.name].filter(part => part !== null).join(".")
+      + (object.kind === "function" ? "(" + object.signature + ")" : "")));
+    const tablesWithColumns = new Set(objects.filter(object => object.kind === "column")
+      .map(object => object.schema + "." + object.relation));
+    if (schema.objects.length !== projected.size || schema.objects.some(object => !projected.has(object.kind + ":" + object.name))
+        || schema.objects.some(object => object.kind === "table" && !tablesWithColumns.has(object.name))
+        || schema.foreignKeys.length !== foreignKeys.size || schema.foreignKeys.some(name => !foreignKeys.has(name))) {
+      throw integrationBlocked("Projeção estrutural incompleta para o checkout.");
+    }
+    const observed = { formatVersion: 2, postgresVersionNum, schemas: structuralSchemas, migrations: schema.migrations, objects };
+    prepareStructuralReference(observed, schema.migrations);
+    if (operation.kind === "extract-candidate") {
+      const bytes = JSON.stringify(observed) + "\n";
+      candidate = { bytes, sha256: sha256(bytes) };
+    }
+    structure = { sha256: snapshot.sha256, kinds, foreignKeys: foreignKeys.size };
+  }, async read => {
+    clock = await measurePreparationClock(read, options.clock);
+  },
+  operation.kind === "qualify" ? { reference: operation.expectedStructure } : undefined);
+
+  await observe();
+  return { operation: operation.kind, clusterSha256: expected.clusterSha256,
+    instanceSha256: expected.instanceSha256, statements, structure, clock, candidate };
+}
+
+export type JournalDomain = Readonly<{ path: string; directoryId: string; operatorSid: string }>;
+export type JournalObservation = JournalDomain & Readonly<{
+  localNtfs: boolean;
+  withoutReparsePoints: boolean;
+  protectedAcl: boolean;
+  residual: boolean;
+}>;
+
+// Pure contract for the future OS adapter. There is no journal mutation or recovery operation here.
+export function confirmJournalDomain(expected: JournalDomain, observed: JournalObservation) {
+  if (!/^[A-Za-z]:\\[^:]+$/u.test(expected.path) || win32.normalize(expected.path) !== expected.path
+      || !expected.directoryId || !/^S-1-(?:\d+-)+\d+$/u.test(expected.operatorSid)
+      || typeof observed?.path !== "string" || observed.path.toLowerCase() !== expected.path.toLowerCase()
+      || observed.directoryId !== expected.directoryId || observed.operatorSid !== expected.operatorSid
+      || observed.localNtfs !== true || observed.withoutReparsePoints !== true
+      || observed.protectedAcl !== true || observed.residual !== false) {
+    throw integrationBlocked("Domínio do journal divergente, inconclusivo ou com recuperação pendente.");
+  }
+}
diff --git a/backend/test/infrastructure/integration-schema.ts b/backend/test/infrastructure/integration-schema.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a043c092696d4582182c9710159f2b27c3771c67
--- /dev/null
+++ b/backend/test/infrastructure/integration-schema.ts
@@ -0,0 +1,116 @@
+import { createHash } from "node:crypto";
+import { readFileSync, readdirSync } from "node:fs";
+import { join, resolve } from "node:path";
+import { CURATED_GAMES } from "../../src/games/games.types";
+import { DEFAULT_QUESTIONNAIRE_DEFINITION, DEFAULT_QUESTIONNAIRE_VERSION } from "../../src/profile/profile-questionnaire.types";
+
+const identifier = String.raw`(?:"([a-z_][a-z_0-9]*)"|([a-z_][a-z_0-9]*))`;
+const qualified = String.raw`(?:(?:public|"public")\.)?` + identifier;
+const ddl = new RegExp(
+  String.raw`^(CREATE TABLE|CREATE FUNCTION|CREATE (?:UNIQUE )?INDEX|CREATE (?:CONSTRAINT )?TRIGGER|ALTER TABLE)\s+` + qualified,
+  "iu",
+);
+const namedConstraint = new RegExp(String.raw`\bCONSTRAINT\s+` + identifier + String.raw`\s+(PRIMARY KEY|UNIQUE|CHECK|FOREIGN KEY)\b`, "giu");
+
+export type CatalogObject = { kind: string; name: string };
+
+export function checkoutSchema(directory = resolve(__dirname, "../../drizzle")) {
+  const journal: { dialect?: string; entries?: { idx: number; when: number; tag: string }[] } =
+    JSON.parse(readFileSync(join(directory, "meta", "_journal.json"), "utf8"));
+  const entries = journal.entries;
+  if (journal.dialect !== "postgresql" || !Array.isArray(entries) || !entries.length || entries.some((entry, index) =>
+    entry.idx !== index || !Number.isSafeInteger(entry.when) || entry.when <= (entries[index - 1]?.when ?? 0)
+    || !/^\d+_[a-z_0-9]+$/u.test(entry.tag))) throw new Error("Journal PostgreSQL inválido.");
+
+  const expectedFiles = new Set(entries.map(entry => entry.tag + ".sql"));
+  const files = readdirSync(directory).filter(file => file.endsWith(".sql"));
+  if (expectedFiles.size !== entries.length || files.length !== expectedFiles.size || files.some(file => !expectedFiles.has(file))) {
+    throw new Error("Arquivos SQL divergem do journal PostgreSQL.");
+  }
+
+  const objects: CatalogObject[] = [
+    { kind: "table", name: "drizzle.__drizzle_migrations" },
+    { kind: "sequence", name: "drizzle.__drizzle_migrations_id_seq" },
+    { kind: "index", name: "drizzle.__drizzle_migrations_pkey" },
+    { kind: "constraint", name: "drizzle.__drizzle_migrations.__drizzle_migrations_pkey" },
+  ];
+  const tables: string[] = [];
+  const foreignKeys: string[] = [];
+  const add = (kind: string, name: string) => objects.push({ kind, name: "public." + name });
+  const addConstraint = (table: string, name: string, type: string) => {
+    add("constraint", table + "." + name);
+    if (type === "FOREIGN KEY") foreignKeys.push("public." + table + "." + name);
+    if (type === "PRIMARY KEY" || type === "UNIQUE") add("index", name);
+  };
+
+  const migrations = entries.map(entry => {
+    const sql = readFileSync(join(directory, entry.tag + ".sql"), "utf8");
+    // Inventories the current migration grammar. New DDL shapes require an explicit review.
+    const statements = sql.replace(/\$(\w*)\$[\s\S]*?\$\1\$/gu, "''")
+      .replace(/'(?:''|[^'])*'/gu, "''")
+      .replace(/--[^\r\n]*|\/\*[\s\S]*?\*\//gu, "").split(";").map(value => value.trim()).filter(Boolean);
+    for (const statement of statements) {
+      const matched = ddl.exec(statement);
+      if (!matched) throw new Error("DDL sem reconhecimento no checkout.");
+      const [, operation, quoted, bare] = matched;
+      const name = quoted ?? bare;
+      if (operation === "CREATE TABLE" || operation === "ALTER TABLE") {
+        if (operation === "CREATE TABLE") {
+          tables.push(name);
+          add("table", name);
+        } else if (!tables.includes(name) || !/^\s+ADD (?:COLUMN|CONSTRAINT)\b/u.test(statement.slice(matched[0].length))) {
+          throw new Error("ALTER TABLE sem reconhecimento no checkout.");
+        }
+        const constraints = [...statement.matchAll(namedConstraint)];
+        if (operation === "ALTER TABLE" && !constraints.length && !/^\s+ADD COLUMN\b/u.test(statement.slice(matched[0].length))) {
+          throw new Error("Constraint sem reconhecimento no checkout.");
+        }
+        for (const [, quotedConstraint, bareConstraint, type] of constraints) {
+          addConstraint(name, quotedConstraint ?? bareConstraint, type);
+        }
+        if (operation === "CREATE TABLE" && /\bPRIMARY KEY\b/u.test(statement)
+            && !constraints.some(constraint => constraint[3] === "PRIMARY KEY")) addConstraint(name, name + "_pkey", "PRIMARY KEY");
+      } else if (operation.endsWith("INDEX")) {
+        add("index", name);
+      } else if (operation === "CREATE FUNCTION") {
+        if (!/^\s*\(\s*\)/u.test(statement.slice(matched[0].length))) throw new Error("Assinatura de função sem reconhecimento.");
+        add("function", name + "()");
+      } else {
+        const parent = new RegExp(String.raw`\sON\s+` + qualified + String.raw`(?=\s)`, "u").exec(statement);
+        if (!parent) throw new Error("Trigger sem tabela reconhecida.");
+        const trigger = (parent[1] ?? parent[2]) + "." + name;
+        add("trigger", trigger);
+        // PostgreSQL records user-defined constraint triggers in both catalogs.
+        if (operation === "CREATE CONSTRAINT TRIGGER") add("constraint", trigger);
+      }
+    }
+    return { tag: entry.tag, migration: String(entry.when), hash: createHash("sha256").update(sql).digest("hex") };
+  });
+  if (!tables.length || new Set(objects.map(object => object.kind + ":" + object.name)).size !== objects.length) {
+    throw new Error("Catálogo vazio ou duplicado nas migrations.");
+  }
+  return { objects, tables, foreignKeys, migrations, migrationTags: entries.map(entry => entry.tag) };
+}
+
+export function canonicalCatalogMatches(games: unknown, questionnaires: unknown): boolean {
+  if (!Array.isArray(games) || !Array.isArray(questionnaires) || games.length !== CURATED_GAMES.length
+      || questionnaires.length !== 1) return false;
+  const titles = new Set(CURATED_GAMES);
+  if (!games.every(row => row?.curated === true && titles.delete(row.name)) || titles.size) return false;
+  const questionnaire = questionnaires[0];
+  return questionnaire?.version === DEFAULT_QUESTIONNAIRE_VERSION && questionnaire.published === true
+    && isSameJson(questionnaire.definition, DEFAULT_QUESTIONNAIRE_DEFINITION);
+}
+
+// Ignore object key order from jsonb but preserve array order.
+function isSameJson(actual: unknown, expected: unknown): boolean {
+  if (Object.is(actual, expected)) return true;
+  if (Array.isArray(actual) || Array.isArray(expected)) {
+    return Array.isArray(actual) && Array.isArray(expected) && actual.length === expected.length
+      && expected.every((entry, index) => isSameJson(actual[index], entry));
+  }
+  if (!actual || !expected || typeof actual !== "object" || typeof expected !== "object") return false;
+  const fields = Object.entries(expected);
+  return fields.length === Object.keys(actual).length && fields.every(([key, value]) =>
+    Object.hasOwn(actual, key) && isSameJson((actual as Record<string, unknown>)[key], value));
+}
diff --git a/backend/test/infrastructure/integration-structural-reference.ts b/backend/test/infrastructure/integration-structural-reference.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ad8dc4c727fdfe7236a083b2ad11050a14e5535b
--- /dev/null
+++ b/backend/test/infrastructure/integration-structural-reference.ts
@@ -0,0 +1,228 @@
+import { createHash } from "node:crypto";
+import { integrationBlocked } from "./integration-environment";
+
+export const structuralSchemas = ["drizzle", "public"] as const;
+const schemaSet = new Set<string>(structuralSchemas);
+const supportedMajorVersion = 18;
+const structuralFormatVersion = 2;
+
+type ScalarFieldType = "text" | "nullableText" | "boolean" | "integer" | "nullableTextArray";
+type FieldType = ScalarFieldType | "foreignKeyTriggers";
+
+const foreignKeyTriggerFields = {
+  tableSchema: "text", tableName: "text", relatedSchema: "nullableText", relatedName: "nullableText",
+  functionSchema: "text", functionName: "text", functionSignature: "text",
+  eventsAndTiming: "integer", enabled: "text", deferrable: "boolean", initiallyDeferred: "boolean",
+} as const satisfies Record<string, ScalarFieldType>;
+
+type ScalarFieldValue = string | boolean | number | null | readonly string[];
+type ForeignKeyTrigger = Readonly<Record<keyof typeof foreignKeyTriggerFields, ScalarFieldValue>>;
+
+const fields = {
+  table: {
+    relationKind: "text", persistence: "text", rowSecurity: "boolean", forceRowSecurity: "boolean",
+  },
+  column: {
+    position: "integer", type: "text", notNull: "boolean", expression: "nullableText",
+    identity: "text", generated: "text", collation: "nullableText",
+  },
+  constraint: {
+    constraintType: "text", definition: "text", validated: "boolean", enforced: "boolean",
+    deferrable: "boolean", initiallyDeferred: "boolean", foreignKeyTriggers: "foreignKeyTriggers",
+  },
+  index: {
+    definition: "text", unique: "boolean", valid: "boolean", ready: "boolean", live: "boolean",
+    predicate: "nullableText",
+  },
+  function: {
+    definition: "text", language: "text", volatility: "text", securityDefiner: "boolean",
+    leakproof: "boolean", strict: "boolean", parallel: "text", configuration: "nullableTextArray",
+  },
+  trigger: {
+    definition: "text", enabled: "text", function: "text", eventsAndTiming: "integer",
+    deferrable: "boolean", initiallyDeferred: "boolean",
+  },
+  sequence: {
+    type: "text", start: "text", min: "text", max: "text", increment: "text", cache: "text",
+    cycle: "boolean", ownedBy: "nullableText",
+  },
+} as const satisfies Record<string, Record<string, FieldType>>;
+
+type Kind = keyof typeof fields;
+type FieldValue = ScalarFieldValue | readonly ForeignKeyTrigger[];
+
+export type StructuralObject = {
+  kind: Kind;
+  schema: string;
+  name: string;
+  relation: string | null;
+  signature: string | null;
+  properties: Readonly<Record<string, FieldValue>>;
+};
+
+type MigrationIdentity = { tag: string; migration: string; hash: string };
+
+// JSON-serializable input. A trusted reference must be supplied by the caller.
+export type StructuralReference = {
+  formatVersion: typeof structuralFormatVersion;
+  postgresVersionNum: number;
+  schemas: readonly string[];
+  migrations: readonly MigrationIdentity[];
+  objects: readonly StructuralObject[];
+};
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function isScalarField(value: unknown, type: ScalarFieldType): value is ScalarFieldValue {
+  switch (type) {
+    case "text": return typeof value === "string";
+    case "nullableText": return value === null || typeof value === "string";
+    case "boolean": return typeof value === "boolean";
+    case "integer": return Number.isSafeInteger(value);
+    case "nullableTextArray": return value === null || (Array.isArray(value) && value.every(item => typeof item === "string"));
+  }
+}
+
+function normalizeForeignKeyTriggers(value: unknown, object: StructuralObject, isForeignKey: boolean) {
+  if (!isForeignKey && value === null) return null;
+  const invalid = () => integrationBlocked("Projeção de triggers de chave estrangeira inválida em " + objectLabel(object) + ".");
+  if (!isForeignKey || !Array.isArray(value)) throw invalid();
+  const fields = Object.entries(foreignKeyTriggerFields);
+  const entries = value.map((trigger: unknown) => {
+    if (!isRecord(trigger) || Object.keys(trigger).length !== fields.length) throw invalid();
+    const canonical = Object.fromEntries(fields.map(([key, type]) => {
+      const field = trigger[key];
+      if (!Object.hasOwn(trigger, key) || !isScalarField(field, type)) throw invalid();
+      return [key, field];
+    })) as ForeignKeyTrigger;
+    return { key: JSON.stringify(canonical), trigger: canonical };
+  });
+  // Order is immaterial. Repeated entries are retained so multiplicity can be compared.
+  entries.sort((a, b) => a.key < b.key ? -1 : a.key > b.key ? 1 : 0);
+  return entries.map(entry => entry.trigger);
+}
+
+function objectKey(object: StructuralObject): string {
+  const { kind, schema, relation, name, signature } = object;
+  return JSON.stringify([kind, schema, relation, name, signature]);
+}
+
+function safeIdentifier(name: string): string {
+  return /^[A-Za-z_][A-Za-z_0-9]{0,62}$/u.test(name)
+    ? name
+    : "#" + createHash("sha256").update(name).digest("hex").slice(0, 12);
+}
+
+function objectLabel({ kind, schema, relation, name, signature }: StructuralObject): string {
+  const identifier = [schema, ...(relation === null ? [] : [relation]), name].map(safeIdentifier).join(".");
+  // Keep overloads distinguishable without interpolating deparsed definitions or signature text.
+  const overload = signature === null ? "" : signature === "" ? "()" : "(#" +
+    createHash("sha256").update(signature).digest("hex").slice(0, 12) + ")";
+  return kind + " " + identifier + overload;
+}
+
+type Snapshot = { objects: ReadonlyMap<string, StructuralObject>; sha256: string };
+
+export function structuralSnapshot(rows: unknown): Snapshot {
+  if (!Array.isArray(rows)) throw integrationBlocked("Lista de objetos estruturais inválida.");
+
+  const objects = new Map<string, StructuralObject>();
+  for (const row of rows) {
+    if (!isRecord(row) || typeof row.kind !== "string" || !Object.hasOwn(fields, row.kind)
+        || typeof row.schema !== "string" || !schemaSet.has(row.schema)
+        || typeof row.name !== "string" || !row.name.length) {
+      throw integrationBlocked("Identidade de objeto estrutural inválida.");
+    }
+    const { schema, name, relation, signature } = row;
+    const kind = row.kind as Kind;
+    const needsRelation = kind === "column" || kind === "constraint" || kind === "trigger";
+    if (!(needsRelation ? typeof relation === "string" && relation.length : relation === null)
+        || !(kind === "function" ? typeof signature === "string" : signature === null)) {
+      throw integrationBlocked("Identidade de objeto estrutural incompleta.");
+    }
+
+    const properties: Record<string, FieldValue> = {};
+    const object: StructuralObject = {
+      kind, schema, name, relation: relation as string | null, signature: signature as string | null, properties,
+    };
+    const source = row.properties;
+    if (!isRecord(source) || Object.keys(source).length !== Object.keys(fields[kind]).length) {
+      throw integrationBlocked("Projeção estrutural incompleta ou inválida em " + objectLabel(object) + ".");
+    }
+    for (const [property, type] of Object.entries(fields[kind])) {
+      const value = source[property];
+      if (type === "foreignKeyTriggers" && Object.hasOwn(source, property)) {
+        properties[property] = normalizeForeignKeyTriggers(value, object, source.constraintType === "f");
+        continue;
+      }
+      if (!Object.hasOwn(source, property) || type === "foreignKeyTriggers" || !isScalarField(value, type)) {
+        throw integrationBlocked("Propriedade estrutural inválida em " + objectLabel(object) + " (" + property + ").");
+      }
+      properties[property] = Array.isArray(value) ? [...value] : value;
+    }
+
+    const key = objectKey(object);
+    if (objects.has(key)) throw integrationBlocked("Objeto estrutural duplicado em " + objectLabel(object) + ".");
+    objects.set(key, object);
+  }
+
+  const ordered = new Map([...objects.keys()].sort().map(key => [key, objects.get(key)!]));
+  const sha256 = createHash("sha256").update(JSON.stringify([...ordered.values()])).digest("hex");
+  return { objects: ordered, sha256 };
+}
+
+export function prepareStructuralReference(reference: unknown, migrations: readonly MigrationIdentity[]) {
+  if (reference === undefined || reference === null) throw integrationBlocked("Referência estrutural confiável obrigatória.");
+  if (!isRecord(reference) || reference.formatVersion !== structuralFormatVersion || typeof reference.postgresVersionNum !== "number"
+      || !Number.isSafeInteger(reference.postgresVersionNum)
+      || Math.floor(reference.postgresVersionNum / 10000) !== supportedMajorVersion) {
+    throw integrationBlocked("Formato ou versão PostgreSQL incompatível na referência estrutural.");
+  }
+  if (!Array.isArray(reference.schemas) || reference.schemas.length !== schemaSet.size
+      || !structuralSchemas.every(schema => (reference.schemas as unknown[]).includes(schema))) {
+    throw integrationBlocked("Escopo de schemas incompatível na referência estrutural.");
+  }
+
+  if (!Array.isArray(reference.migrations) || reference.migrations.length !== migrations.length
+      || !migrations.every(({ tag, migration, hash }, index) => {
+        const entry: unknown = (reference.migrations as unknown[])[index];
+        return isRecord(entry) && entry.tag === tag && entry.migration === migration && entry.hash === hash;
+      })) {
+    throw integrationBlocked("Referência estrutural incompatível com as migrations do checkout.");
+  }
+  const expected = structuralSnapshot(reference.objects);
+  if (!expected.objects.size) throw integrationBlocked("Referência estrutural sem objetos.");
+  for (const object of expected.objects.values()) {
+    if (object.kind !== "constraint" || object.properties.constraintType !== "f") continue;
+    // The current migrations use ordinary, nonpartitioned foreign keys, with two triggers on each side.
+    const triggers = object.properties.foreignKeyTriggers as readonly ForeignKeyTrigger[];
+    if (object.properties.enforced !== true || triggers.length !== 4
+        || new Set(triggers.map(trigger => JSON.stringify(trigger))).size !== 4
+        || triggers.some(trigger => trigger.enabled !== "O" || trigger.functionSchema !== "pg_catalog"
+          || trigger.relatedSchema === null || trigger.relatedName === null)) {
+      throw integrationBlocked("Referência com triggers de chave estrangeira incompatíveis em " + objectLabel(object) + ".");
+    }
+  }
+  return { postgresVersionNum: reference.postgresVersionNum, expected };
+}
+
+export function compareStructuralCatalog(expected: Snapshot, rows: unknown): void {
+  const actual = structuralSnapshot(rows);
+  if (actual.sha256 === expected.sha256) return;
+
+  for (const [key, object] of expected.objects) {
+    const observed = actual.objects.get(key);
+    if (!observed) throw integrationBlocked("Objeto estrutural obrigatório ausente: " + objectLabel(object) + ".");
+    for (const [property, value] of Object.entries(object.properties)) {
+      if (JSON.stringify(observed.properties[property]) !== JSON.stringify(value)) {
+        throw integrationBlocked("Divergência estrutural em " + objectLabel(object) + " (" + property + ").");
+      }
+    }
+  }
+
+  for (const [key, object] of actual.objects) {
+    if (!expected.objects.has(key)) throw integrationBlocked("Objeto estrutural inesperado: " + objectLabel(object) + ".");
+  }
+}
diff --git a/backend/test/infrastructure/integration-structural-sql.ts b/backend/test/infrastructure/integration-structural-sql.ts
new file mode 100644
index 0000000000000000000000000000000000000000..85d2e2df2f856694e3719eafee815bdd0eaccaf8
--- /dev/null
+++ b/backend/test/infrastructure/integration-structural-sql.ts
@@ -0,0 +1,88 @@
+// The projections are paired with the fields required by formatVersion 2.
+// PostgreSQL OIDs are used for joins only. Definitions use the same search_path in both environments.
+export const structuralCatalogSql = `SELECT * FROM (
+  WITH relations AS (
+    SELECT c.*, n.nspname AS schema
+    FROM pg_catalog.pg_class c JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace
+    WHERE n.nspname IN ('public', 'drizzle') AND c.relkind IN ('r', 'p')
+  )
+  SELECT 'table' AS kind, r.schema, r.relname AS name, NULL::name AS relation, NULL::text AS signature,
+    jsonb_build_object('relationKind', r.relkind::text, 'persistence', r.relpersistence::text,
+      'rowSecurity', r.relrowsecurity, 'forceRowSecurity', r.relforcerowsecurity) AS properties
+  FROM relations r
+  UNION ALL
+  SELECT 'column', r.schema, a.attname, r.relname, NULL,
+    jsonb_build_object('position', a.attnum, 'type', format_type(a.atttypid, a.atttypmod),
+      'notNull', a.attnotnull, 'expression', pg_get_expr(d.adbin, d.adrelid, false),
+      'identity', a.attidentity::text, 'generated', a.attgenerated::text,
+      'collation', CASE WHEN col.oid IS NOT NULL THEN format('%I.%I', ns.nspname, col.collname) END)
+  FROM relations r JOIN pg_catalog.pg_attribute a ON a.attrelid = r.oid
+  LEFT JOIN pg_catalog.pg_attrdef d ON d.adrelid = a.attrelid AND d.adnum = a.attnum
+  LEFT JOIN pg_catalog.pg_collation col ON col.oid = a.attcollation
+  LEFT JOIN pg_catalog.pg_namespace ns ON ns.oid = col.collnamespace
+  WHERE a.attnum > 0 AND NOT a.attisdropped
+  UNION ALL
+  SELECT 'constraint', r.schema, k.conname, r.relname, NULL,
+    jsonb_build_object('constraintType', k.contype::text, 'definition', pg_get_constraintdef(k.oid, false),
+      'validated', k.convalidated, 'enforced', k.conenforced, 'deferrable', k.condeferrable,
+      'initiallyDeferred', k.condeferred,
+      'foreignKeyTriggers', CASE WHEN k.contype = 'f' THEN COALESCE((
+        SELECT jsonb_agg(jsonb_build_object(
+          'tableSchema', trigger_ns.nspname, 'tableName', trigger_rel.relname,
+          'relatedSchema', related_ns.nspname, 'relatedName', related_rel.relname,
+          'functionSchema', fn_ns.nspname, 'functionName', fn.proname,
+          'functionSignature', oidvectortypes(fn.proargtypes),
+          'eventsAndTiming', ri.tgtype, 'enabled', ri.tgenabled::text,
+          'deferrable', ri.tgdeferrable, 'initiallyDeferred', ri.tginitdeferred))
+        FROM pg_catalog.pg_trigger ri
+        JOIN pg_catalog.pg_class trigger_rel ON trigger_rel.oid = ri.tgrelid
+        JOIN pg_catalog.pg_namespace trigger_ns ON trigger_ns.oid = trigger_rel.relnamespace
+        LEFT JOIN pg_catalog.pg_class related_rel ON related_rel.oid = ri.tgconstrrelid
+        LEFT JOIN pg_catalog.pg_namespace related_ns ON related_ns.oid = related_rel.relnamespace
+        JOIN pg_catalog.pg_proc fn ON fn.oid = ri.tgfoid
+        JOIN pg_catalog.pg_namespace fn_ns ON fn_ns.oid = fn.pronamespace
+        WHERE ri.tgisinternal AND ri.tgconstraint = k.oid
+      ), '[]'::jsonb) END)
+  FROM relations r JOIN pg_catalog.pg_constraint k ON k.conrelid = r.oid
+  UNION ALL
+  SELECT 'index', n.nspname, c.relname, NULL, NULL,
+    jsonb_build_object('definition', pg_get_indexdef(c.oid, 0, false), 'unique', i.indisunique,
+      'valid', i.indisvalid, 'ready', i.indisready, 'live', i.indislive,
+      'predicate', pg_get_expr(i.indpred, i.indrelid, false))
+  FROM relations r JOIN pg_catalog.pg_index i ON i.indrelid = r.oid
+  JOIN pg_catalog.pg_class c ON c.oid = i.indexrelid
+  JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace
+  UNION ALL
+  SELECT 'function', n.nspname, p.proname, NULL, oidvectortypes(p.proargtypes),
+    jsonb_build_object('definition', pg_get_functiondef(p.oid), 'language', l.lanname,
+      'volatility', p.provolatile::text, 'securityDefiner', p.prosecdef, 'leakproof', p.proleakproof,
+      'strict', p.proisstrict, 'parallel', p.proparallel::text, 'configuration', p.proconfig)
+  FROM pg_catalog.pg_proc p JOIN pg_catalog.pg_namespace n ON n.oid = p.pronamespace
+  JOIN pg_catalog.pg_language l ON l.oid = p.prolang
+  WHERE n.nspname IN ('public', 'drizzle') AND p.prokind = 'f'
+  UNION ALL
+  SELECT 'trigger', r.schema, t.tgname, r.relname, NULL,
+    jsonb_build_object('definition', pg_get_triggerdef(t.oid, false), 'enabled', t.tgenabled::text,
+      'function', format('%I.%I(%s)', fn_schema.nspname, fn.proname, oidvectortypes(fn.proargtypes)),
+      'eventsAndTiming', t.tgtype, 'deferrable', t.tgdeferrable, 'initiallyDeferred', t.tginitdeferred)
+  FROM relations r JOIN pg_catalog.pg_trigger t ON t.tgrelid = r.oid
+  JOIN pg_catalog.pg_proc fn ON fn.oid = t.tgfoid
+  JOIN pg_catalog.pg_namespace fn_schema ON fn_schema.oid = fn.pronamespace
+  WHERE NOT t.tgisinternal
+  UNION ALL
+  SELECT 'sequence', n.nspname, c.relname, NULL, NULL,
+    jsonb_build_object('type', format_type(s.seqtypid, NULL), 'start', s.seqstart::text, 'min', s.seqmin::text,
+      'max', s.seqmax::text, 'increment', s.seqincrement::text, 'cache', s.seqcache::text, 'cycle', s.seqcycle,
+      'ownedBy', (
+        SELECT format('%I.%I.%I', owner_schema.nspname, owner_table.relname, a.attname)
+        FROM pg_catalog.pg_depend d
+        JOIN pg_catalog.pg_class owner_table ON owner_table.oid = d.refobjid
+        JOIN pg_catalog.pg_namespace owner_schema ON owner_schema.oid = owner_table.relnamespace
+        JOIN pg_catalog.pg_attribute a ON a.attrelid = d.refobjid AND a.attnum = d.refobjsubid
+        WHERE d.classid = 'pg_catalog.pg_class'::regclass AND d.refclassid = 'pg_catalog.pg_class'::regclass
+          AND d.objid = c.oid AND d.deptype IN ('a', 'i')
+      ))
+  FROM pg_catalog.pg_sequence s JOIN pg_catalog.pg_class c ON c.oid = s.seqrelid
+  JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace
+  WHERE n.nspname IN ('public', 'drizzle')
+) AS structural_catalog`;
diff --git a/backend/test/infrastructure/pilot-authorization.ts b/backend/test/infrastructure/pilot-authorization.ts
new file mode 100644
index 0000000000000000000000000000000000000000..11f8c28497381a4500ed6363d03179364f84b47c
--- /dev/null
+++ b/backend/test/infrastructure/pilot-authorization.ts
@@ -0,0 +1,11 @@
+import { integrationBlocked } from "./integration-environment";
+
+let authorizedSuite: string | undefined;
+export function authorizePilotSuite(suite: string) {
+  if (authorizedSuite || !["admin-external-queue-http", "admin-close-http"].includes(suite)
+      || !process.connected) throw integrationBlocked("Permissão supervisora ausente.");
+  authorizedSuite = suite;
+}
+export function requirePilotSuite(suite: string) {
+  if (authorizedSuite !== suite || !process.connected) throw integrationBlocked("Execução direta do piloto bloqueada.");
+}
diff --git a/backend/test/infrastructure/pilot-executor.ts b/backend/test/infrastructure/pilot-executor.ts
new file mode 100644
index 0000000000000000000000000000000000000000..f07f0505fdc6ae7b6df1d72d69687013e8e043ff
--- /dev/null
+++ b/backend/test/infrastructure/pilot-executor.ts
@@ -0,0 +1,243 @@
+import { execFile, execFileSync, spawn } from "node:child_process";
+import { createHash, randomUUID } from "node:crypto";
+import { readFile } from "node:fs/promises";
+import { join, resolve } from "node:path";
+import { promisify } from "node:util";
+import { Client } from "pg";
+import { executePilotCampaign } from "./campaign-orchestrator";
+import { fileCampaignJournal } from "./campaign-journal";
+import { superviseCampaignChild } from "./campaign-process";
+import { campaignSpawnEnvironment, windowsObserverEnvironment } from "./campaign-child-protocol";
+import { loadIndependentReference, readTerminalPassword } from "./read-postgres-preparation";
+import { integrationBlocked, windowsObserverVariableGroups, campaignStep, campaignFailure, CampaignDiagnosticError } from "./integration-environment";
+import { attestIntegrationIdentity, type IntegrationPreflightPoolFactory } from "./integration-db-guard";
+import type { WindowsPostgresIdentity } from "./integration-preparation";
+
+const exec = promisify(execFile);
+const executionId = randomUUID();
+let mainInvocations = 0;
+let pilotInvocations = 0;
+let currentCampaign: string | undefined;
+const uuid = /^[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$/u;
+function trace(event: string, campaignId?: string, worker?: { runId: string; pid: number; ppid: number; invocations: number },
+  diagnostic?: CampaignDiagnosticError['diagnostic']) {
+  if (campaignId && uuid.test(campaignId)) currentCampaign = campaignId;
+  // Fixed fields only. Never print arguments, environment, URLs or exception text.
+  try { process.stderr.write('[INFRA_PILOT_TRACE] ' + JSON.stringify({ event, executionId,
+    pid: process.pid, ppid: process.ppid, campaignId: currentCampaign ?? null,
+    mainInvocations, pilotInvocations, ...(worker ? { worker } : {}),
+    ...(diagnostic ? { diagnostic: { stage: diagnostic.stage, code: diagnostic.code } } : {}) }) + '\n'); }
+  catch { /* tracing cannot alter authorization or cleanup */ }
+}
+type CheckStage = 'entry' | 'observer-environment' | 'windows-observer' | 'windows-json' | 'windows-fingerprint'
+  | 'journal-observer' | 'journal-json' | 'journal-continuity' | 'reference-authority';
+class PilotCheckError extends Error {}
+export function pilotCheckDiagnostic(stage: CheckStage, error: unknown): string {
+  const e = error && typeof error === 'object' ? error as { code?: unknown; killed?: unknown; stderr?: unknown } : {};
+  // Never emit driver/child messages, arguments, environment, stack or raw streams.
+  // Windows process status is a DWORD, not a Unix 8-bit exit status.
+  const code = typeof e.code === 'number' && Number.isInteger(e.code) && e.code >= -2147483648 && e.code <= 4294967295 ? String(e.code)
+    : typeof e.code === 'string' && ['ENOENT','EACCES','EPERM','EINVAL','UNKNOWN','ERR_INVALID_ARG_VALUE','ERR_CHILD_PROCESS_STDIO_MAXBUFFER'].includes(e.code) ? e.code : 'unavailable';
+  const observer = typeof e.stderr === 'string' ? /\[INFRA_OBSERVER:(paths|listener|processes|data|fingerprint|recheck|domain)\]/u.exec(e.stderr)?.[1] : undefined;
+  const detail = typeof e.stderr === 'string' ? /\[INFRA_DOMAIN:(identity|elevation|arguments|path|volume|reparse|acl-read|owner|rights|inheritance|children|fsutil|file-id|cim|approval-read|approval-json|approval-path|approval-id|approval-sid|serialization):(authority|reference|approval|domain-record|journal|child)\]/u.exec(e.stderr) : null;
+  return `[SEGURANÇA BLOQUEADA] check-stage=${stage}; code=${code}; timeout=${e.killed === true}; observer=${observer ?? 'unavailable'}${detail ? `; domain-stage=${detail[1]}; area=${detail[2]}` : ''}.`;
+}
+async function checkStep<T>(stage: CheckStage, work: () => T | Promise<T>): Promise<T> {
+  try { return await work(); }
+  catch (error) { throw new PilotCheckError(pilotCheckDiagnostic(stage, error)); }
+}
+/** Shared verbatim by the operational probe and supervisor; no SQL or credential input. */
+export function pilotWindowsObserverInvocation(bin: string, data: string, groups?: readonly (keyof typeof windowsObserverVariableGroups)[]) {
+  const env = windowsObserverEnvironment(process.env, groups);
+  return {
+    file: join(env.SystemRoot!, 'System32/WindowsPowerShell/v1.0/powershell.exe'),
+    args: ['-NoProfile', '-NonInteractive', '-File', join(__dirname, 'inspect-postgres-windows.ps1'),
+      '-ExpectedBinDirectory', bin, '-ExpectedDataDirectory', data],
+    options: { windowsHide: true, timeout: 30_000, maxBuffer: 32_768, encoding: 'utf8' as const, env },
+  };
+}
+export function pilotJournalObserverInvocation() {
+  const env = windowsObserverEnvironment(process.env);
+  if (!env.ProgramData) throw integrationBlocked('ProgramData ausente.');
+  return {
+    file: join(env.SystemRoot!, 'System32/WindowsPowerShell/v1.0/powershell.exe'),
+    args: ['-NoProfile', '-NonInteractive', '-File', join(__dirname, 'inspect-pilot-domain.ps1'),
+      '-Directory', join(env.ProgramData, 'ArenaGO/integration/127.0.0.1-55432-arenago_events_test'),
+      '-Authority', join(env.ProgramData, 'ArenaGO/integration-authority')],
+    options: { windowsHide: true, timeout: 30_000, maxBuffer: 32_768, encoding: 'utf8' as const, env },
+  };
+}
+const ids: Record<string, string[]> = {
+  D06: ["admin-external-queue-http"], D09: ["admin-close-http"],
+  both: ["admin-external-queue-http", "admin-close-http"],
+};
+
+async function main() {
+  mainInvocations++;
+  trace('executor-main-enter');
+  const [action, bin, data, fingerprint, ...extra] = process.argv.slice(2);
+  if (process.platform !== "win32" || process.env.NODE_ENV !== "test" || !process.env.ProgramData || !process.env.SystemRoot || extra.length
+      || !(action === "check" || Object.hasOwn(ids, action))
+      || !bin || !data || !/^[a-f0-9]{64}$/u.test(fingerprint ?? "")
+      || Object.keys(process.env).some(key => /^(PG|NODE_OPTIONS$|NODE_PATH$|NODE_DEBUG|NODE_PG_FORCE_NATIVE$)/iu.test(key))) {
+    throw new PilotCheckError(pilotCheckDiagnostic('entry', undefined));
+  }
+  const programData = process.env.ProgramData;
+  const directory = join(programData, "ArenaGO/integration/127.0.0.1-55432-arenago_events_test");
+  const authority = join(programData, "ArenaGO/integration-authority");
+  let identity: WindowsPostgresIdentity | undefined;
+  let domain: string | undefined;
+  async function observe() {
+    const windowsCall = await checkStep('observer-environment', () => pilotWindowsObserverInvocation(bin, data));
+    const output = await checkStep('windows-observer', () => exec(windowsCall.file, windowsCall.args, windowsCall.options));
+    const operational = await checkStep('windows-json', () => JSON.parse(output.stdout) as WindowsPostgresIdentity);
+    await checkStep('windows-fingerprint', () => {
+      if (!operational || operational.instanceSha256 !== fingerprint || (identity && JSON.stringify(operational) !== JSON.stringify(identity))) throw new Error();
+    });
+    identity = operational;
+    const journalCall = await checkStep('observer-environment', () => pilotJournalObserverInvocation());
+    const currentDomain = (await checkStep('journal-observer', () => exec(journalCall.file, journalCall.args, journalCall.options))).stdout.trim();
+    await checkStep('journal-json', () => {
+      const value: unknown = JSON.parse(currentDomain);
+      if (!value || typeof value !== 'object' || !('path' in value) || value.path !== directory
+          || !('directoryId' in value) || typeof value.directoryId !== 'string' || !/^[a-f0-9]+:0x[a-f0-9]{16,32}$/iu.test(value.directoryId)
+          || !('operatorSid' in value) || typeof value.operatorSid !== 'string' || !/^S-1-5-21-(\d+-){3}\d+$/u.test(value.operatorSid)) throw new Error();
+    });
+    await checkStep('journal-continuity', () => { if (domain && currentDomain !== domain) throw new Error(); });
+    domain = currentDomain;
+  }
+  await observe();
+  const reference = await checkStep('reference-authority', () => loadIndependentReference(programData, identity!));
+  if (action === "check") {
+    console.log("Windows, autoridade e domínio do piloto conferidos. Nenhuma conexão SQL aberta.");
+    return;
+  }
+  const password = await campaignStep('credentials', () => readTerminalPassword(process.stdin, message => { process.stderr.write(message); }));
+  const url = "postgresql://arenago:" + password + "@127.0.0.1:55432/arenago_events_test";
+  const pg = { connectionString: url, ssl: false as const, connectionTimeoutMillis: 2_000,
+    statement_timeout: 5_000, query_timeout: 6_000, application_name: "arenago-pilot-supervisor" };
+  async function connect(config: object = {}) {
+    await campaignStep('connection-attestation', observe);
+    const client = await campaignStep('configuration', () => new Client({ ...pg, ...config }));
+    client.on("error", () => {});
+    try { await client.connect(); return client; }
+    catch (error) {
+      await client.end().catch(error => { console.error(new CampaignDiagnosticError(campaignFailure('lock-close', error)).message); });
+      throw new CampaignDiagnosticError(campaignFailure('connection', error));
+    }
+  }
+  let continuity: string | undefined;
+  let supervisorPid: number | undefined;
+  const readPool: IntegrationPreflightPoolFactory = config => {
+    let client: Client | undefined;
+    return {
+      async connect() {
+        client = await connect(config);
+        return {
+          async query(sql) {
+            if (sql.startsWith("BEGIN ")) {
+              const opened = await client!.query(sql);
+              const session = (await client!.query(`SELECT current_setting('transaction_read_only') AS ro,
+                current_setting('transaction_isolation') AS isolation,
+                current_setting('search_path') AS path, current_setting('TimeZone') AS zone,
+                current_setting('session_replication_role') AS replication`)).rows[0];
+              if (session.ro !== "on" || session.isolation !== "repeatable read" || session.path !== "pg_catalog"
+                  || session.zone !== "UTC" || session.replication !== "origin") {
+                throw integrationBlocked("Sessão de preflight incompatível.");
+              }
+              const others = await client!.query(`SELECT 1 FROM pg_catalog.pg_stat_activity
+                WHERE datname=current_database() AND pid<>pg_backend_pid() AND pid<>$1`, [supervisorPid]);
+              if (others.rowCount) throw integrationBlocked("Outro escritor ou conexão presente na janela piloto.");
+              return opened;
+            }
+            if (sql === "ROLLBACK") {
+              const rows = (await client!.query(`SELECT
+                (SELECT jsonb_agg(to_jsonb(g) ORDER BY id) FROM public.games g) AS games,
+                (SELECT jsonb_agg(to_jsonb(q) ORDER BY id) FROM public.questionnaire_versions q) AS questionnaires`)).rows;
+              const digest = createHash("sha256").update(JSON.stringify(rows)).digest("hex");
+              if (continuity && continuity !== digest) throw integrationBlocked("Continuidade do baseline divergente.");
+              continuity = digest;
+            }
+            return client!.query(sql);
+          },
+          release() { /* this private session is closed by end, also after failed ROLLBACK */ },
+        };
+      },
+      async end() { await client?.end(); },
+    };
+  };
+  const controller = new AbortController();
+  process.once("SIGINT", () => controller.abort());
+  process.once('SIGTERM', () => controller.abort());
+  const revision = await campaignStep('revision', () => ({
+    branch: execFileSync("git", ["branch", "--show-current"], { encoding: "utf8" }).trim(),
+    commit: execFileSync("git", ["rev-parse", "HEAD"], { encoding: "utf8" }).trim(),
+  }));
+  pilotInvocations++;
+  trace('execute-pilot-call');
+  const result = await campaignStep('campaign', () => executePilotCampaign({
+    mode: "real", selection: { suites: ids[action] }, connectionString: url,
+    parentEnvironment: process.env, revision, signal: controller.signal, timeoutMs: 300_000, trace,
+  }, {
+    reference: {
+      approval: () => ({ source: "protected-programdata", sha256: reference.sha256, kind: "homologated" }),
+      readApprovedSource: async () => { await observe(); return readFile(join(authority, "reference-v2.json")); },
+    },
+    async openLockConnection() {
+      const client = await connect();
+      try { supervisorPid = (await campaignStep('sql-identity', () => client.query("SELECT pg_backend_pid() AS pid"))).rows[0].pid; }
+      catch (error) { await client.end(); throw error; }
+      return {
+        query: sql => client.query(sql),
+        close: () => campaignStep('lock-close', () => client.end()),
+        onDisconnect(listener) {
+          client.on("error", listener);
+          client.on("end", listener);
+          return () => { client.off("error", listener); client.off("end", listener); };
+        },
+      };
+    },
+    createReadPool: readPool,
+    journal: {
+      async claim(record) {
+        await observe();
+        const handle = await campaignStep('journal-admission', () => fileCampaignJournal(directory).claim(record));
+        return {
+          async save(next) { await campaignStep('connection-attestation', observe); await campaignStep('journal-save', () => handle.save(next)); },
+          async finish() { await campaignStep('connection-attestation', observe); await campaignStep('journal-finish', () => handle.finish()); },
+        };
+      },
+    },
+    launch(suite, env, request) {
+      const child = spawn(process.execPath, ["--require", join(__dirname, "pilot-loader.cjs"),
+        join(__dirname, "pilot-worker.ts"), suite, request.campaignId, request.referenceSha256, bin, data, fingerprint], {
+        cwd: resolve(__dirname, "../.."), env: campaignSpawnEnvironment(env),
+        windowsHide: true, shell: false, stdio: ["ignore", "pipe", "pipe", "ipc"],
+      });
+      child.once('close', () => trace('worker-close', request.campaignId));
+      return superviseCampaignChild(child, { campaignId: request.campaignId,
+        trace: (event, worker) => trace(event, request.campaignId, worker) });
+    },
+    async resourcesReleased() {
+      await observe();
+      const client = await connect();
+      try {
+        await campaignStep('sql-identity', () => attestIntegrationIdentity(client, 180006));
+        const r = await client.query(`SELECT
+          NOT EXISTS (SELECT FROM pg_catalog.pg_stat_activity
+            WHERE datname=current_database() AND pid<>pg_backend_pid() AND pid<>$1) AS clear,
+          NOT EXISTS (SELECT FROM pg_catalog.pg_prepared_xacts WHERE database=current_database()) AS prepared_clear`, [supervisorPid]);
+        return r.rows[0]?.clear === true && r.rows[0]?.prepared_clear === true;
+      } finally { await client.end(); }
+    },
+  }));
+  console.log(JSON.stringify(result));
+  trace('executor-result', result.id);
+  process.exitCode = result.phase === "clean" ? 0 : result.terminalPersistence === 'failed' ? 2 : 1;
+}
+if (require.main === module) { trace('executor-entry'); process.once('exit', () => trace('executor-process-exit')); void main().catch((error: unknown) => {
+  trace('executor-catch', undefined, undefined, error instanceof CampaignDiagnosticError ? error.diagnostic : undefined);
+  console.error(error instanceof PilotCheckError || error instanceof CampaignDiagnosticError ? error.message
+    : "[SEGURANÇA BLOQUEADA] Piloto inconclusivo. Preserve journal e marcador para revisão manual.");
+  process.exitCode = 2;
+}); }
