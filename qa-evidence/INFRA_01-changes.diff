@@ -0,0 +1,18 @@
+'use strict';
+const { readdirSync } = require('node:fs');
+const { join } = require('node:path');
+const { spawnSync } = require('node:child_process');
+if (process.argv.length !== 3 || process.argv[2] !== '--legacy') {
+  console.error('Integração completa indisponível durante a migração. D06/D09 exigem pilot-executor. Para as 41 suítes legadas, use npm run test:integration -- --legacy, em campanha isolada e autorizada.');
+  process.exitCode = 2;
+} else {
+  const excluded = new Set(['admin-close-http.integration.test.ts', 'admin-external-queue-http.integration.test.ts']);
+  const files = readdirSync(join(__dirname, '../test/integration')).filter(file => file.endsWith('.integration.test.ts') && !excluded.has(file));
+  if (files.length !== 41) throw Error('Inventário legado divergente.');
+  console.log('Campanha LEGADA, 41 suítes. D06 e D09 excluídas explicitamente. Execução exclusiva, sem piloto simultâneo.');
+  const result = spawnSync(process.execPath, [require.resolve('tsx/cli'), '--tsconfig', 'tsconfig.test.json', '--test',
+    '--test-concurrency=1', ...files.map(file => join('test/integration', file))], {
+    cwd: join(__dirname, '..'), stdio: 'inherit', shell: false,
+  });
+  process.exitCode = result.error || result.status === null ? 2 : result.status;
+}
diff --git a/backend/test/infrastructure/campaign-child-protocol.ts b/backend/test/infrastructure/campaign-child-protocol.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2b0af480853e3382418e663d63ab024436fbab3f
--- /dev/null
+++ b/backend/test/infrastructure/campaign-child-protocol.ts
@@ -0,0 +1,139 @@
+import { randomUUID } from "node:crypto";
+import { win32 } from "node:path";
+import { within } from "./campaign-deadline";
+import { campaignDestination, validTally, type Tally } from "./campaign-journal";
+import { integrationBlocked, validateIntegrationEnvironment, windowsObserverVariableGroups } from "./integration-environment";
+
+export type CampaignPermit = Readonly<{
+  campaignId: string;
+  suite: string;
+  profile: string;
+  destination: string;
+  referenceSha256: string;
+}>;
+
+export type CampaignIdentity = Pick<CampaignPermit, "campaignId" | "referenceSha256">;
+
+// libuv copies these Windows defaults from the parent when omitted, even with an explicit env.
+const windowsSpawnDefaults = ["HOMEDRIVE", "HOMEPATH", "LOGONSERVER", "SYSTEMDRIVE", "USERDOMAIN", "USERNAME", "WINDIR"];
+
+export function campaignSpawnEnvironment(env: NodeJS.ProcessEnv): NodeJS.ProcessEnv {
+  // An own property with undefined blocks Node's automatic coverage propagation.
+  const childEnv: NodeJS.ProcessEnv = { ...env, NODE_V8_COVERAGE: undefined };
+  if (process.platform === "win32") {
+    for (const name of windowsSpawnDefaults) {
+      if (childEnv[name] === undefined) childEnv[name] = "";
+    }
+  }
+  return childEnv;
+}
+
+/** OS observers never need database URLs or application credentials. */
+export function windowsObserverEnvironment(parent: NodeJS.ProcessEnv,
+  groups: readonly (keyof typeof windowsObserverVariableGroups)[] = Object.keys(windowsObserverVariableGroups) as (keyof typeof windowsObserverVariableGroups)[],
+): NodeJS.ProcessEnv {
+  const value = (name: string) => Object.entries(parent).find(([key]) => key.toUpperCase() === name.toUpperCase())?.[1];
+  const root = value("SystemRoot");
+  if (!root || !/^[A-Za-z]:\\[^:]+$/u.test(root) || win32.normalize(root) !== root) {
+    throw integrationBlocked("SystemRoot do observador inválido.");
+  }
+  const env = campaignSpawnEnvironment({});
+  // Block implicit libuv inheritance when a value is absent or its group is omitted by the probe.
+  env.TEMP = "";
+  env.USERPROFILE = "";
+  env.SystemRoot = root;
+  env.WINDIR = root;
+  env.SYSTEMDRIVE = win32.parse(root).root.slice(0, 2);
+  // Resolve fsutil and built-in PowerShell modules without the caller's PATH/PSModulePath.
+  env.PATH = [win32.join(root, "System32"), win32.join(root, "System32/WindowsPowerShell/v1.0")].join(";");
+  const programData = value("ProgramData");
+  if (programData !== undefined) env.ProgramData = programData;
+  for (const group of groups) {
+    for (const name of windowsObserverVariableGroups[group]) {
+      const entry = value(name);
+      if (entry !== undefined) env[name] = entry;
+    }
+  }
+  return env;
+}
+
+function campaignChildEnvironment(): NodeJS.ProcessEnv {
+  const env = { ...process.env };
+  if (process.platform === "win32") {
+    for (const name of windowsSpawnDefaults) {
+      // Empty entries only suppress implicit inheritance; named Windows values use the shared allowlist.
+      if (env[name] === "") delete env[name];
+    }
+  }
+  return env;
+}
+
+function sendToSupervisor(message: object): Promise<void> {
+  return new Promise((resolve, reject) => {
+    if (!process.send || !process.connected) {
+      reject(integrationBlocked("Supervisor indisponível."));
+      return;
+    }
+    process.send(message, (error: Error | null) => error ? reject(integrationBlocked("Canal indisponível.")) : resolve());
+  });
+}
+
+/** Call before importing a migrated suite or constructing any write-capable resources. */
+export async function runAsCampaignChild(
+  suiteId: string,
+  expected: CampaignIdentity,
+  run: (permit: CampaignPermit) => Promise<Tally>,
+  trace?: (event: 'ipc-ready' | 'ipc-started' | 'worker-exit') => void,
+) {
+  if (!process.send || !process.connected) throw integrationBlocked("Execução direta sem supervisor.");
+  const { suite: expectedSuite } = validateIntegrationEnvironment(suiteId, campaignChildEnvironment());
+  const { campaignId, referenceSha256 } = expected;
+  if (!/^[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$/u.test(campaignId)
+      || !/^[a-f0-9]{64}$/u.test(referenceSha256)) throw integrationBlocked("Contexto de campanha inválido.");
+  const destination = campaignDestination();
+  const challenge = randomUUID();
+  const disconnected = () => process.exit(2);
+  process.once("disconnect", disconnected);
+  let onPermit: ((message: unknown) => void) | undefined;
+
+  try {
+    const permit = await within(async () => {
+      const message = new Promise<CampaignPermit>((resolve, reject) => {
+        onPermit = (value: unknown) => {
+          if (!value || typeof value !== "object" || Array.isArray(value)
+              || !("type" in value) || value.type !== "permit"
+              || !("challenge" in value) || value.challenge !== challenge
+              || !("suite" in value) || value.suite !== expectedSuite.id
+              || !("profile" in value) || value.profile !== expectedSuite.profile
+              || !("destination" in value) || value.destination !== destination
+              || !("campaignId" in value) || value.campaignId !== campaignId
+              || !("referenceSha256" in value) || value.referenceSha256 !== referenceSha256) {
+            reject(integrationBlocked("Permissão de campanha inválida."));
+            return;
+          }
+          resolve(Object.freeze({ campaignId, suite: expectedSuite.id, profile: expectedSuite.profile, destination, referenceSha256 }));
+        };
+        process.once("message", onPermit);
+      });
+      trace?.('ipc-ready');
+      await Promise.all([sendToSupervisor({ type: "ready", challenge }), message]);
+      return message;
+    // Supervisor persists running through two 30s Windows observers BEFORE sending permission.
+    // A 10s child timeout could expire during that required persistence. Still bounded, no SQL yet.
+    }, 120_000);
+
+    if (!process.connected) throw integrationBlocked("Supervisor indisponível.");
+    await sendToSupervisor({ type: "started", challenge });
+    trace?.('ipc-started');
+    if (!process.connected) throw integrationBlocked("Supervisor indisponível.");
+    const tally = await run(permit);
+    if (!validTally(tally)) throw integrationBlocked("Resultado do runner inválido.");
+    await sendToSupervisor({ type: "result", challenge, tally });
+    return tally.failed || tally.cancelled ? 1 : 0;
+  } finally {
+    trace?.('worker-exit');
+    if (onPermit) process.off("message", onPermit);
+    process.off("disconnect", disconnected);
+    if (process.connected) process.disconnect?.();
+  }
+}
diff --git a/backend/test/infrastructure/campaign-deadline.ts b/backend/test/infrastructure/campaign-deadline.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2a16e5db6b056796fa6da76f02804e60fd09c1d8
--- /dev/null
+++ b/backend/test/infrastructure/campaign-deadline.ts
@@ -0,0 +1,29 @@
+import { integrationBlocked } from "./integration-environment";
+
+export class CampaignTimeout extends Error {
+  constructor() {
+    super("[SEGURANÇA BLOQUEADA] Prazo da operação excedido.");
+  }
+}
+
+export async function within<T>(work: () => Promise<T>, ms: number, signal?: AbortSignal): Promise<T> {
+  if (signal?.aborted) throw integrationBlocked("Operação interrompida.");
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  let cancel: (() => void) | undefined;
+  try {
+    return await Promise.race([
+      new Promise<never>((_, reject) => {
+        timer = setTimeout(() => reject(new CampaignTimeout()), ms);
+        cancel = () => reject(integrationBlocked("Operação interrompida."));
+        signal?.addEventListener("abort", cancel, { once: true });
+      }),
+      Promise.resolve().then(() => {
+        if (signal?.aborted) throw integrationBlocked("Operação interrompida.");
+        return work();
+      }),
+    ]);
+  } finally {
+    clearTimeout(timer);
+    if (cancel) signal?.removeEventListener("abort", cancel);
+  }
+}
diff --git a/backend/test/infrastructure/campaign-journal.ts b/backend/test/infrastructure/campaign-journal.ts
new file mode 100644
index 0000000000000000000000000000000000000000..0fd60bbf91766c8528ce306e66fdd7ab456c8120
--- /dev/null
+++ b/backend/test/infrastructure/campaign-journal.ts
@@ -0,0 +1,239 @@
+import { randomUUID } from "node:crypto";
+import { lstat, mkdir, open, readdir, readFile, rename, rmdir, unlink, writeFile } from "node:fs/promises";
+import { homedir } from "node:os";
+import { isAbsolute, join } from "node:path";
+import { integrationBlocked, integrationDestination } from "./integration-environment";
+import type { CampaignFailure } from './integration-environment';
+
+export type Tally = Readonly<{ passed: number; failed: number; skipped: number; cancelled: number }>;
+export type RunnerEvidence = Readonly<{ exitCode: number; tally: Tally }>;
+type Verdict = "pending" | "passed" | "failed";
+type Phase = "preparing" | "authorized" | "running" | "verifying" | "clean" | "test-failure" | "inconsistent" | "interrupted";
+type Diagnosis = "preflight" | "launch" | "supervision" | "timeout" | "baseline" | "resources"
+  | "lock-lost" | "persistence" | "session-close" | "cancelled";
+export type CampaignEvidence = {
+  id: string;
+  destination: string;
+  referenceSha256: string;
+  node: string;
+  revision: { branch: string; commit: string };
+  supervisor: { instance: string; pid: number };
+  suites: readonly string[];
+  beganAt: string;
+  endedAt?: string;
+  durationMs?: number;
+  phase: Phase;
+  preflight: Verdict;
+  lock: "acquired" | "lost" | "closed" | "uncertain";
+  postflight: Verdict;
+  resources: Verdict;
+  recoveryPending: boolean;
+  diagnosis?: Diagnosis;
+  failure?: CampaignFailure;
+  cleanupFailures?: CampaignFailure[];
+  terminalPersistence?: 'passed' | 'failed';
+  attempts: {
+    suite: string;
+    pid?: number;
+    state: "not-started" | "launched" | "authorized" | "reported";
+    launchedAt?: string;
+    endedAt?: string;
+    result?: RunnerEvidence;
+  }[];
+};
+
+export function campaignDestination() {
+  const { address, port, database, role } = integrationDestination;
+  return address + ":" + port + "/" + database + " (" + role + ")";
+}
+
+export function defaultCampaignStateDirectory() {
+  // Same account and endpoint use one namespace across checkouts. Future real deployment must
+  // provision one protected, shared namespace for all authorized operators of this destination.
+  const { address, port, database } = integrationDestination;
+  return join(homedir(), ".arenago", "integration", address + "-" + port + "-" + database);
+}
+
+export interface CampaignJournal {
+  claim(record: CampaignEvidence): Promise<{
+    save(next: CampaignEvidence): Promise<void>;
+    finish(): Promise<void>;
+  }>;
+}
+
+const transitions: Record<Phase, readonly Phase[]> = {
+  preparing: ["preparing", "authorized", "inconsistent", "interrupted"],
+  authorized: ["running", "inconsistent", "interrupted"],
+  running: ["running", "verifying", "inconsistent", "interrupted"],
+  verifying: ["verifying", "preparing", "clean", "test-failure", "inconsistent", "interrupted"],
+  clean: ["inconsistent", "interrupted"],
+  "test-failure": ["inconsistent", "interrupted"],
+  inconsistent: ["inconsistent"],
+  interrupted: ["interrupted", "inconsistent"],
+};
+
+const uuid = /^[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$/u;
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return !!value && typeof value === "object" && !Array.isArray(value);
+}
+
+function matches(value: unknown, pattern: RegExp) {
+  return typeof value === "string" && pattern.test(value);
+}
+
+function isInteger(value: unknown, min: number, max = Number.MAX_SAFE_INTEGER): value is number {
+  return typeof value === "number" && Number.isSafeInteger(value) && value >= min && value <= max;
+}
+
+export function validTally(value: unknown): value is Tally {
+  if (!isRecord(value) || Object.keys(value).length !== 4
+      || !["passed", "failed", "skipped", "cancelled"].every(key => Object.hasOwn(value, key))) return false;
+  const { passed, failed, skipped, cancelled } = value;
+  return isInteger(passed, 0, 1_000_000) && isInteger(failed, 0, 1_000_000)
+    && isInteger(skipped, 0, 1_000_000) && isInteger(cancelled, 0, 1_000_000)
+    && passed + failed + skipped + cancelled > 0;
+}
+
+function isTimestamp(value: unknown) {
+  if (typeof value !== "string") return false;
+  const date = new Date(value);
+  return Number.isFinite(date.getTime()) && date.toISOString() === value;
+}
+
+function terminalEvidence(record: unknown, id: string): boolean {
+  if (!isRecord(record) || record.id !== id || !uuid.test(id) || record.destination !== campaignDestination()
+      || (record.phase !== "clean" && record.phase !== "test-failure") || record.recoveryPending !== false
+      || record.lock !== "closed" || record.preflight !== "passed" || record.postflight !== "passed"
+      || record.resources !== "passed" || record.diagnosis !== undefined
+      || !matches(record.referenceSha256, /^[a-f0-9]{64}$/u) || !matches(record.node, /^v\d+\.\d+\.\d+(?:[-+][\w.+-]+)?$/u)
+      || !isRecord(record.revision) || !matches(record.revision.commit, /^[a-f0-9]{40}$/u)
+      || !matches(record.revision.branch, /^[a-zA-Z0-9._/-]{1,180}$/u)
+      || !isRecord(record.supervisor) || !matches(record.supervisor.instance, uuid) || !isInteger(record.supervisor.pid, 1)
+      || !isTimestamp(record.beganAt) || !isTimestamp(record.endedAt) || !isInteger(record.durationMs, 0)
+      || !Array.isArray(record.suites) || !record.suites.length || new Set(record.suites).size !== record.suites.length
+      || !Array.isArray(record.attempts) || record.attempts.length !== record.suites.length) return false;
+
+  let failed = false;
+  for (let index = 0; index < record.suites.length; index++) {
+    const suite: unknown = record.suites[index];
+    const attempt: unknown = record.attempts[index];
+    if (!matches(suite, /^[a-z0-9-]+$/u) || !isRecord(attempt) || attempt.suite !== suite) return false;
+    if (failed) {
+      if (attempt.state !== "not-started" || Object.keys(attempt).length !== 2) return false;
+      continue;
+    }
+    if (attempt.state !== "reported" || !isInteger(attempt.pid, 1) || !isTimestamp(attempt.launchedAt)
+        || !isTimestamp(attempt.endedAt) || !isRecord(attempt.result) || !validTally(attempt.result.tally)) return false;
+    const { passed, failed: failures, cancelled } = attempt.result.tally;
+    if (cancelled !== 0 || (failures === 0 && passed === 0)
+        || attempt.result.exitCode !== (failures ? 1 : 0)) return false;
+    failed = failures > 0;
+  }
+  return record.phase === (failed ? "test-failure" : "clean");
+}
+
+async function readTerminalRecord(path: string, id: string) {
+  if (!(await lstat(path)).isFile()) return false;
+  const record: unknown = JSON.parse(await readFile(path, "utf8"));
+  return terminalEvidence(record, id);
+}
+
+/** Only the claiming process can update a journal via this handle. No automatic takeover. */
+export function fileCampaignJournal(directory: string): CampaignJournal {
+  if (!isAbsolute(directory)) throw integrationBlocked("Diretório operacional inválido.");
+  return {
+    async claim(record) {
+      const marker = join(directory, "occupied");
+      const owner = join(marker, "owner");
+      const records = join(directory, "campaigns");
+      const { id } = record;
+      if (record.phase !== "preparing" || !record.recoveryPending || !uuid.test(id)
+          || record.destination !== campaignDestination()) {
+        throw integrationBlocked("Estado inicial da campanha inválido.");
+      }
+      try {
+        await mkdir(directory, { recursive: true, mode: 0o700 });
+        await mkdir(marker, { mode: 0o700 });
+      } catch {
+        throw integrationBlocked("Ambiente ocupado, com recuperação pendente ou sem registro operacional.");
+      }
+
+      const ownership = id + ":" + randomUUID();
+      async function verifyOwner() {
+        if (!(await lstat(marker)).isDirectory() || !(await lstat(owner)).isFile()
+            || await readFile(owner, "utf8") !== ownership) throw new Error();
+      }
+      // Claim before inspecting history. Any uncertain admission retains the marker.
+      try {
+        await writeFile(owner, ownership, { flag: "wx", mode: 0o600 });
+        await mkdir(records, { recursive: true, mode: 0o700 });
+        if (!(await lstat(records)).isDirectory()) throw new Error();
+        for (const entry of await readdir(records, { withFileTypes: true })) {
+          const previousId = entry.name.slice(0, -5);
+          if (!entry.isFile() || !entry.name.endsWith(".json") || !uuid.test(previousId) || previousId === id
+              || !await readTerminalRecord(join(records, entry.name), previousId)) throw new Error();
+        }
+      } catch {
+        throw integrationBlocked("Histórico da campanha inválido, indisponível ou com recuperação pendente.");
+      }
+
+      const path = join(records, id + ".json");
+      let phase: Phase = "preparing";
+      let releasable = false;
+      let busy = false;
+      let finished = false;
+      async function save(next: CampaignEvidence) {
+        if (finished || busy || id !== next.id || next.destination !== record.destination
+            || !transitions[phase].includes(next.phase)) {
+          throw integrationBlocked("Transição inválida do registro de campanha.");
+        }
+        const terminal = next.phase === "clean" || next.phase === "test-failure";
+        if (terminal && !terminalEvidence(next, id)) throw integrationBlocked("Conclusão da campanha sem evidência suficiente.");
+        busy = true;
+        const temp = join(records, id + "." + randomUUID() + ".tmp");
+        let created = false;
+        try {
+          await verifyOwner();
+          const file = await open(temp, "wx", 0o600);
+          created = true;
+          try {
+            await file.writeFile(JSON.stringify(next));
+            await file.sync();
+          } finally {
+            await file.close();
+          }
+          await rename(temp, path);
+          phase = next.phase;
+          releasable = terminal;
+        } catch {
+          releasable = false;
+          throw integrationBlocked("Falha ao persistir o registro da campanha.");
+        } finally {
+          if (created) await unlink(temp).catch(() => undefined);
+          busy = false;
+        }
+      }
+
+      await save(record);
+      return {
+        save,
+        async finish() {
+          if (finished || busy || !releasable) throw integrationBlocked("Recuperação pendente.");
+          busy = true;
+          try {
+            await verifyOwner();
+            if (!await readTerminalRecord(path, id)) throw new Error();
+            await unlink(owner);
+            await rmdir(marker);
+            finished = true;
+          } catch {
+            throw integrationBlocked("Marcador de recuperação não liberado.");
+          } finally {
+            busy = false;
+          }
+        },
+      };
+    },
+  };
+}
diff --git a/backend/test/infrastructure/campaign-lock.ts b/backend/test/infrastructure/campaign-lock.ts
new file mode 100644
index 0000000000000000000000000000000000000000..286b994413fd55216ce5bcdd9c11b65ed0de1118
--- /dev/null
+++ b/backend/test/infrastructure/campaign-lock.ts
@@ -0,0 +1,79 @@
+import { attestIntegrationIdentity, type IntegrationPreflightClient } from "./integration-db-guard";
+import { within } from "./campaign-deadline";
+import { integrationBlocked, campaignStep, campaignFailure, CampaignDiagnosticError } from "./integration-environment";
+
+export interface CampaignLockConnection extends Pick<IntegrationPreflightClient, "query"> {
+  /** Dedicated session. close() must destroy it and reject if closure cannot be confirmed. */
+  close(): Promise<void>;
+  onDisconnect(listener: () => void): () => void;
+}
+
+// Reserved namespace ARGI, identifier INFR. Distinct from the application lock classes.
+const lockSql = "SELECT pg_catalog.pg_try_advisory_lock(1095911241, 1229866578) AS acquired";
+const ownsSql = `SELECT EXISTS (
+  SELECT 1 FROM pg_catalog.pg_locks
+  WHERE locktype = 'advisory' AND pid = pg_catalog.pg_backend_pid()
+    AND database = (SELECT oid FROM pg_catalog.pg_database WHERE datname = pg_catalog.current_database())
+    AND classid = 1095911241::oid AND objid = 1229866578::oid AND objsubid = 2
+    AND mode = 'ExclusiveLock' AND granted
+) AS owned`;
+
+export async function acquireCampaignLock(
+  connection: CampaignLockConnection,
+  postgresVersionNum: number,
+  { timeout = 2_000, heartbeat = 1_000 } = {},
+) {
+  const loss = new AbortController();
+  let closed = false;
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  let pending: Promise<void> | undefined;
+  let unsubscribe: (() => void) | undefined;
+  async function close() {
+    if (closed) throw integrationBlocked("Sessão supervisora já encerrada.");
+    closed = true;
+    clearTimeout(timer);
+    try {
+      // Closing the dedicated PostgreSQL session releases its session locks.
+      await within(() => connection.close(), timeout);
+    } catch {
+      throw integrationBlocked("Encerramento da sessão supervisora não confirmado.");
+    } finally {
+      // The closed flag disables callbacks even if the adapter cannot unsubscribe.
+      try { unsubscribe?.(); } catch { /* The connection has already been closed or discarded. */ }
+    }
+  }
+  try {
+    unsubscribe = connection.onDisconnect(() => { if (!closed) loss.abort(); });
+    await within(() => campaignStep('sql-identity', () => attestIntegrationIdentity(connection, postgresVersionNum)), timeout, loss.signal);
+    const { rows } = await within(() => connection.query(lockSql), timeout, loss.signal);
+    if (rows.length !== 1 || rows[0].acquired !== true) throw integrationBlocked("Lock da campanha indisponível.");
+  } catch (error) {
+    // A timed-out acquisition could still have succeeded at the server. Discard the session.
+    await close();
+    if (error instanceof Error && error.message === "[SEGURANÇA BLOQUEADA] Lock da campanha indisponível.") throw error;
+    const failure = new CampaignDiagnosticError(campaignFailure('lock-acquisition', error));
+    failure.message = '[SEGURANÇA BLOQUEADA] Identidade ou aquisição do lock não confirmada.';
+    throw failure;
+  }
+
+  function verify(): Promise<void> {
+    if (closed || loss.signal.aborted) return Promise.reject(integrationBlocked("Lock da campanha perdido."));
+    if (pending) return pending;
+    pending = within(async () => {
+      const { rows } = await connection.query(ownsSql);
+      if (rows.length !== 1 || rows[0].owned !== true) throw new Error();
+    }, timeout, loss.signal).catch(() => {
+      loss.abort();
+      throw integrationBlocked("Lock da campanha perdido.");
+    }).finally(() => { pending = undefined; });
+    return pending;
+  }
+
+  function schedule() {
+    if (closed || loss.signal.aborted) return;
+    timer = setTimeout(() => { void verify().then(schedule, () => undefined); }, heartbeat);
+  }
+
+  schedule();
+  return { verify, close, lost: loss.signal };
+}
diff --git a/backend/test/infrastructure/campaign-orchestrator.ts b/backend/test/infrastructure/campaign-orchestrator.ts
new file mode 100644
index 0000000000000000000000000000000000000000..6c42a42e6fe7bb921052a7359d16fcf8fe4d2523
--- /dev/null
+++ b/backend/test/infrastructure/campaign-orchestrator.ts
@@ -0,0 +1,261 @@
+import { randomUUID } from "node:crypto";
+import { acquireCampaignLock, type CampaignLockConnection } from "./campaign-lock";
+import { CampaignTimeout, within } from "./campaign-deadline";
+import { campaignDestination, validTally, type CampaignEvidence, type CampaignJournal } from "./campaign-journal";
+import type { CampaignChild, LaunchCampaignChild } from "./campaign-process";
+import { loadCampaignReference, type CampaignReferenceAuthority } from "./campaign-reference";
+import { refuseRealCampaign, selectCampaign, type CampaignSelection } from "./campaign-selection";
+import { attestIntegrationDatabase, type IntegrationPreflightPoolFactory } from "./integration-db-guard";
+import { buildIntegrationEnvironment, integrationBlocked, campaignStep, campaignFailure, CampaignDiagnosticError, type CampaignDiagnosticStage } from "./integration-environment";
+
+type SimulationDependencies = {
+  reference: CampaignReferenceAuthority;
+  openLockConnection(environment: NodeJS.ProcessEnv): Promise<CampaignLockConnection>;
+  createReadPool: IntegrationPreflightPoolFactory;
+  journal: CampaignJournal;
+  launch: LaunchCampaignChild;
+  /** Independent proof for descendants, database connections and transactions, even after child exit. */
+  resourcesReleased(record: Readonly<CampaignEvidence>, signal: AbortSignal): Promise<boolean>;
+};
+
+type CampaignRequest = {
+  mode: "simulation" | "real";
+  selection: CampaignSelection;
+  connectionString: string;
+  parentEnvironment: NodeJS.ProcessEnv;
+  revision: CampaignEvidence["revision"];
+  signal?: AbortSignal;
+  timeoutMs?: number;
+  trace?: (event: string, campaignId?: string) => void;
+};
+
+export async function orchestrateCampaign(request: CampaignRequest, dependencies: SimulationDependencies): Promise<CampaignEvidence> {
+  if (request.mode !== "simulation") refuseRealCampaign();
+  return executeCampaign(request, dependencies, "simulation");
+}
+
+/** Real callers must supply the concrete, reviewed Windows adapters. */
+export async function executePilotCampaign(request: CampaignRequest, dependencies: SimulationDependencies): Promise<CampaignEvidence> {
+  try { request.trace?.('execute-pilot-enter'); } catch { /* informational only */ }
+  const ids = "suites" in request.selection ? request.selection.suites
+    : "suite" in request.selection ? [request.selection.suite] : [];
+  if (request.mode !== "real" || !ids.length || new Set(ids).size !== ids.length
+      || ids.some(id => !["admin-external-queue-http", "admin-close-http"].includes(id))) {
+    throw integrationBlocked("Somente D06 e D09 são autorizáveis no piloto.");
+  }
+  return executeCampaign(request, dependencies, "real");
+}
+
+async function executeCampaign(request: CampaignRequest, dependencies: SimulationDependencies, purpose: "real" | "simulation"): Promise<CampaignEvidence> {
+  const trace = (event: string, campaignId?: string) => { try { request.trace?.(event, campaignId); } catch { /* diagnostics cannot authorize or interrupt a campaign */ } };
+  const step = <T>(stage: CampaignDiagnosticStage, work: () => T | Promise<T>): Promise<T> => purpose === 'real' ? campaignStep(stage, work) : Promise.resolve().then(work);
+  const suites = selectCampaign(request.selection);
+  const { commit, branch } = request.revision;
+  if (!/^[a-f0-9]{40}$/u.test(commit) || !/^[a-zA-Z0-9._/-]{1,180}$/u.test(branch)) {
+    throw integrationBlocked("Revisão Git inválida.");
+  }
+  const timeout = request.timeoutMs ?? 60_000;
+  if (!Number.isSafeInteger(timeout) || timeout < 1 || timeout > 3_600_000) throw integrationBlocked("Prazo da campanha inválido.");
+  const envs = await step('configuration', () => suites.map(({ id }) => buildIntegrationEnvironment(id, request.connectionString, request.parentEnvironment)));
+  const reference = await step('reference', () => within(() => loadCampaignReference(dependencies.reference, purpose), purpose === 'real' ? 90_000 : 5_000, request.signal));
+
+  // The adapter must return a new dedicated session. Discard late connections even after a timeout.
+  const opening = new AbortController();
+  const connectSignal = request.signal ? AbortSignal.any([request.signal, opening.signal]) : opening.signal;
+  let lease: Awaited<ReturnType<typeof acquireCampaignLock>>;
+  try {
+    const connection = await within(async () => {
+      const session = await dependencies.openLockConnection({ ...envs[0] });
+      if (connectSignal.aborted) {
+        await session.close();
+        throw integrationBlocked("Abertura interrompida.");
+      }
+      return session;
+      }, purpose === "real" ? 60_000 : 5_000, connectSignal);
+    lease = await step('lock-acquisition', () => acquireCampaignLock(connection, reference.postgresVersionNum));
+  } catch (error) {
+    opening.abort();
+    if (purpose === 'real') throw new CampaignDiagnosticError(campaignFailure('connection', error));
+    throw integrationBlocked("Exclusividade da campanha não confirmada.");
+  }
+
+  const signal = request.signal ? AbortSignal.any([request.signal, lease.lost]) : lease.lost;
+  const started = performance.now();
+  const record: CampaignEvidence = {
+    id: randomUUID(), supervisor: { instance: randomUUID(), pid: process.pid },
+    destination: campaignDestination(), referenceSha256: reference.sha256, node: process.version,
+    revision: { commit, branch }, suites: suites.map(suite => suite.id), beganAt: new Date().toISOString(),
+    attempts: suites.map(({ id }) => ({ suite: id, state: "not-started" })),
+    phase: "preparing", preflight: "pending", lock: "acquired", postflight: "pending",
+    resources: "pending", recoveryPending: true,
+  };
+  trace('campaign-created', record.id);
+  let handle: Awaited<ReturnType<CampaignJournal["claim"]>> | undefined;
+  let active: CampaignChild | undefined;
+  let leaseClosed = false;
+  let diagnosis: CampaignEvidence["diagnosis"] = "persistence";
+  let resultPhase: "clean" | "test-failure" = "clean";
+
+  function stamp() {
+    record.endedAt = new Date().toISOString();
+    record.durationMs = Math.round(performance.now() - started);
+  }
+  async function save(phase: CampaignEvidence["phase"]) {
+    record.phase = phase;
+    await step('journal-save', () => handle!.save(structuredClone(record)));
+  }
+  async function ensureLease() {
+    if (signal.aborted) throw integrationBlocked("Campanha interrompida.");
+    await step('lock-verification', () => lease.verify());
+    if (signal.aborted) throw integrationBlocked("Campanha interrompida.");
+  }
+  async function attest(index: number) {
+    await ensureLease();
+    await step(record.phase === 'verifying' ? 'postflight' : 'preflight', () => within(() => attestIntegrationDatabase(suites[index].id, envs[index],
+      dependencies.createReadPool, reference.reference), purpose === "real" ? 90_000 : 30_000, signal));
+    await ensureLease();
+  }
+
+  try {
+    await ensureLease();
+    trace('journal-claim-start', record.id);
+    handle = await step('journal-admission', () => dependencies.journal.claim(structuredClone(record)));
+    trace('journal-claim-passed', record.id);
+    for (const [index, suite] of suites.entries()) {
+      if (index > 0) {
+        record.preflight = record.postflight = record.resources = "pending";
+        diagnosis = "persistence";
+        await save("preparing");
+      }
+      diagnosis = "preflight";
+      await attest(index);
+      record.preflight = "passed";
+      diagnosis = "persistence";
+      await save("authorized");
+      await ensureLease();
+
+      const attempt = record.attempts[index];
+      diagnosis = "launch";
+      active = await step('worker-launch', () => dependencies.launch(suite.id, { ...envs[index] }, {
+        campaignId: record.id, referenceSha256: reference.sha256,
+      }));
+      trace('worker-launched', record.id);
+      const child = active;
+      void child.result.catch(() => undefined);
+      if (child.pid === undefined || !Number.isSafeInteger(child.pid) || child.pid <= 0) throw new Error();
+      attempt.pid = child.pid;
+      attempt.state = "launched";
+      attempt.launchedAt = new Date().toISOString();
+      diagnosis = "persistence";
+      await save("running");
+      trace('running-saved', record.id);
+
+      diagnosis = "supervision";
+      await ensureLease();
+      const attemptControl = new AbortController();
+      const attemptSignal = AbortSignal.any([signal, attemptControl.signal]);
+      const result = await within(async () => {
+        await step('ipc-authorize', () => child.authorize({
+          campaignId: record.id, suite: suite.id, profile: suite.profile,
+          referenceSha256: record.referenceSha256, destination: record.destination,
+        }, attemptSignal, ensureLease));
+        trace('ipc-authorized', record.id);
+        if (!attemptSignal.aborted) attempt.state = "authorized";
+        return child.result;
+      }, timeout, attemptSignal).finally(() => attemptControl.abort());
+      const { exitCode, tally } = result;
+      trace('worker-result', record.id);
+      await step('reconciliation', () => {
+      if (!validTally(tally) || exitCode !== (tally.failed || tally.cancelled ? 1 : 0)) throw new Error();
+      const { passed, failed, skipped, cancelled } = tally;
+      if (purpose === "real" && (passed + failed + skipped + cancelled !== suite.cases || skipped || cancelled)) {
+        throw integrationBlocked("Execução parcial ou contagem divergente do piloto.");
+      }
+      });
+      const { passed, failed, skipped, cancelled } = tally;
+      attempt.result = { exitCode, tally: { passed, failed, skipped, cancelled } };
+      attempt.state = "reported";
+      attempt.endedAt = new Date().toISOString();
+      active = undefined;
+      if (cancelled > 0 || (exitCode === 0 && passed === 0)) throw new Error();
+      diagnosis = "persistence";
+      await save("verifying");
+
+      diagnosis = "resources";
+      await ensureLease();
+      await step('resources', async () => {
+        if (await within(() => dependencies.resourcesReleased(structuredClone(record), signal), purpose === "real" ? 90_000 : 5_000, signal) !== true) throw new Error();
+      });
+      record.resources = "passed";
+      diagnosis = "baseline";
+      await attest(index);
+      record.postflight = "passed";
+      if (exitCode !== 0) {
+        resultPhase = "test-failure";
+        break;
+      }
+    }
+
+    // Preserve the result of the postflight while the lock is still held. The durable marker
+    // survives until the dedicated session is closed and the final record is committed.
+    diagnosis = "persistence";
+    await save("verifying");
+    await ensureLease();
+    diagnosis = "session-close";
+    await step('lock-close', () => lease.close());
+    leaseClosed = true;
+    record.lock = "closed";
+    if (signal.aborted) throw new Error();
+    diagnosis = "persistence";
+    record.recoveryPending = false;
+    stamp();
+    await save(resultPhase);
+    const finishingHandle = handle;
+    if (!finishingHandle) throw integrationBlocked('Handle de finalização do journal ausente.');
+    await step('journal-finish', () => finishingHandle.finish());
+    trace('journal-finished', record.id);
+    return record;
+  } catch (error) {
+    trace('campaign-catch', record.id);
+    const reason = lease.lost.aborted ? "lock-lost" : request.signal?.aborted ? "cancelled"
+      : error instanceof CampaignTimeout && diagnosis === "supervision" ? "timeout" : diagnosis;
+    record.recoveryPending = true;
+    record.failure = campaignFailure('campaign', error);
+    record.cleanupFailures = [];
+    record.diagnosis = reason;
+    if (reason === "preflight") record.preflight = "failed";
+    if (reason === "baseline") record.postflight = "failed";
+    if (reason === "resources") record.resources = "failed";
+    if (lease.lost.aborted) record.lock = "lost";
+    if (reason === "session-close") record.lock = "uncertain";
+
+    if (active) await within(() => active!.stop(), 3_000).catch(error => {
+      record.resources = "failed"; record.cleanupFailures!.push(campaignFailure('worker-stop', error));
+    });
+    stamp();
+    const phase = reason === "baseline" || reason === "preflight" || reason === "resources" ? "inconsistent" : "interrupted";
+    record.phase = phase;
+    async function persistFailure() {
+      if (!handle) return;
+      trace('terminal-save-start', record.id);
+      try { record.terminalPersistence = 'passed'; await save(phase); trace('terminal-save-passed', record.id); }
+      catch (error) { trace('terminal-save-failed', record.id); record.terminalPersistence = 'failed'; record.cleanupFailures!.push(campaignFailure('journal-save', error)); }
+    }
+    await persistFailure();
+    if (!leaseClosed && reason !== "session-close") {
+      try {
+        await lease.close();
+        if (record.lock === "acquired") record.lock = "closed";
+      } catch (error) {
+        record.lock = "uncertain";
+        record.cleanupFailures!.push(campaignFailure('lock-close', error));
+      }
+      await persistFailure();
+    }
+    if (!handle) {
+      if (purpose === 'real') throw new CampaignDiagnosticError(record.failure!);
+      throw integrationBlocked("Ambiente ocupado ou sem registro operacional confirmado.");
+    }
+    return record;
+  }
+}
diff --git a/backend/test/infrastructure/campaign-process.ts b/backend/test/infrastructure/campaign-process.ts
