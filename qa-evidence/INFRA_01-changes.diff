+function execute(file, args, options) {
+  return new Promise(resolveResult => {
+    let spawned = false;
+    try {
+      const child = execFile(file, args, options, (error, stdout, stderr) =>
+        resolveResult({ error, stdout, metadata: errorMetadata(error, spawned, stderr) }));
