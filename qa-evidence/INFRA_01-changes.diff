+import { runAsCampaignChild } from "./campaign-child-protocol";
+
+// Fixed worker for testing IPC with an inert process. It cannot load application or suite code.
+if (require.main === module) {
+  const [, , suite, campaignId, referenceSha256] = process.argv;
+  void runAsCampaignChild(suite, { campaignId, referenceSha256 }, async () => {
+    if (process.env.NODE_OPTIONS || process.env.PGHOST || process.env.RESEND_API_KEY
+        || process.env.NODE_V8_COVERAGE || process.env.DOTENV_CONFIG_OVERRIDE
+        || process.env.EVENT_CLOSURE_JOB_TEST_ENABLED !== "false"
+        || process.cwd().toLowerCase() !== __dirname.replace(/[\\/]test[\\/]infrastructure$/iu, "").toLowerCase()
+        || process.argv.length !== 5) throw new Error();
+    return { passed: 1, failed: 0, skipped: 0, cancelled: 0 };
+  }).then(code => { process.exitCode = code; }, () => { process.exitCode = 2; });
+}
diff --git a/backend/test/infrastructure/inspect-pilot-domain.ps1 b/backend/test/infrastructure/inspect-pilot-domain.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..80eddf651d3fe6d160c68f238660f931d6e9dcec
--- /dev/null
+++ b/backend/test/infrastructure/inspect-pilot-domain.ps1
@@ -0,0 +1,135 @@
+[CmdletBinding()]
+param([Parameter(Mandatory)][string]$Directory, [Parameter(Mandatory)][string]$Authority)
+$ErrorActionPreference = 'Stop'
+function ConvertFrom-JournalFileId([byte[]]$Bytes) {
+    if ($null -eq $Bytes -or $Bytes.Length -ne 16 -or ![BitConverter]::IsLittleEndian) { throw 'FileId layout' }
+    # fsutil displays the 128-bit integer most-significant byte first, not a GUID.
+    $copy = [byte[]]$Bytes.Clone()
+    [Array]::Reverse($copy)
+    return '0x' + [BitConverter]::ToString($copy).Replace('-','').ToLowerInvariant()
+}
+function Get-JournalNativeFileId([string]$Path) {
+    if (-not ('ArenaGO.JournalFileQuery' -as [type])) {
+        $assembly = [AppDomain]::CurrentDomain.DefineDynamicAssembly(
+            [Reflection.AssemblyName]::new('ArenaGO.JournalFileQuery'),[Reflection.Emit.AssemblyBuilderAccess]::Run)
+        $module = $assembly.DefineDynamicModule('JournalFileQuery')
+        $builder = $module.DefineType('ArenaGO.JournalFileQuery',[Reflection.TypeAttributes]'Public,Abstract,Sealed')
+        $methods = @(
+            @{ Name='CreateFileW'; Return=[IntPtr]; Parameters=[type[]]@([string],[uint32],[uint32],[IntPtr],[uint32],[uint32],[IntPtr]) },
+            @{ Name='GetFileInformationByHandleEx'; Return=[int]; Parameters=[type[]]@([IntPtr],[int],[IntPtr],[uint32]) },
+            @{ Name='CloseHandle'; Return=[int]; Parameters=[type[]]@([IntPtr]) }
+        )
+        foreach ($method in $methods) {
+            $native = $builder.DefinePInvokeMethod($method.Name,'kernel32.dll',[Reflection.MethodAttributes]'Public,Static,PinvokeImpl',
+                [Reflection.CallingConventions]::Standard,$method.Return,$method.Parameters,
+                [Runtime.InteropServices.CallingConvention]::Winapi,[Runtime.InteropServices.CharSet]::Unicode)
+            $native.SetImplementationFlags([Reflection.MethodImplAttributes]::PreserveSig)
+        }
+        $null = $builder.CreateType()
+    }
+    # FILE_READ_ATTRIBUTES only; share read/write/delete; OPEN_EXISTING;
+    # BACKUP_SEMANTICS opens a directory, OPEN_REPARSE_POINT prevents following its final entry.
+    $handle = [ArenaGO.JournalFileQuery]::CreateFileW($Path,0x80,7,[IntPtr]::Zero,3,0x02200000,[IntPtr]::Zero)
+    if ($handle -eq [IntPtr]::Zero -or $handle -eq [IntPtr]::new(-1)) { throw 'Directory handle inconclusive' }
+    $buffer = [IntPtr]::Zero
+    try {
+        $buffer = [Runtime.InteropServices.Marshal]::AllocHGlobal(24)
+        # FileAttributeTagInfo=9: verify directory and reject reparse on the opened object itself.
+        if ([ArenaGO.JournalFileQuery]::GetFileInformationByHandleEx($handle,9,$buffer,8) -eq 0) { throw 'Directory attributes inconclusive' }
+        $attributes = [Runtime.InteropServices.Marshal]::ReadInt32($buffer)
+        if (!($attributes -band 0x10) -or ($attributes -band 0x400)) { throw 'Directory redirected or absent' }
+        # FileIdInfo=18: ULONGLONG VolumeSerialNumber followed by 16 opaque FILE_ID_128 bytes.
+        if ([ArenaGO.JournalFileQuery]::GetFileInformationByHandleEx($handle,18,$buffer,24) -eq 0) { throw 'Native FileId inconclusive' }
+        $bytes = New-Object byte[] 16
+        [Runtime.InteropServices.Marshal]::Copy([IntPtr]::Add($buffer,8),$bytes,0,16)
+        return ConvertFrom-JournalFileId $bytes
+    } finally {
+        if ($buffer -ne [IntPtr]::Zero) { [Runtime.InteropServices.Marshal]::FreeHGlobal($buffer) }
+        if ([ArenaGO.JournalFileQuery]::CloseHandle($handle) -eq 0) { throw 'Directory handle closure inconclusive' }
+    }
+}
+$script:domainStage = 'identity'
+$script:domainArea = 'journal'
+try {
+    $sid = [Security.Principal.WindowsIdentity]::GetCurrent().User
+    $principal = [Security.Principal.WindowsPrincipal]::new([Security.Principal.WindowsIdentity]::GetCurrent())
+    $script:domainStage = 'elevation'
+    if ($principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) { throw 'Elevated' }
+    $expected = Join-Path $env:ProgramData 'ArenaGO\integration\127.0.0.1-55432-arenago_events_test'
+    $trustedInstallerSid = 'S-1-5-80-956008885-3418522649-1831038044-1853292631-2271478464'
+    $systemVolumeRoot = [IO.Path]::GetPathRoot($env:SystemRoot)
+    $script:domainStage = 'arguments'
+    if ($Directory -cne $expected -or $Authority -cne (Join-Path $env:ProgramData 'ArenaGO\integration-authority')) { throw 'Path' }
+    function Inspect-Path([string]$Path, [bool]$Writable) {
+        $script:domainStage = 'path'
+        $item = Get-Item -LiteralPath $Path -Force
+        $script:domainStage = 'volume'
+        $drive = [IO.DriveInfo]::new([IO.Path]::GetPathRoot($item.FullName))
+        if ($drive.DriveType -ne 'Fixed' -or $drive.DriveFormat -ne 'NTFS') { throw 'Volume' }
+        $current = $item
+        while ($null -ne $current) {
+            $script:domainStage = 'reparse'
+            if ($current.Attributes -band [IO.FileAttributes]::ReparsePoint) { throw 'Reparse' }
+            $script:domainStage = 'acl-read'
+            $acl = Get-Acl -LiteralPath $current.FullName
+            $owner = $acl.GetOwner([Security.Principal.SecurityIdentifier]).Value
+            # TrustedInstaller is admitted only on the system volume root as an ancestor,
+            # never on the authority, journal, records or their application parents.
+            $systemAncestor = $current.FullName -ieq $systemVolumeRoot -and $current.FullName -ine $item.FullName
+            $script:domainStage = 'owner'
+            if ($owner -notin @('S-1-5-18','S-1-5-32-544') -and !($Writable -and $owner -eq $sid.Value) -and
+                !($systemAncestor -and $owner -eq $trustedInstallerSid)) { throw 'Owner' }
+            $mask = if ($current.FullName -eq $item.FullName) {
+                [Security.AccessControl.FileSystemRights]'Write,Delete,DeleteSubdirectoriesAndFiles,ChangePermissions,TakeOwnership'
+            } else { [Security.AccessControl.FileSystemRights]'Delete,DeleteSubdirectoriesAndFiles,ChangePermissions,TakeOwnership' }
+            $script:domainStage = 'rights'
+            foreach ($ace in $acl.GetAccessRules($true,$true,[Security.Principal.SecurityIdentifier])) {
+                if ($ace.AccessControlType -eq 'Allow' -and !($ace.PropagationFlags -band [Security.AccessControl.PropagationFlags]::InheritOnly) -and
+                    ($ace.FileSystemRights -band $mask) -and
+                    $ace.IdentityReference.Value -notin @('S-1-5-18','S-1-5-32-544') -and
+                    !($Writable -and $ace.IdentityReference.Value -eq $sid.Value)) { throw 'Acl' }
+            }
+            $current = if ($current -is [IO.FileInfo]) { $current.Directory } else { $current.Parent }
+        }
+        $script:domainStage = 'inheritance'
+        if ($Path -in @($Directory,$Authority) -and !(Get-Acl -LiteralPath $Path).AreAccessRulesProtected) { throw 'Inheritance' }
+    }
+    $script:domainArea = 'authority'
+    Inspect-Path $Authority $false
+    foreach ($name in @('reference-v2.json','reference-v2.approval.json','pilot-domain.json')) {
+        $script:domainArea = @{ 'reference-v2.json'='reference'; 'reference-v2.approval.json'='approval'; 'pilot-domain.json'='domain-record' }[$name]
+        Inspect-Path (Join-Path $Authority $name) $false
+    }
+    $script:domainArea = 'journal'
+    Inspect-Path $Directory $true
+    function Inspect-Children([string]$Parent) {
+        $script:domainStage = 'children'
+        foreach ($entry in Get-ChildItem -LiteralPath $Parent -Force) {
+            $script:domainArea = 'child'
+            Inspect-Path $entry.FullName $true
+            if ($entry -is [IO.DirectoryInfo]) { Inspect-Children $entry.FullName }
+        }
+    }
+    Inspect-Children $Directory
+    $script:domainArea = 'journal'
+    $script:domainStage = 'file-id'
+    $fileId = Get-JournalNativeFileId $Directory
+    $script:domainStage = 'cim'
+    $volume = Get-CimInstance Win32_LogicalDisk -Filter ("DeviceID='" + [IO.Path]::GetPathRoot($Directory).TrimEnd('\') + "'")
+    if (!$volume.VolumeSerialNumber) { throw 'VolumeId' }
+    $script:domainStage = 'approval-read'
+    $approvalJson = Get-Content -Raw -LiteralPath (Join-Path $Authority 'pilot-domain.json')
+    $script:domainStage = 'approval-json'
+    $approved = $approvalJson | ConvertFrom-Json
+    # Preserve the homologated CIM volume serial representation; the API's 64-bit
+    # volume serial must not silently replace this existing 32-bit prefix.
+    $physical = $volume.VolumeSerialNumber + ':' + $fileId
+    $script:domainStage = 'approval-path'
+    if ($approved.path -cne $Directory) { throw 'Approval' }
+    $script:domainStage = 'approval-id'
+    if ($approved.directoryId -cne $physical) { throw 'Approval' }
+    $script:domainStage = 'approval-sid'
+    if ($approved.operatorSid -cne $sid.Value) { throw 'Approval' }
+    $script:domainStage = 'serialization'
+    [ordered]@{ path=$Directory; directoryId=$physical; operatorSid=$sid.Value } | ConvertTo-Json -Compress
+} catch { throw ('[INFRA_OBSERVER:domain] [INFRA_DOMAIN:' + $script:domainStage + ':' + $script:domainArea + '] Dominio Windows inconclusivo.') }
diff --git a/backend/test/infrastructure/inspect-postgres-windows.ps1 b/backend/test/infrastructure/inspect-postgres-windows.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..ce95417db16751eaa6809a00976745348a611b12
--- /dev/null
+++ b/backend/test/infrastructure/inspect-postgres-windows.ps1
@@ -0,0 +1,164 @@
+[CmdletBinding()]
+param(
+    [Parameter(Mandatory)][string]$ExpectedBinDirectory,
+    [Parameter(Mandatory)][string]$ExpectedDataDirectory
+)
+
+$ErrorActionPreference = 'Stop'
+$serviceName = 'postgresql-x64-18'
+
+function Confirm-LocalPath([string]$Path) {
+    $normalizedPath = $Path.Replace('/', '\')
+    if ($normalizedPath -notmatch '\A[A-Za-z]:\\[^:]+\z') { throw 'Path' }
+    $item = Get-Item -LiteralPath $normalizedPath
+    $drive = [IO.DriveInfo]::new([IO.Path]::GetPathRoot($item.FullName))
+    if ($drive.DriveType -ne [IO.DriveType]::Fixed) { throw 'Drive' }
+    $ancestor = $item
+    while ($null -ne $ancestor) {
+        if ($ancestor.Attributes -band [IO.FileAttributes]::ReparsePoint) { throw 'Reparse' }
+        $ancestor = if ($ancestor -is [IO.FileInfo]) { $ancestor.Directory } else { $ancestor.Parent }
+    }
+    return $item.FullName
+}
+
+function Get-LimitedProcessImage([int]$ProcessId) {
+    if ($ProcessId -le 0) { throw 'ProcessId' }
+    if (-not ('ArenaGO.ProcessImageQuery' -as [type])) {
+        # Reflection.Emit avoids Add-Type/CodeDOM compiler processes and temporary files on PS 5.1.
+        $assembly = [AppDomain]::CurrentDomain.DefineDynamicAssembly(
+            [Reflection.AssemblyName]::new('ArenaGO.ProcessImageQuery'), [Reflection.Emit.AssemblyBuilderAccess]::Run)
+        $module = $assembly.DefineDynamicModule('ProcessImageQuery')
+        $builder = $module.DefineType('ArenaGO.ProcessImageQuery', [Reflection.TypeAttributes]'Public,Abstract,Sealed')
+        $attributes = [Reflection.MethodAttributes]'Public,Static,PinvokeImpl'
+        $methods = @(
+            @{ Name='OpenProcess'; Return=[IntPtr]; Parameters=[type[]]@([uint32],[int],[uint32]) },
+            @{ Name='QueryFullProcessImageNameW'; Return=[int]; Parameters=[type[]]@([IntPtr],[uint32],[Text.StringBuilder],[uint32].MakeByRefType()) },
+            @{ Name='CloseHandle'; Return=[int]; Parameters=[type[]]@([IntPtr]) }
+        )
+        foreach ($method in $methods) {
+            $native = $builder.DefinePInvokeMethod($method.Name,'kernel32.dll',$attributes,
+                [Reflection.CallingConventions]::Standard,$method.Return,$method.Parameters,
+                [Runtime.InteropServices.CallingConvention]::Winapi,[Runtime.InteropServices.CharSet]::Unicode)
+            $native.SetImplementationFlags([Reflection.MethodImplAttributes]::PreserveSig)
+        }
+        $null = $builder.CreateType()
+    }
+    # Only PROCESS_QUERY_LIMITED_INFORMATION; never VM_READ, ALL_ACCESS or SeDebugPrivilege.
+    $handle = [ArenaGO.ProcessImageQuery]::OpenProcess(0x1000,0,[uint32]$ProcessId)
+    if ($handle -eq [IntPtr]::Zero) { throw 'Process image access denied' }
+    try {
+        $buffer = [Text.StringBuilder]::new(32768)
+        [uint32]$size = $buffer.Capacity
+        if ([ArenaGO.ProcessImageQuery]::QueryFullProcessImageNameW($handle,0,$buffer,[ref]$size) -eq 0 -or
+            $size -eq 0 -or $size -ge $buffer.Capacity) { throw 'Process image inconclusive' }
+        return $buffer.ToString()
+    } finally {
+        if ([ArenaGO.ProcessImageQuery]::CloseHandle($handle) -eq 0) { throw 'Process handle closure inconclusive' }
+    }
+}
+
+function Get-AttestedProcessImage($Process) {
+    if (!$Process -or !$Process.CreationDate -or $Process.ProcessId -le 0) { throw 'Process evidence absent' }
+    $image = $Process.ExecutablePath
+    if ([string]::IsNullOrWhiteSpace($image)) { $image = Get-LimitedProcessImage ([int]$Process.ProcessId) }
+    return Confirm-LocalPath $image
+}
+
+$stage = 'caminhos aprovados'
+try {
+    $bin = Confirm-LocalPath $ExpectedBinDirectory
+    $data = Confirm-LocalPath $ExpectedDataDirectory
+    $postgres = Confirm-LocalPath (Join-Path $bin 'postgres.exe')
+
+    $stage = 'listener local'
+    $listeners = @(Get-NetTCPConnection -State Listen -LocalPort 55432)
+    if ($listeners.Count -ne 1 -or $listeners[0].LocalAddress -ne '127.0.0.1') { throw 'Listener' }
+    $listenerPid = [int]$listeners[0].OwningProcess
+    if ($listenerPid -le 0) { throw 'PID' }
+
+    $stage = 'serviço e processos'
+    $services = @(Get-CimInstance Win32_Service -Filter "Name='$serviceName'")
+    if ($services.Count -ne 1 -or $services[0].State -ne 'Running' -or $services[0].ProcessId -le 0) {
+        throw 'Service'
+    }
+    $serviceInfo = $services[0]
+    $servicePid = [int]$serviceInfo.ProcessId
+    $listenerProcess = Get-CimInstance Win32_Process -Filter "ProcessId=$listenerPid"
+    $serviceProcess = Get-CimInstance Win32_Process -Filter "ProcessId=$servicePid"
+    $listenerExe = Get-AttestedProcessImage $listenerProcess
+    $serviceExe = Get-AttestedProcessImage $serviceProcess
+    if ($listenerExe -ne $postgres) { throw 'Process' }
+    if ($listenerPid -ne $servicePid) {
+        if ($serviceExe -ne (Confirm-LocalPath (Join-Path $bin 'pg_ctl.exe')) -or
+            $listenerProcess.ParentProcessId -ne $servicePid -or
+            $listenerProcess.CreationDate -lt $serviceProcess.CreationDate) { throw 'Parent' }
+    } elseif ($serviceExe -ne $postgres) { throw 'Executable' }
+
+    # Accept the registered command only if both its executable and its single -D agree.
+    $launcher = [regex]::Match($serviceInfo.PathName, '^\s*(?:"([^"]+)"|(\S+))\s+')
+    if (!$launcher.Success) { throw 'Command' }
+    $registeredExe = if ($launcher.Groups[1].Success) { $launcher.Groups[1].Value } else { $launcher.Groups[2].Value }
+    $dataArgs = [regex]::Matches($serviceInfo.PathName.Substring($launcher.Length), '(?:^|\s)-D\s+(?:"([^"]+)"|([^"\s]+))(?=\s|$)')
+    if ((Confirm-LocalPath $registeredExe) -ne $serviceExe -or $dataArgs.Count -ne 1) { throw 'Registration' }
+    $registeredData = if ($dataArgs[0].Groups[1].Success) { $dataArgs[0].Groups[1].Value } else { $dataArgs[0].Groups[2].Value }
+    if ((Confirm-LocalPath $registeredData) -ne $data) { throw 'Data' }
+
+    $stage = 'diretório de dados e versão'
+    $postmasterFile = Confirm-LocalPath (Join-Path $data 'postmaster.pid')
+    $versionFile = Confirm-LocalPath (Join-Path $data 'PG_VERSION')
+    $postmaster = @(Get-Content -LiteralPath $postmasterFile -TotalCount 4)
+    $version = (Get-Item -LiteralPath $postgres).VersionInfo.ProductVersion
+    if ($postmaster.Count -ne 4 -or $postmaster[0] -ne [string]$listenerPid -or
+        (Confirm-LocalPath $postmaster[1]) -ne $data -or $postmaster[2] -notmatch '^\d+$' -or
+        $postmaster[3] -ne '55432' -or (Get-Content -LiteralPath $versionFile -Raw).Trim() -ne '18' -or
+        $version -notmatch '^18\.6(?:\.0){0,2}$') { throw 'Instance' }
+    $processStart = $listenerProcess.CreationDate.ToUniversalTime()
+    $postmasterStart = [DateTimeOffset]::FromUnixTimeSeconds([long]$postmaster[2]).UtcDateTime
+    # postmaster.pid stores whole seconds, while process creation has subsecond precision.
+    if ($postmasterStart.AddSeconds(1) -lt $processStart) { throw 'Stale postmaster' }
+
+    $stage = 'fingerprint da instalação'
+    $machineGuid = (Get-ItemProperty -LiteralPath 'HKLM:\SOFTWARE\Microsoft\Cryptography' -Name MachineGuid).MachineGuid
+    if ($machineGuid -notmatch '^[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$') { throw 'Machine' }
+    $cluster = @($machineGuid.ToUpperInvariant(), $data.ToUpperInvariant())
+    $identity = @(($cluster -join '|'), $postgres.ToUpperInvariant(), $serviceExe.ToUpperInvariant(),
+        $listenerPid, $servicePid, $processStart.Ticks, $serviceProcess.CreationDate.ToUniversalTime().Ticks,
+        $postmaster[2], $version, (Get-FileHash -LiteralPath $postgres -Algorithm SHA256).Hash,
+        (Get-FileHash -LiteralPath $serviceExe -Algorithm SHA256).Hash)
+    $hash = [Security.Cryptography.SHA256]::Create()
+    try {
+        $clusterDigest = [BitConverter]::ToString($hash.ComputeHash([Text.Encoding]::UTF8.GetBytes(($cluster -join '|'))))
+        $digest = [BitConverter]::ToString($hash.ComputeHash([Text.Encoding]::UTF8.GetBytes(($identity -join '|'))))
+    } finally {
+        $hash.Dispose()
+    }
+
+    $stage = 'reconferência do listener e do serviço'
+    $current = @(Get-NetTCPConnection -State Listen -LocalPort 55432)
+    $currentService = Get-CimInstance Win32_Service -Filter "Name='$serviceName'"
+    $currentListenerProcess = Get-CimInstance Win32_Process -Filter "ProcessId=$listenerPid"
+    $currentServiceProcess = Get-CimInstance Win32_Process -Filter "ProcessId=$servicePid"
+    if ($current.Count -ne 1 -or $current[0].LocalAddress -ne '127.0.0.1' -or $current[0].OwningProcess -ne $listenerPid -or
+        $currentService.State -ne 'Running' -or $currentService.ProcessId -ne $servicePid -or
+        $currentService.PathName -cne $serviceInfo.PathName -or
+        $currentListenerProcess.CreationDate -ne $listenerProcess.CreationDate -or
+        $currentServiceProcess.CreationDate -ne $serviceProcess.CreationDate -or
+        $currentListenerProcess.ParentProcessId -ne $listenerProcess.ParentProcessId -or
+        (Get-AttestedProcessImage $currentListenerProcess) -ne $listenerExe -or
+        (Get-AttestedProcessImage $currentServiceProcess) -ne $serviceExe) { throw 'Changed' }
+
+    [ordered]@{
+        address = '127.0.0.1'
+        port = 55432
+        service = $serviceName
+        listenerPid = $listenerPid
+        servicePid = $servicePid
+        postgresVersionNum = 180006
+        clusterSha256 = $clusterDigest.Replace('-', '').ToLowerInvariant()
+        instanceSha256 = $digest.Replace('-', '').ToLowerInvariant()
+    } | ConvertTo-Json -Compress
+} catch {
+    $codes = @{ 'caminhos aprovados'='paths'; 'listener local'='listener'; 'serviço e processos'='processes';
+        'diretório de dados e versão'='data'; 'fingerprint da instalação'='fingerprint'; 'reconferência do listener e do serviço'='recheck' }
+    throw ("[INFRA_OBSERVER:" + $codes[$stage] + "] Atestacao operacional inconclusiva.")
+}
diff --git a/backend/test/infrastructure/integration-db-guard.ts b/backend/test/infrastructure/integration-db-guard.ts
new file mode 100644
index 0000000000000000000000000000000000000000..114980590418470980623138899ae4b14830c0a6
--- /dev/null
+++ b/backend/test/infrastructure/integration-db-guard.ts
@@ -0,0 +1,310 @@
+import { integrationBlocked, integrationDestination, validateIntegrationEnvironment, campaignFailure } from "./integration-environment";
+import { canonicalCatalogMatches, checkoutSchema } from "./integration-schema";
+import { compareStructuralCatalog, prepareStructuralReference } from "./integration-structural-reference";
+import { structuralCatalogSql } from "./integration-structural-sql";
+
+export interface IntegrationPreflightClient {
+  query(sql: string): Promise<{ rows: Record<string, unknown>[] }>;
+  release(destroy?: boolean): void;
+}
+
+export interface IntegrationPreflightPool {
+  connect(): Promise<IntegrationPreflightClient>;
+  end(): Promise<void>;
+}
+
+export type IntegrationPreflightPoolFactory = (config: {
+  connectionString: string;
+  ssl: false;
+  max: 1;
+  connectionTimeoutMillis: number;
+  statement_timeout: number;
+  query_timeout: number;
+  idle_in_transaction_session_timeout: number;
+  options: string;
+}) => IntegrationPreflightPool;
+
+const identitySql = `SELECT current_database() AS database_name, current_user AS current_role,
+    session_user AS session_role, pg_catalog.host(inet_server_addr()) AS server_address,
+    inet_server_port() AS server_port, pg_get_userbyid(d.datdba) AS database_owner,
+    r.rolsuper, r.rolcreatedb, r.rolcreaterole, r.rolreplication, r.rolbypassrls, r.rolcanlogin,
+    EXISTS (SELECT 1 FROM pg_catalog.pg_auth_members m WHERE m.member = r.oid) AS member_of_role,
+    EXISTS (SELECT 1 FROM pg_catalog.pg_auth_members m WHERE m.roleid = r.oid) AS granted_to_role,
+    pg_catalog.current_setting('session_replication_role') AS replication_role,
+    pg_is_in_recovery() AS recovering,
+    current_setting('server_version_num')::integer AS server_version_num
+  FROM pg_catalog.pg_database d JOIN pg_catalog.pg_roles r ON r.rolname = session_user
+  WHERE d.datname = current_database()`;
+
+const schemaSql = `SELECT nspname AS name, pg_get_userbyid(nspowner) AS owner
+  FROM pg_catalog.pg_namespace WHERE nspname NOT IN ('pg_catalog', 'information_schema')
+  AND nspname !~ '^pg_'`;
+
+const catalogSql = `SELECT CASE c.relkind
+    WHEN 'r' THEN 'table' WHEN 'i' THEN 'index' WHEN 'S' THEN 'sequence' ELSE 'other' END AS kind,
+    n.nspname || '.' || c.relname AS name, pg_get_userbyid(c.relowner) AS owner,
+    CASE WHEN c.relkind = 'i' THEN i.indisvalid AND i.indisready AND i.indislive
+         WHEN c.relkind = 'r' THEN NOT c.relrowsecurity AND NOT c.relforcerowsecurity AND c.relpersistence = 'p'
+         ELSE true END AS valid
+  FROM pg_catalog.pg_class c JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace
+  LEFT JOIN pg_catalog.pg_index i ON i.indexrelid = c.oid
+  WHERE n.nspname IN ('public', 'drizzle')
+  UNION ALL
+  SELECT 'function', n.nspname || '.' || p.proname || '(' || pg_get_function_identity_arguments(p.oid) || ')',
+    pg_get_userbyid(p.proowner), NOT p.prosecdef AND p.prokind = 'f'
+  FROM pg_catalog.pg_proc p JOIN pg_catalog.pg_namespace n ON n.oid = p.pronamespace
+  WHERE n.nspname IN ('public', 'drizzle')
+  UNION ALL
+  SELECT 'trigger', n.nspname || '.' || c.relname || '.' || t.tgname, pg_get_userbyid(c.relowner), t.tgenabled = 'O'
+  FROM pg_catalog.pg_trigger t JOIN pg_catalog.pg_class c ON c.oid = t.tgrelid
+  JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace
+  WHERE n.nspname IN ('public', 'drizzle') AND NOT t.tgisinternal
+  UNION ALL
+  SELECT 'constraint', n.nspname || '.' || c.relname || '.' || k.conname, pg_get_userbyid(c.relowner), k.convalidated
+  FROM pg_catalog.pg_constraint k JOIN pg_catalog.pg_class c ON c.oid = k.conrelid
+  JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace
+  WHERE n.nspname IN ('public', 'drizzle') AND k.contype <> 'n'
+  UNION ALL
+  SELECT 'type', n.nspname || '.' || t.typname, pg_get_userbyid(t.typowner), true
+  FROM pg_catalog.pg_type t JOIN pg_catalog.pg_namespace n ON n.oid = t.typnamespace
+  WHERE n.nspname IN ('public', 'drizzle') AND t.typrelid = 0 AND t.typelem = 0
+  UNION ALL
+  SELECT 'rule', n.nspname || '.' || c.relname || '.' || r.rulename, pg_get_userbyid(c.relowner), true
+  FROM pg_catalog.pg_rewrite r JOIN pg_catalog.pg_class c ON c.oid = r.ev_class
+  JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace WHERE n.nspname IN ('public', 'drizzle')
+  UNION ALL
+  SELECT 'event_trigger', e.evtname, pg_get_userbyid(e.evtowner), true FROM pg_catalog.pg_event_trigger e`;
+
+const aclSql = `SELECT NOT EXISTS (
+    SELECT 1 FROM pg_catalog.pg_database d
+    CROSS JOIN LATERAL aclexplode(COALESCE(d.datacl, acldefault('d', d.datdba))) a
+    WHERE d.datname = current_database() AND a.grantee <> d.datdba
+  ) AND NOT EXISTS (
+    SELECT 1 FROM pg_catalog.pg_namespace n
+    CROSS JOIN LATERAL aclexplode(COALESCE(n.nspacl, acldefault('n', n.nspowner))) a
+    WHERE n.nspname IN ('public', 'drizzle') AND a.grantee <> n.nspowner
+    AND NOT (n.nspname = 'public' AND a.grantee = 0 AND a.privilege_type = 'USAGE' AND NOT a.is_grantable)
+  ) AND NOT EXISTS (
+    SELECT 1 FROM pg_catalog.pg_class c JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace
+    CROSS JOIN LATERAL aclexplode(c.relacl) a
+    WHERE n.nspname IN ('public', 'drizzle') AND a.grantee <> c.relowner
+  ) AND NOT EXISTS (
+    SELECT 1 FROM pg_catalog.pg_attribute col JOIN pg_catalog.pg_class c ON c.oid = col.attrelid
+    JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace CROSS JOIN LATERAL aclexplode(col.attacl) a
+    WHERE n.nspname IN ('public', 'drizzle') AND a.grantee <> c.relowner
+  ) AND NOT EXISTS (
+    SELECT 1 FROM pg_catalog.pg_proc p JOIN pg_catalog.pg_namespace n ON n.oid = p.pronamespace
+    CROSS JOIN LATERAL aclexplode(COALESCE(p.proacl, acldefault('f', p.proowner))) a
+    WHERE n.nspname IN ('public', 'drizzle') AND a.grantee <> p.proowner
+    AND NOT (a.grantee = 0 AND a.privilege_type = 'EXECUTE' AND NOT a.is_grantable)
+  ) AND NOT EXISTS (
+    SELECT 1 FROM pg_catalog.pg_default_acl a LEFT JOIN pg_catalog.pg_namespace n ON n.oid = a.defaclnamespace
+    WHERE a.defaclnamespace = 0 OR n.nspname IN ('public', 'drizzle')
+  ) AS compatible`;
+
+async function read(client: Pick<IntegrationPreflightClient, "query">, sql: string, phase: string) {
+  try {
+    return (await client.query(sql)).rows;
+  } catch (error) {
+    // Driver errors can carry the URI or credentials. Do not retain a cause.
+    throw Object.assign(integrationBlocked("Falha na etapa " + phase + "."), { code: campaignFailure('preflight', error).code });
+  }
+}
+
+export async function attestIntegrationIdentity(client: Pick<IntegrationPreflightClient, "query">, postgresVersionNum: number) {
+  const { database, address, port, role } = integrationDestination;
+  const [id] = await read(client, identitySql, "identidade");
+  if (id?.database_name !== database || id.server_address !== address || id.server_port !== port
+      || id.current_role !== role || id.session_role !== role || id.recovering !== false || id.rolcanlogin !== true) {
+    throw integrationBlocked("Identidade efetiva do PostgreSQL divergente.");
+  }
+  if (id.database_owner !== role) throw integrationBlocked("Proprietário do banco divergente.");
+  if ([id.rolsuper, id.rolcreatedb, id.rolcreaterole, id.rolreplication, id.rolbypassrls].some(flag => flag !== false)) {
+    throw integrationBlocked("Privilégio elevado na role.");
+  }
+  if (id.member_of_role !== false || id.granted_to_role !== false) {
+    throw integrationBlocked("Associação explícita envolvendo a role dedicada.");
+  }
+  if (id.replication_role !== "origin") throw integrationBlocked("Modo de replicação da sessão incompatível.");
+  if (id.server_version_num !== postgresVersionNum) {
+    throw integrationBlocked("Versão PostgreSQL divergente da referência estrutural.");
+  }
+}
+
+async function attest(
+  client: IntegrationPreflightClient,
+  schema: ReturnType<typeof checkoutSchema>,
+  noHistoricalAdmin: boolean,
+  postgresVersionNum: number,
+  verifyStructure: (rows: unknown) => void,
+) {
+  const { role } = integrationDestination;
+  await attestIntegrationIdentity(client, postgresVersionNum);
+  const schemas = await read(client, schemaSql, "schemas");
+  if (schemas.length !== 2 || !schemas.some(row => row.name === "drizzle" && row.owner === role)
+      || !schemas.some(row => row.name === "public" && [role, "pg_database_owner"].includes(String(row.owner)))) {
+    throw integrationBlocked("Schemas ou proprietários divergentes.");
+  }
+  const [acl] = await read(client, aclSql, "ACLs");
+  if (acl?.compatible !== true) throw integrationBlocked("ACL incompatível com banco dedicado.");
+
+  const pending = new Set(schema.objects.map(object => object.kind + ":" + object.name));
+  for (const object of await read(client, catalogSql, "catálogo")) {
+    if (!pending.delete(String(object.kind) + ":" + String(object.name))) {
+      throw integrationBlocked("Objeto DDL inesperado no catálogo.");
+    }
+    if (object.owner !== role || object.valid !== true) throw integrationBlocked("Objeto com proprietário ou estado inválido.");
+  }
+  if (pending.size) throw integrationBlocked("Tabela ou objeto obrigatório ausente.");
+
+  const migrations = await read(client, "SELECT created_at::text AS migration, hash FROM drizzle.__drizzle_migrations ORDER BY created_at", "migrations");
+  if (migrations.length !== schema.migrations.length || migrations.some((item, index) => item.migration !== schema.migrations[index].migration)) {
+    throw integrationBlocked("Journal de migrations divergente.");
+  }
+  if (migrations.some((item, index) => item.hash !== schema.migrations[index].hash)) {
+    throw integrationBlocked("Hash de migration divergente.");
+  }
+
+  verifyStructure(await read(client, structuralCatalogSql, "estrutura do catálogo"));
+
+  if (noHistoricalAdmin) {
+    const [history] = await read(client, "SELECT EXISTS (SELECT 1 FROM public.user_roles WHERE role = 'admin' AND event_id IS NULL) AS occupied", "histórico Admin");
+    if (history?.occupied !== false) throw integrationBlocked("O perfil exige ausência de Admin global histórico.");
+  }
+  const operationalTables = schema.tables.filter(name => name !== "games" && name !== "questionnaire_versions");
+  const occupiedSql = operationalTables.map(name => 'EXISTS (SELECT 1 FROM public."' + name + '")').join(" OR ");
+  const [occupied] = await read(client, "SELECT (" + occupiedSql + ") AS occupied", "baseline operacional");
+  if (occupied?.occupied !== false) throw integrationBlocked("Baseline operacional incompatível.");
+  const games = await read(client, "SELECT name, is_curated AS curated FROM public.games", "baseline de jogos");
+  const questionnaires = await read(client, `SELECT version, definition,
+    (activated_at IS NOT NULL AND activated_at <= CURRENT_TIMESTAMP) AS published
+    FROM public.questionnaire_versions`, "baseline de questionário");
+  if (!canonicalCatalogMatches(games, questionnaires)) throw integrationBlocked("Baseline canônico incompatível.");
+}
+
+// The factory is deliberately injected. This module does not import pg or start an application.
+function preparation(
+  suiteId: string,
+  env: NodeJS.ProcessEnv,
+) {
+  const { suite, connectionString } = validateIntegrationEnvironment(suiteId, env);
+  let schema: ReturnType<typeof checkoutSchema>;
+  try {
+    schema = checkoutSchema();
+    const required = suite.schema.specificMigration;
+    if (required && !schema.migrationTags.includes(required)) throw new Error();
+  } catch {
+    throw integrationBlocked("Artefatos de migrations indisponíveis ou incompatíveis.");
+  }
+  return { suite, connectionString, schema };
+}
+
+async function readOnlySnapshot<T>(
+  connectionString: string,
+  createPool: IntegrationPreflightPoolFactory,
+  inspect: (client: IntegrationPreflightClient) => Promise<T>,
+): Promise<T> {
+  let pool: IntegrationPreflightPool;
+  try {
+    pool = createPool({
+      connectionString, ssl: false, max: 1, connectionTimeoutMillis: 2_000,
+      statement_timeout: 5_000, query_timeout: 6_000, idle_in_transaction_session_timeout: 10_000,
+      options: "-c search_path=pg_catalog -c default_transaction_read_only=on -c quote_all_identifiers=off"
+        + " -c standard_conforming_strings=on -c DateStyle=ISO,YMD -c IntervalStyle=postgres"
+        + " -c TimeZone=UTC -c extra_float_digits=3 -c bytea_output=hex",
+    });
+  } catch {
+    throw integrationBlocked("Falha ao preparar o pool de pré-verificação.");
+  }
+
+  try {
+    let client: IntegrationPreflightClient;
+    try {
+      client = await pool.connect();
+    } catch {
+      throw integrationBlocked("Falha ao conectar para pré-verificação.");
+    }
+    let destroy = true;
+    try {
+      await read(client, "BEGIN ISOLATION LEVEL REPEATABLE READ READ ONLY", "abertura somente leitura");
+      try {
+        return await inspect(client);
+      } finally {
+        await read(client, "ROLLBACK", "encerramento somente leitura");
+        destroy = false;
+      }
+    } finally {
+      try {
+        client.release(destroy);
+      } catch {
+        throw integrationBlocked("Falha ao liberar a conexão de pré-verificação.");
+      }
+    }
+  } finally {
+    try {
+      await pool.end();
+    } catch {
+      throw integrationBlocked("Falha ao encerrar o pool de pré-verificação.");
+    }
+  }
+}
+
+export async function attestIntegrationDatabase(
+  suiteId: string,
+  env: NodeJS.ProcessEnv,
+  createPool: IntegrationPreflightPoolFactory,
+  trustedReference?: unknown,
+): Promise<void> {
+  const { suite, schema, connectionString } = preparation(suiteId, env);
+  const reference = prepareStructuralReference(trustedReference, schema.migrations);
+  return readOnlySnapshot(connectionString, createPool, client =>
+    attest(client, schema, suite.preconditions.noHistoricalAdmin, reference.postgresVersionNum,
+      rows => compareStructuralCatalog(reference.expected, rows)));
+}
+
+// This collector only runs the fixed read protocol. The adapter owns authorization and connection.
+export async function inspectPreparationSnapshot(
+  env: NodeJS.ProcessEnv,
+  createPool: IntegrationPreflightPoolFactory,
+  postgresVersionNum: number,
+  inspectStructure: (rows: unknown, schema: ReturnType<typeof checkoutSchema>) => void,
+  inspectClock: (readClock: () => Promise<unknown>) => Promise<void>,
+  qualification?: { reference: unknown },
+) {
+  const { schema, connectionString } = preparation("admin-external-queue-http", env);
+  const expected = qualification && prepareStructuralReference(qualification.reference, schema.migrations);
+  if (expected && expected.postgresVersionNum !== postgresVersionNum) {
+    throw integrationBlocked("Versão da referência divergente.");
+  }
+  return readOnlySnapshot(connectionString, createPool, async client => {
+    const [session] = await read(client, `SELECT
+      current_setting('transaction_read_only') AS read_only,
+      current_setting('default_transaction_read_only') AS default_read_only,
+      current_setting('transaction_isolation') AS isolation,
+      current_setting('search_path') AS search_path,
+      current_setting('TimeZone') AS timezone,
+      current_setting('session_replication_role') AS replication_role,
+      current_setting('quote_all_identifiers') AS quote_all,
+      current_setting('standard_conforming_strings') AS standard_strings,
+      current_setting('DateStyle') AS date_style,
+      current_setting('IntervalStyle') AS interval_style,
+      current_setting('extra_float_digits') AS float_digits,
+      current_setting('bytea_output') AS bytea_output`, "configuração efetiva");
+    if (session?.read_only !== "on" || session.default_read_only !== "on"
+        || session.isolation !== "repeatable read" || session.search_path !== "pg_catalog"
+        || session.timezone !== "UTC" || session.replication_role !== "origin" || session.quote_all !== "off"
+        || session.standard_strings !== "on" || session.date_style !== "ISO, YMD" || session.interval_style !== "postgres"
+        || session.float_digits !== "3" || session.bytea_output !== "hex") {
+      throw integrationBlocked("Configuração efetiva da sessão de atestação incompatível.");
+    }
+    await attest(client, schema, true, postgresVersionNum, rows => {
+      if (expected) compareStructuralCatalog(expected.expected, rows);
+      inspectStructure(rows, schema);
+    });
+    await inspectClock(async () => (await read(client, `SELECT
+      (extract(epoch FROM clock_timestamp()) * 1000)::double precision AS server_ms,
+      (extract(epoch FROM CURRENT_TIMESTAMP) * 1000)::double precision AS snapshot_ms,
+      (extract(epoch FROM activated_at) * 1000)::double precision AS activation_ms
+      FROM public.questionnaire_versions`, "relógio e vigência"))[0]);
+  });
+}
diff --git a/backend/test/infrastructure/integration-environment.ts b/backend/test/infrastructure/integration-environment.ts
new file mode 100644
index 0000000000000000000000000000000000000000..06468905b4dc816538ec153d6a2f9d4a9392ff57
--- /dev/null
+++ b/backend/test/infrastructure/integration-environment.ts
@@ -0,0 +1,130 @@
+import { randomBytes } from "node:crypto";
+import { devNull } from "node:os";
+import { selectIntegrationSuite } from "./integration-inventory";
+
+export const integrationDestination = {
+  address: "127.0.0.1",
+  port: 55432,
+  database: "arenago_events_test",
+  role: "arenago",
+} as const;
+
+const urlKeys = ["DATABASE_URL", "DATABASE_DIRECT_URL", "EVENTS_TEST_DATABASE_URL"] as const;
+const ttlKeys = [
+  "ADMIN_IDEMPOTENCY_TTL_SECONDS",
+  "EVALUATION_IDEMPOTENCY_TTL_SECONDS",
+  "PARTICIPANT_QUEUE_IDEMPOTENCY_TTL_SECONDS",
+  "STAFF_IDEMPOTENCY_TTL_SECONDS",
+] as const;
+const authKeys = ["JWT_SECRET", "JWT_TEMP_SECRET", "TOTP_ENCRYPTION_KEY", "TOTP_RECOVERY_HMAC_KEY"] as const;
+export const windowsObserverVariableGroups = {
+  installation: ['ProgramFiles','ProgramFiles(x86)','ProgramW6432','CommonProgramFiles','CommonProgramFiles(x86)','CommonProgramW6432'],
+  profile: ['USERPROFILE','HOMEDRIVE','HOMEPATH','APPDATA','LOCALAPPDATA','PUBLIC','ALLUSERSPROFILE'],
+  temporary: ['TEMP','TMP'],
+  identity: ['USERNAME','USERDOMAIN','USERDOMAIN_ROAMINGPROFILE','LOGONSERVER','COMPUTERNAME','SESSIONNAME','OS','PROCESSOR_ARCHITECTURE','PROCESSOR_ARCHITEW6432','ComSpec'],
+} as const;
+const systemKeys = new Map([
+  "PATH", "SystemRoot", "ComSpec", "TEMP", "TMP", "TMPDIR",
+  ...(process.platform === "win32" ? ["USERPROFILE"] : ["HOME"]),
+  ...(process.platform === 'win32' ? ['ProgramData','WINDIR','SYSTEMDRIVE', ...Object.values(windowsObserverVariableGroups).flat()] : []),
+].map(name => [name.toUpperCase(), name]));
+const environmentKeys = new Set([
+  "NODE_ENV", "DOTENV_CONFIG_PATH", "EVENT_CLOSURE_JOB_TEST_ENABLED",
+  ...urlKeys, ...ttlKeys, ...authKeys,
+]);
+
+export function integrationBlocked(reason: string): Error {
+  return new Error("[SEGURANÇA BLOQUEADA] " + reason);
+}
+
+export const campaignDiagnosticStages = ['credentials','configuration','revision','reference','connection-attestation','connection',
+  'sql-identity','lock-acquisition','lock-verification','lock-close','journal-admission','journal-save','journal-finish',
+  'preflight','postflight','worker-launch','worker-bootstrap','worker-environment','ipc-wait','ipc-authorize','ipc-started',
+  'worker-install','worker-connection','worker-sql-identity','runner','runner-summary','reconciliation','resources','worker-stop',
+  'campaign','worker-exit','ipc-protocol'] as const;
+export type CampaignDiagnosticStage = typeof campaignDiagnosticStages[number];
+export type CampaignFailure = Readonly<{ stage: CampaignDiagnosticStage; code: string; exitCode?: number; signal?: string }>;
+export class CampaignDiagnosticError extends Error {
+  constructor(readonly diagnostic: CampaignFailure) {
+    super(`[SEGURANÇA BLOQUEADA] campaign-stage=${diagnostic.stage}; code=${diagnostic.code}.`);
+  }
+}
+export function campaignFailure(stage: CampaignDiagnosticStage, error: unknown): CampaignFailure {
+  if (error instanceof CampaignDiagnosticError) return error.diagnostic;
+  const code = error && typeof error === 'object' && 'code' in error ? error.code : undefined;
+  // Fixed OS/SQLSTATE codes only; never copy message/detail/hint/cause/query/URI/stack.
+  const allowed = ['28P01','28000','3D000','42501','53300','57P01','57P02','57P03','08001','08006',
+    'ECONNREFUSED','ECONNRESET','ETIMEDOUT','ENOENT','EACCES','EPERM','EPIPE','ERR_IPC_CHANNEL_CLOSED'];
+  return { stage, code: typeof code === 'string' && allowed.includes(code) ? code : 'unavailable' };
+}
+export async function campaignStep<T>(stage: CampaignDiagnosticStage, work: () => T | Promise<T>): Promise<T> {
+  try { return await work(); }
+  catch (error) { throw new CampaignDiagnosticError(campaignFailure(stage, error)); }
+}
+
+function validateUrl(value: string | undefined): string {
+  if (!value) throw integrationBlocked("As três URLs PostgreSQL são obrigatórias.");
+  // Use the literal authority as well as URL parsing, which normalizes some hosts/ports.
+  const { address, port, database, role } = integrationDestination;
+  const credentials = /^postgres(?:ql)?:\/\/([^:@/?#\\\s]+):([^:@/?#\\\s]+)@([^/?#\\\s]+)\/([^/?#\\\s]+)$/u.exec(value);
+  if (!credentials || value.trim() !== value || credentials[3] !== address + ":" + port || credentials[4] !== database) {
+    throw integrationBlocked("URI inválida ou destino PostgreSQL fora da política local.");
+  }
+  try {
+    const uri = new URL(value);
+    const username = decodeURIComponent(credentials[1]);
+    const password = decodeURIComponent(credentials[2]);
+    if (uri.hostname !== address || uri.port !== String(port) || uri.pathname !== "/" + database
+        || username !== role || !password.trim() || /[\u0000-\u001f\u007f]/u.test(password)) throw new Error();
+  } catch {
+    throw integrationBlocked("Role PostgreSQL ou credenciais inválidas.");
+  }
+  return value;
+}
+
+export function validateIntegrationEnvironment(suiteId: string, env: NodeJS.ProcessEnv) {
+  const suite = selectIntegrationSuite(suiteId);
+  if (env.NODE_ENV !== "test") throw integrationBlocked("NODE_ENV=test é obrigatório.");
+  if (env.DOTENV_CONFIG_PATH !== devNull || env.DOTENV_CONFIG_OVERRIDE !== undefined) {
+    throw integrationBlocked("Dotenv deve apontar ao dispositivo nulo, sem override.");
+  }
+  if (env.EVENT_CLOSURE_JOB_TEST_ENABLED !== "false" || suite.scheduler !== "disabled") {
+    throw integrationBlocked("Scheduler incompatível com o perfil selecionado.");
+  }
+  const urls = urlKeys.map(key => validateUrl(env[key]));
+  if (urls.some(url => url !== urls[0])) throw integrationBlocked("As três URLs devem ser textualmente idênticas.");
+
+  if (Object.keys(env).some(key => env[key] !== undefined && !environmentKeys.has(key) && ![...systemKeys.values()].includes(key))) {
+    throw integrationBlocked("O ambiente contém variáveis fora da lista autorizada.");
+  }
+  if (ttlKeys.some(key => {
+    const value = env[key] ?? "";
+    const ms = Number(value) * 1000;
+    return !/^[1-9]\d*$/u.test(value) || !Number.isSafeInteger(ms) || !Number.isFinite(new Date(Date.now() + ms).getTime());
+  })) throw integrationBlocked("Os quatro TTLs devem ser inteiros positivos válidos.");
+
+  const auth = authKeys.map(key => env[key] ?? "");
+  const [jwt, temporaryJwt, encryption, recovery] = auth;
+  const base64Key = (key: string) => /^[A-Za-z0-9+/]{43}=$/u.test(key) && Buffer.from(key, "base64").toString("base64") === key;
+  if (jwt.length < 32 || temporaryJwt.length < 32 || /[\u0000-\u001f\u007f]/u.test(jwt + temporaryJwt)
+      || !base64Key(encryption) || !base64Key(recovery) || new Set(auth).size !== auth.length) {
+    throw integrationBlocked("Credenciais sintéticas de autenticação inválidas ou repetidas.");
+  }
+  return { suite, connectionString: urls[0] };
+}
+
+export function buildIntegrationEnvironment(suiteId: string, connectionString: string, parent: NodeJS.ProcessEnv) {
+  const env: NodeJS.ProcessEnv = Object.create(null);
+  for (const [name, value] of Object.entries(parent)) {
+    const allowed = systemKeys.get(name.toUpperCase());
+    if (allowed && (process.platform === "win32" || name === allowed) && value !== undefined) env[allowed] = value;
+  }
+  for (const key of urlKeys) env[key] = connectionString;
+  for (const key of ttlKeys) env[key] = "60";
+  for (const key of authKeys) env[key] = randomBytes(32).toString("base64");
+  env.NODE_ENV = "test";
+  env.DOTENV_CONFIG_PATH = devNull;
+  env.EVENT_CLOSURE_JOB_TEST_ENABLED = "false";
+  validateIntegrationEnvironment(suiteId, env);
+  return env;
+}
