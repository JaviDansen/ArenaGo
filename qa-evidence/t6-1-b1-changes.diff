+npm.cmd run typecheck:test
+if ($LASTEXITCODE -ne 0) { throw 'Typecheck de testes falhou.' }
+npm.cmd run lint
+if ($LASTEXITCODE -ne 0) { throw 'Lint falhou.' }
+npm.cmd run build
+if ($LASTEXITCODE -ne 0) { throw 'Build falhou.' }
