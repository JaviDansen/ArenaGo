diff --git a/app/services/queueAlertService.js b/app/services/queueAlertService.js
new file mode 100644
index 00000000..d54d20cc
--- /dev/null
+++ b/app/services/queueAlertService.js
@@ -0,0 +1,78 @@
+export function defaultVibrate() {
+  try {
+    const rn = require('react-native');
+    rn?.Vibration?.vibrate?.(500);
+  } catch {
+    // Falha silenciosa caso o dispositivo não suporte vibração
+  }
+}
+
+/**
+ * Gerenciador de alertas locais para novas chamadas na fila da Arena.
+ * Garante uma única vibração por nova chamada, sem repetições periódicas,
+ * sem vibração em segundo plano e sem disparo para chamadas já ativas na inicialização.
+ */
+export function createQueueAlertManager({
+  getIdentity,
+  vibrate = defaultVibrate,
+  isAppActive = () => true,
+} = {}) {
+  const alertedCallKeys = new Set();
+  const initializedParticipations = new Set();
+
+  function buildCallKey(identity, participationId, queueEntry) {
+    const sessionId = queueEntry.serviceSessionId || queueEntry.stationLabel || queueEntry.id;
+    return `${identity.userId}:${identity.epoch}:${participationId}:${queueEntry.id}:${sessionId}`;
+  }
+
+  function reset() {
+    alertedCallKeys.clear();
+    initializedParticipations.clear();
+  }
+
+  function checkAndAlert({ queueEntry, participationId, isInitial = false }) {
+    if (!queueEntry || queueEntry.status !== 'called' || !participationId) {
+      if (isInitial && participationId) {
+        initializedParticipations.add(participationId);
+      }
+      return false;
+    }
+
+    const identity = typeof getIdentity === 'function' ? getIdentity() : null;
+    if (!identity?.userId || identity.epoch === null || identity.epoch === undefined) {
+      return false;
+    }
+
+    if (typeof isAppActive === 'function' && !isAppActive()) {
+      return false;
+    }
+
+    const callKey = buildCallKey(identity, participationId, queueEntry);
+
+    // Se é a carga inicial ou a primeira conferência desta participação, registrar sem vibrar
+    if (isInitial || !initializedParticipations.has(participationId)) {
+      initializedParticipations.add(participationId);
+      alertedCallKeys.add(callKey);
+      return false;
+    }
+
+    // Se esta chamada já foi alertada nesta sessão, não vibrar novamente
+    if (alertedCallKeys.has(callKey)) {
+      return false;
+    }
+
+    alertedCallKeys.add(callKey);
+    try {
+      vibrate();
+    } catch {
+      // Aviso visual preservado mesmo se vibração falhar
+    }
+    return true;
+  }
+
+  return {
+    checkAndAlert,
+    reset,
+    hasAlerted(callKey) { return alertedCallKeys.has(callKey); },
+  };
+}

diff --git a/app/tests/autoQueueSync.test.cjs b/app/tests/autoQueueSync.test.cjs
new file mode 100644
index 00000000..8863f131
--- /dev/null
+++ b/app/tests/autoQueueSync.test.cjs
@@ -0,0 +1,749 @@
+const assert = require('node:assert/strict');
+const test = require('node:test');
+const { loadModule } = require('./helpers/questionnaireHarness.cjs');
+
+// 1. Testes do serviço de alerta e vibração (queueAlertService)
+test('queueAlertService: dispara vibração única para nova chamada', () => {
+  const { createQueueAlertManager } = loadModule('services/queueAlertService.js', (name) => {
+    if (name === 'react-native') {
+      return { Vibration: { vibrate: () => {} } };
+    }
+    return require(name);
+  }).exports;
+
+  let vibrateCalls = 0;
+  let active = true;
+  let identity = { userId: 'user-1', epoch: 10 };
+
+  const manager = createQueueAlertManager({
+    getIdentity: () => identity,
+    vibrate: () => { vibrateCalls += 1; },
+    isAppActive: () => active,
+  });
+
+  const participationId = 'part-1';
+  const entryWaiting = { id: 'entry-1', status: 'waiting', position: 2 };
+  const entryCalled = { id: 'entry-1', status: 'called', stationLabel: 'Estação 1', serviceSessionId: 'sess-1' };
+
+  // Carga inicial com usuário na fila (waiting) - inicializa sem vibrar
+  assert.equal(manager.checkAndAlert({ queueEntry: entryWaiting, participationId, isInitial: true }), false);
+  assert.equal(vibrateCalls, 0);
+
+  // Primeira transição para chamado (called) - DEVE vibrar uma vez
+  assert.equal(manager.checkAndAlert({ queueEntry: entryCalled, participationId, isInitial: false }), true);
+  assert.equal(vibrateCalls, 1);
+
+  // Consulta seguinte após 5s com a mesma chamada ativa - NÃO deve vibrar novamente
+  assert.equal(manager.checkAndAlert({ queueEntry: entryCalled, participationId, isInitial: false }), false);
+  assert.equal(vibrateCalls, 1);
+});
+
+test('queueAlertService: NÃO vibra para chamadas preexistentes na carga inicial (reabertura/reconexão)', () => {
+  const { createQueueAlertManager } = loadModule('services/queueAlertService.js', (name) => {
+    if (name === 'react-native') return { Vibration: { vibrate: () => {} } };
+    return require(name);
+  }).exports;
+
+  let vibrateCalls = 0;
+  const manager = createQueueAlertManager({
+    getIdentity: () => ({ userId: 'user-1', epoch: 10 }),
+    vibrate: () => { vibrateCalls += 1; },
+    isAppActive: () => true,
+  });
+
+  const entryCalled = { id: 'entry-1', status: 'called', stationLabel: 'Estação 1', serviceSessionId: 'sess-1' };
+
+  // Reabertura do aplicativo com chamada já existente (isInitial: true)
+  assert.equal(manager.checkAndAlert({ queueEntry: entryCalled, participationId: 'part-1', isInitial: true }), false);
+  assert.equal(vibrateCalls, 0);
+
+  // Polling seguinte de 5s não vibra para o mesmo estado
+  assert.equal(manager.checkAndAlert({ queueEntry: entryCalled, participationId: 'part-1', isInitial: false }), false);
+  assert.equal(vibrateCalls, 0);
+});
+
+test('queueAlertService: NÃO vibra quando o aplicativo está em segundo plano', () => {
+  const { createQueueAlertManager } = loadModule('services/queueAlertService.js', (name) => {
+    if (name === 'react-native') return { Vibration: { vibrate: () => {} } };
+    return require(name);
+  }).exports;
+
+  let vibrateCalls = 0;
+  let appActive = false; // Background
+  const manager = createQueueAlertManager({
+    getIdentity: () => ({ userId: 'user-1', epoch: 10 }),
+    vibrate: () => { vibrateCalls += 1; },
+    isAppActive: () => appActive,
+  });
+
+  const entryCalled = { id: 'entry-1', status: 'called', stationLabel: 'Estação 1', serviceSessionId: 'sess-1' };
+
+  // Inicializa
+  manager.checkAndAlert({ queueEntry: { id: 'entry-1', status: 'waiting', position: 1 }, participationId: 'part-1', isInitial: true });
+
+  // Transição ocorre enquanto em segundo plano
+  assert.equal(manager.checkAndAlert({ queueEntry: entryCalled, participationId: 'part-1', isInitial: false }), false);
+  assert.equal(vibrateCalls, 0);
+
+  // App retorna ao primeiro plano
+  appActive = true;
+  assert.equal(manager.checkAndAlert({ queueEntry: entryCalled, participationId: 'part-1', isInitial: false }), true);
+  assert.equal(vibrateCalls, 1);
+});
+
+test('queueAlertService: logout ou troca de conta impede alerta de sessão anterior', () => {
+  const { createQueueAlertManager } = loadModule('services/queueAlertService.js', (name) => {
+    if (name === 'react-native') return { Vibration: { vibrate: () => {} } };
+    return require(name);
+  }).exports;
+
+  let vibrateCalls = 0;
+  let identity = { userId: 'user-a', epoch: 1 };
+  const manager = createQueueAlertManager({
+    getIdentity: () => identity,
+    vibrate: () => { vibrateCalls += 1; },
+    isAppActive: () => true,
+  });
+
+  const entryCalled = { id: 'entry-1', status: 'called', stationLabel: 'Estação 1', serviceSessionId: 'sess-1' };
+
+  manager.checkAndAlert({ queueEntry: { id: 'entry-1', status: 'waiting', position: 1 }, participationId: 'part-a', isInitial: true });
+
+  // Logout ocorre antes do alerta
+  identity = null;
+  assert.equal(manager.checkAndAlert({ queueEntry: entryCalled, participationId: 'part-a', isInitial: false }), false);
+  assert.equal(vibrateCalls, 0);
+
+  // Reset e login com usuário B
+  manager.reset();
+  identity = { userId: 'user-b', epoch: 2 };
+  // Chamada pertencente à conta A não dispara para conta B
+  assert.equal(manager.checkAndAlert({ queueEntry: entryCalled, participationId: 'part-b', isInitial: true }), false);
+  assert.equal(vibrateCalls, 0);
+});
