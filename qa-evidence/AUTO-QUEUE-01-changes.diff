+  store.setIdentity(identity);
+  await store.refresh();
+  assert.equal(store.getSnapshot().participation.externalQueue.position, 5);
+  assert.equal(store.getSnapshot().syncStale, false);
+
+  // Cenário 9: Erro transitório durante polling silencioso
