diff --git a/app/services/participationService.js b/app/services/participationService.js
new file mode 100644
index 0000000..8742c6c
--- /dev/null
+++ b/app/services/participationService.js
@@ -0,0 +1,61 @@
+import { httpClient } from './httpClient';
+
+const empty = () => ({ userId: null, epoch: null, status: 'idle', participation: null, returnState: null, demoParticipation: null, error: null });
+
+export function createParticipationStore({ client = httpClient, getIdentity }) {
+  let state = empty();
+  let generation = 0;
+  const listeners = new Set();
+  const publish = (next) => { state = next; listeners.forEach((listener) => listener(state)); };
+  const matches = (identity) => {
+    const current = getIdentity();
+    return Boolean(identity && current && identity.userId === current.userId && identity.epoch === current.epoch &&
+      state.userId === identity.userId && state.epoch === identity.epoch);
+  };
+
+  function setIdentity(identity) {
+    generation += 1;
+    if (!identity) { publish(empty()); return; }
+    publish({ ...empty(), ...identity, status: 'loading' });
+  }
+
+  async function refresh() {
+    const identity = state.userId === null ? null : { userId: state.userId, epoch: state.epoch };
+    if (!matches(identity)) return;
+    const requestGeneration = ++generation;
+    publish({ ...state, status: 'loading', error: null, participation: null, returnState: null, demoParticipation: null });
+    try {
+      const [current, returned] = await Promise.all([
+        client.get('/participations/current', { auth: true }),
+        client.get('/participations/return-state', { auth: true }),
+      ]);
+      if (requestGeneration !== generation || !matches(identity)) return;
+      const participation = current?.participation;
+      if (!current || !Object.prototype.hasOwnProperty.call(current, 'participation') ||
+          (participation !== null && (!participation || typeof participation.id !== 'string' ||
+            typeof participation.eventId !== 'string' || !['waiting', 'active'].includes(participation.status) ||
+            (participation.status === 'waiting' && (!Number.isSafeInteger(participation.externalQueue?.position) || participation.externalQueue.position < 1))))) {
+        throw new Error('Resposta inválida de participação.');
+      }
+      if (!returned || !Array.isArray(returned.pendingEvaluationParticipationIds) ||
+          !returned.pendingEvaluationParticipationIds.every((id) => typeof id === 'string') ||
+          !Object.prototype.hasOwnProperty.call(returned, 'recentFinalization')) {
+        throw new Error('Resposta inválida de estado de retorno.');
+      }
+      publish({ ...state, status: 'ready', participation, returnState: returned, demoParticipation: null, error: null });
+    } catch (error) {
+      if (requestGeneration !== generation || !matches(identity)) return;
+      publish({ ...state, status: 'error', participation: null, returnState: null, demoParticipation: null,
+        error: error?.status === 401 || error?.status === 403 ? 'authorization' : error?.isNetworkError ? 'network' : 'unavailable' });
+    }
+  }
+
+  function setDemoParticipation(update) {
+    const identity = state.userId === null ? null : { userId: state.userId, epoch: state.epoch };
+    if (!matches(identity) || state.status !== 'ready' || state.participation) return;
+    const next = typeof update === 'function' ? update(state.demoParticipation) : update;
+    publish({ ...state, demoParticipation: next ? { ...next, source: 'demo' } : null });
+  }
+
+  return { getSnapshot: () => state, subscribe(listener) { listeners.add(listener); return () => listeners.delete(listener); }, setIdentity, refresh, setDemoParticipation };
+}
diff --git a/app/tests/participationProvider.test.cjs b/app/tests/participationProvider.test.cjs
new file mode 100644
index 0000000..2bffd40
--- /dev/null
+++ b/app/tests/participationProvider.test.cjs
@@ -0,0 +1,74 @@
+const assert = require('node:assert/strict');
+const test = require('node:test');
+const { loadModule } = require('./helpers/questionnaireHarness.cjs');
+
+const { createParticipationStore } = loadModule('services/participationService.js', (name) =>
+  name === './httpClient' ? { httpClient: {} } : require(name)).exports;
+
+function providerRig() {
+  let auth = null;
+  let epoch = 0;
+  let cursor = 0;
+  const hooks = [], pending = [];
+  const react = {
+    createContext: () => ({ Provider: 'Provider' }),
+    useRef(value) { const i = cursor++; return hooks[i] ||= { current: value }; },
+    useState(value) { const i = cursor++; if (!(i in hooks)) hooks[i] = value; return [hooks[i], (next) => { hooks[i] = next; }]; },
+    useEffect(fn, deps) {
+      const i = cursor++, previous = hooks[i];
+      if (!previous || deps.some((value, j) => !Object.is(value, previous.deps[j]))) {
+        hooks[i] = { deps, cleanup: previous?.cleanup };
+        pending.push(() => { hooks[i].cleanup?.(); hooks[i].cleanup = fn(); });
+      }
+    },
+  };
+  const module = loadModule('context/ParticipationContext.js', (name) => {
+    if (name === 'react') return react;
+    if (name === './AuthContext') return { useAuth: () => auth };
+    if (name === '../services/participationService') return { createParticipationStore };
+    return require(name);
+  }).exports;
+  const render = () => { cursor = 0; return module.ParticipationProvider({ children: null }).props.value; };
+  return {
+    render,
+    effects() { while (pending.length) pending.shift()(); },
+    authenticate(userId, client) {
+      epoch += 1;
+      auth = { isAuthenticated: true, user: { id: userId }, httpClient: client, getSessionEpoch: () => epoch };
+    },
+    logout() { epoch += 1; auth = { isAuthenticated: false, getSessionEpoch: () => epoch }; },
+  };
+}
+
+test('provider restores participation after session restoration and hides it immediately on logout', async () => {
+  const r = providerRig();
+  const participation = { id: 'p-a', eventId: 'e-a', status: 'active', externalQueue: null };
+  const client = { get: async (path) => path.endsWith('/current') ? { participation } : { recentFinalization: null, pendingEvaluationParticipationIds: [] } };
+  r.render(); r.effects();
+  r.authenticate('a', client);
+  assert.equal(r.render().status, 'loading');
+  r.effects();
+  await new Promise((resolve) => setImmediate(resolve));
+  const ready = r.render();
+  assert.equal(ready.participation.id, 'p-a');
+  assert.equal(ready.participation.source, 'server');
+  r.logout();
+  assert.equal(r.render().participation, null);
+  r.effects();
+  assert.equal(r.render().status, 'idle');
+});
+
+test('provider masks the previous account before the identity-change effect runs', async () => {
+  const r = providerRig();
+  const client = { get: async (path) => path.endsWith('/current')
+    ? { participation: { id: 'old', eventId: 'event', status: 'active', externalQueue: null } }
+    : { recentFinalization: null, pendingEvaluationParticipationIds: [] } };
+  r.authenticate('a', client); r.render(); r.effects();
+  await new Promise((resolve) => setImmediate(resolve));
+  assert.equal(r.render().participation.id, 'old');
+  r.authenticate('b', client);
+  const switched = r.render();
+  assert.equal(switched.participation, null);
+  assert.equal(switched.returnState, null);
+  assert.equal(switched.status, 'loading');
+});
diff --git a/app/tests/participationService.test.cjs b/app/tests/participationService.test.cjs
new file mode 100644
index 0000000..1a2b73c
--- /dev/null
+++ b/app/tests/participationService.test.cjs
@@ -0,0 +1,118 @@
+const assert = require('node:assert/strict');
+const test = require('node:test');
+const { loadModule } = require('./helpers/questionnaireHarness.cjs');
+
+const { createParticipationStore } = loadModule('services/participationService.js', (name) =>
+  name === './httpClient' ? { httpClient: {} } : require(name)).exports;
+const identityA = { userId: 'user-a', epoch: 1 };
+const identityB = { userId: 'user-b', epoch: 2 };
+const active = { id: 'p-1', eventId: 'e-1', status: 'active', externalQueue: null };
+const waiting = { id: 'p-2', eventId: 'e-2', status: 'waiting', externalQueue: { position: 3, observedAt: '2026-01-01T00:00:00.000000Z' } };
+const returned = { recentFinalization: null, pendingEvaluationParticipationIds: [] };
+function deferred() {
+  let resolve, reject;
+  const promise = new Promise((ok, fail) => { resolve = ok; reject = fail; });
+  return { promise, resolve, reject };
+}
+function rig(handler) {
+  let identity = identityA;
+  const calls = [];
+  const store = createParticipationStore({
+    getIdentity: () => identity,
+    client: { get(path, options) { calls.push({ path, options }); return handler(path); } },
+  });
+  return { store, calls, identity(value) { identity = value; } };
+}
+
+test('loads absence and return state using authenticated backend contracts', async () => {
+  const r = rig((path) => Promise.resolve(path.endsWith('/current') ? { participation: null } : returned));
+  r.store.setIdentity(identityA);
+  await r.store.refresh();
+  assert.equal(r.store.getSnapshot().status, 'ready');
+  assert.equal(r.store.getSnapshot().participation, null);
+  assert.equal(r.store.getSnapshot().returnState, returned);
+  assert.deepEqual(r.calls.map((c) => [c.path, c.options.auth]), [
+    ['/participations/current', true], ['/participations/return-state', true],
+  ]);
+});
+
+test('restores active and waiting participation with real queue position', async () => {
+  for (const participation of [active, waiting]) {
+    const r = rig((path) => Promise.resolve(path.endsWith('/current') ? { participation } : returned));
+    r.store.setIdentity(identityA);
+    await r.store.refresh();
+    assert.equal(r.store.getSnapshot().participation, participation);
+    assert.equal(r.store.getSnapshot().status, 'ready');
+  }
+});
+
+test('logout invalidates a delayed response and clears all state', async () => {
+  const first = deferred(), second = deferred();
+  const r = rig((path) => path.endsWith('/current') ? first.promise : second.promise);
+  r.store.setIdentity(identityA);
+  const pending = r.store.refresh();
+  r.identity(null);
+  r.store.setIdentity(null);
+  first.resolve({ participation: active }); second.resolve(returned);
+  await pending;
+  assert.equal(r.store.getSnapshot().status, 'idle');
+  assert.equal(r.store.getSnapshot().participation, null);
+  assert.equal(r.store.getSnapshot().returnState, null);
+});
+
+test('epoch change rejects late results even before the provider cleanup', async () => {
+  const first = deferred(), second = deferred();
+  const r = rig((path) => path.endsWith('/current') ? first.promise : second.promise);
+  r.store.setIdentity(identityA);
+  const pending = r.store.refresh();
+  r.identity({ userId: 'user-a', epoch: 2 });
+  first.resolve({ participation: active }); second.resolve(returned);
+  await pending;
+  assert.equal(r.store.getSnapshot().participation, null);
+});
+
+test('switching users prevents previous responses from replacing the new account', async () => {
+  const first = deferred(), second = deferred();
+  let old = true;
+  const r = rig((path) => old ? (path.endsWith('/current') ? first.promise : second.promise)
+    : Promise.resolve(path.endsWith('/current') ? { participation: waiting } : returned));
+  r.store.setIdentity(identityA);
+  const pending = r.store.refresh();
+  old = false; r.identity(identityB); r.store.setIdentity(identityB);
+  await r.store.refresh();
+  first.resolve({ participation: active }); second.resolve(returned);
+  await pending;
+  assert.equal(r.store.getSnapshot().userId, 'user-b');
+  assert.equal(r.store.getSnapshot().participation, waiting);
+});
+
+test('401 and network errors clear data and allow retry', async () => {
+  for (const [failure, expected] of [[{ status: 401 }, 'authorization'], [{ isNetworkError: true }, 'network']]) {
+    let fail = true;
+    const r = rig((path) => fail ? Promise.reject(failure) : Promise.resolve(path.endsWith('/current') ? { participation: active } : returned));
+    r.store.setIdentity(identityA);
+    await r.store.refresh();
+    assert.equal(r.store.getSnapshot().error, expected);
+    assert.equal(r.store.getSnapshot().participation, null);
+    fail = false;
+    await r.store.refresh();
+    assert.equal(r.store.getSnapshot().participation, active);
+  }
+});
+
+test('real participation cannot be overwritten by a simulated entry', async () => {
+  const r = rig((path) => Promise.resolve(path.endsWith('/current') ? { participation: active } : returned));
+  r.store.setIdentity(identityA);
+  await r.store.refresh();
+  r.store.setDemoParticipation({ status: 'waiting' });
+  assert.equal(r.store.getSnapshot().participation, active);
+  assert.equal(r.store.getSnapshot().demoParticipation, null);
+});
+
+test('malformed server data is not treated as absence', async () => {
+  const r = rig((path) => Promise.resolve(path.endsWith('/current') ? {} : returned));
+  r.store.setIdentity(identityA);
+  await r.store.refresh();
+  assert.equal(r.store.getSnapshot().status, 'error');
+  assert.equal(r.store.getSnapshot().error, 'unavailable');
+});
