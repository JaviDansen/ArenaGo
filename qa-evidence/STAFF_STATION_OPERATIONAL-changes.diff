+      if (!receipt) return { kind: 'receipt_absent' };
+      if (map.has(user)) return { kind: 'cleanup_pending' };
+      if (receipt.sessionId !== scope.sessionId || receipt.eventId !== scope.eventId || receipt.stationId !== scope.stationId)
