@@ -0,0 +1,28 @@
+import { z } from "zod";
+import { operationUuid } from "../common/http/operation-validation";
+import { isPreciseInstant } from "./evaluation-read.dto";
+
+export const EVALUATION_COMMENT_LIMIT = 2000;
+const comment = z.string().superRefine((value, ctx) => {
+  const characters = Array.from(value);
+  if (characters.length > EVALUATION_COMMENT_LIMIT || value.includes("\0")
+    || characters.some(c => c.length === 1 && c.charCodeAt(0) >= 0xd800 && c.charCodeAt(0) <= 0xdfff)) {
+    ctx.addIssue({ code: "custom", message: "Comentário inválido ou acima do limite técnico." });
+  }
+}).transform(value => value.trim() === "" ? null : value).nullable();
+export const submitEvaluationBody = z.object({ rating: z.number().int().min(1).max(5), comment: comment.optional() }).strict()
+  .transform(value => ({ rating: value.rating, comment: value.comment ?? null }));
+export const editEvaluationBody = z.object({ rating: z.number().int().min(1).max(5).optional(), comment: comment.optional() }).strict()
+  .refine(value => value.rating !== undefined || value.comment !== undefined, "Informe nota ou comentário.")
+  .transform(value => ({ ...(value.rating !== undefined ? { rating: value.rating } : {}),
+    ...(value.comment !== undefined ? { comment: value.comment } : {}) }));
+export type SubmitEvaluationBody = z.infer<typeof submitEvaluationBody>;
+export type EditEvaluationBody = z.infer<typeof editEvaluationBody>;
+export const writeEvaluationParams = z.object({ evaluationId: operationUuid }).strict();
+const instant = z.custom<string>(isPreciseInstant);
+/** Valida replay histórico sem expor payload interno corrompido. */
+export const evaluationWriteResponse = z.object({ evaluation: z.object({
+  id: operationUuid, participationId: operationUuid, rating: z.number().int().min(1).max(5), comment: z.string().nullable(),
+  submittedAt: instant, updatedAt: instant, editableUntilAt: instant, commentAddUntilAt: instant,
+  permissions: z.object({ canEditRating: z.boolean(), canEditComment: z.boolean(), canAddFirstComment: z.boolean() }).strict(),
+}).strict() }).strict();
diff --git a/backend/src/evaluations/evaluation-write.policy.ts b/backend/src/evaluations/evaluation-write.policy.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a7ef4872c5ac866420914c12259da10e9017431b
--- /dev/null
+++ b/backend/src/evaluations/evaluation-write.policy.ts
@@ -0,0 +1,38 @@
+import { sql, type SQL } from "drizzle-orm";
+import { evaluationReadProjection, type EvaluationReadRow } from "./evaluation-read.policy";
+import type { EditEvaluationBody, SubmitEvaluationBody } from "./evaluation-write.dto";
+
+export interface EvaluationDecisionRow extends EvaluationReadRow {
+  decisionAt: string; writtenId: string | null; allowed: boolean; changed: boolean; commentWindow: boolean; submissionOpen: boolean | null;
+}
+/** O relógio alternativo é interno, para verificar bordas SQL em testes; HTTP nunca o fornece. */
+export function submissionStatement(selection: SQL, evaluationId: string, body: SubmitEvaluationBody, clock: SQL = sql`clock_timestamp()`): SQL {
+  return sql`WITH decision AS MATERIALIZED (SELECT ${clock} AS at),
+    facts AS MATERIALIZED (${evaluationReadProjection(selection, sql`(SELECT at FROM decision)`)}),
+    written AS (INSERT INTO evaluations(id,participation_id,rating,comment,submitted_at,updated_at,first_comment_at)
+      SELECT ${evaluationId}::uuid,f."participationId",${body.rating}::smallint,${body.comment}::text,d.at,d.at,
+        CASE WHEN ${body.comment}::text IS NOT NULL THEN d.at END
+      FROM facts f CROSS JOIN decision d WHERE f.eligible AND f.pending AND NOT f.submitted RETURNING id)
+    SELECT f.*,w.id AS "writtenId",(d.at<=f."deadlineAt"::timestamptz) AS "submissionOpen",
+      to_char(d.at AT TIME ZONE 'UTC','YYYY-MM-DD"T"HH24:MI:SS.US"Z"') AS "decisionAt"
+    FROM facts f CROSS JOIN decision d LEFT JOIN written w ON true`;
+}
+export function editStatement(selection: SQL, evaluationId: string, body: EditEvaluationBody, clock: SQL = sql`clock_timestamp()`): SQL {
+  const rating = body.rating !== undefined, comment = Object.hasOwn(body, "comment");
+  return sql`WITH decision AS MATERIALIZED (SELECT ${clock} AS at),
+    facts AS MATERIALIZED (${evaluationReadProjection(selection, sql`(SELECT at FROM decision)`)}),
+    plan AS MATERIALIZED (SELECT f.*,v.id,
+      CASE WHEN ${rating}::boolean THEN ${body.rating ?? null}::smallint ELSE v.rating END AS next_rating,
+      CASE WHEN ${comment}::boolean THEN ${body.comment ?? null}::text ELSE v.comment END AS next_comment,
+      (f."editFull" OR (f."addComment" AND NOT ${rating}::boolean AND ${comment}::boolean
+        AND ${body.comment ?? null}::text IS NOT NULL AND v.comment IS NULL)) AS allowed,
+      (d.at>f."editableUntilAt"::timestamptz AND d.at<=f."commentAddUntilAt"::timestamptz) AS "commentWindow"
+      FROM facts f JOIN evaluations v ON v.id=${evaluationId}::uuid AND v.participation_id=f."participationId" CROSS JOIN decision d),
+    changes AS MATERIALIZED (SELECT p.*,(v.rating IS DISTINCT FROM p.next_rating OR v.comment IS DISTINCT FROM p.next_comment) AS changed
+      FROM plan p JOIN evaluations v ON v.id=p.id),
+    written AS (UPDATE evaluations v SET rating=c.next_rating,comment=c.next_comment,updated_at=d.at,
+      first_comment_at=COALESCE(v.first_comment_at,CASE WHEN ${comment}::boolean AND c.next_comment IS NOT NULL THEN d.at END)
+      FROM changes c CROSS JOIN decision d WHERE v.id=c.id AND v.participation_id=c."participationId" AND c.allowed AND c.changed RETURNING v.id)
+    SELECT c.*,w.id AS "writtenId",to_char(d.at AT TIME ZONE 'UTC','YYYY-MM-DD"T"HH24:MI:SS.US"Z"') AS "decisionAt"
+    FROM changes c CROSS JOIN decision d LEFT JOIN written w ON true`;
+}
diff --git a/backend/src/evaluations/evaluation-write.service.ts b/backend/src/evaluations/evaluation-write.service.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e740357c8116e50b9a5deaf95c627213213340c7
--- /dev/null
+++ b/backend/src/evaluations/evaluation-write.service.ts
@@ -0,0 +1,90 @@
+import { Inject, Injectable } from "@nestjs/common";
+import { randomUUID } from "node:crypto";
+import { sql } from "drizzle-orm";
+import type { NodePgDatabase } from "drizzle-orm/node-postgres";
+import { DRIZZLE_DATABASE } from "../database/database.module";
+import type { DatabaseTransactionExecutor } from "../database/database-executor";
+import type * as schema from "../database/schema";
+import { completeIdempotencyOperationWithTx, createRequestFingerprint, reserveIdempotencyOperationWithTx, type JsonValue } from "../participations/join-idempotency";
+import { evaluationReadProjection, ownEvaluation, type EvaluationReadRow } from "./evaluation-read.policy";
+import { isPreciseInstant } from "./evaluation-read.dto";
+import { editEvaluationBody, evaluationWriteResponse, submitEvaluationBody } from "./evaluation-write.dto";
+import { editStatement, submissionStatement, type EvaluationDecisionRow } from "./evaluation-write.policy";
+import type { EditEvaluationInput, EvaluationWriteFailure, EvaluationWriteResult, SubmitEvaluationInput } from "./evaluation-write.types";
+
+export const SUBMIT_EVALUATION_OPERATION = "submit_evaluation";
+export const EDIT_EVALUATION_OPERATION = "edit_evaluation";
+export function evaluationWriteFingerprint(operation: string, resourceId: string, payload: JsonValue): string {
+  return createRequestFingerprint(operation, { version: 1, resourceId, payload });
+}
+class WriteRollback extends Error { constructor(readonly kind: EvaluationWriteFailure) { super(kind); } }
+function block(kind: EvaluationWriteFailure): never { throw new WriteRollback(kind); }
+function ensure(value: unknown): asserts value { if (!value) throw new Error("EVALUATION_WRITE_INTEGRITY"); }
+
+@Injectable()
+export class EvaluationWriteService {
+  constructor(@Inject(DRIZZLE_DATABASE) private readonly database: NodePgDatabase<typeof schema>) {}
+  private selection(userId: string, participationId: string) {
+    return sql`SELECT p.id,p.event_id,e.name AS event_name,p.status,p.joined_at,p.arena_entered_at,p.finished_at,p.finish_reason
+      FROM participations p JOIN events e ON e.id=p.event_id WHERE p.id=${participationId}::uuid AND p.user_id=${userId}::uuid`;
+  }
+  async submit(input: SubmitEvaluationInput): Promise<EvaluationWriteResult> { return this.write("submit", input); }
+  async edit(input: EditEvaluationInput): Promise<EvaluationWriteResult> { return this.write("edit", input); }
+  private async write(mode: "submit" | "edit", input: SubmitEvaluationInput | EditEvaluationInput): Promise<EvaluationWriteResult> {
+    try {
+      const payload = mode === "submit" ? submitEvaluationBody.parse(input.payload) : editEvaluationBody.parse(input.payload);
+      ensure(input.idempotencyKey.trim() && input.idempotencyKey.length <= 128 && Number.isFinite(input.expiresAt.getTime()));
+      const evaluationId = "evaluationId" in input ? input.evaluationId : undefined;
+      const resourceId = "participationId" in input ? input.participationId : input.evaluationId;
+      return await this.database.transaction(async tx => {
+        const lookup = mode === "submit" ? sql`SELECT id AS "participationId" FROM participations WHERE id=${resourceId}::uuid AND user_id=${input.userId}::uuid`
+          : sql`SELECT p.id AS "participationId" FROM evaluations v JOIN participations p ON p.id=v.participation_id WHERE v.id=${resourceId}::uuid AND p.user_id=${input.userId}::uuid`;
+        const found = (await tx.execute<{ participationId: string }>(lookup)).rows[0]; if (!found) block("access_denied");
+        const participationId = found.participationId, operation = mode === "submit" ? SUBMIT_EVALUATION_OPERATION : EDIT_EVALUATION_OPERATION;
+        const intent = await reserveIdempotencyOperationWithTx(tx, { actorUserId: input.userId, operation, idempotencyKey: input.idempotencyKey,
+          requestHash: evaluationWriteFingerprint(operation, resourceId, payload as JsonValue), expiresAt: input.expiresAt });
+        if (intent.kind === "request_conflict" || intent.kind === "in_progress") block(intent.kind);
+        const parent = await tx.execute(sql`SELECT id FROM participations WHERE id=${participationId}::uuid AND user_id=${input.userId}::uuid FOR UPDATE`);
+        if (parent.rows.length !== 1) block("access_denied");
+        if (mode === "edit") {
+          const locked = await tx.execute(sql`SELECT id FROM evaluations WHERE id=${evaluationId}::uuid AND participation_id=${participationId}::uuid FOR UPDATE`);
+          if (locked.rows.length !== 1) block("access_denied");
+        }
+        if (intent.kind === "replay") {
+          const replay = evaluationWriteResponse.parse(intent.resultPayload);
+          ensure(intent.httpStatus === (mode === "submit" ? 201 : 200) && replay.evaluation.participationId === participationId
+            && intent.resultReference === replay.evaluation.id && (mode === "submit" || replay.evaluation.id === evaluationId));
+          return { kind: "replay", evaluation: replay.evaluation };
+        }
+        const selection = this.selection(input.userId, participationId);
+        const decision = (await tx.execute<EvaluationDecisionRow>(mode === "submit"
+          ? submissionStatement(selection, randomUUID(), submitEvaluationBody.parse(payload))
+          : editStatement(selection, evaluationId!, editEvaluationBody.parse(payload)))).rows;
+        ensure(decision.length === 1 && isPreciseInstant(decision[0].decisionAt)); const row = decision[0];
+        if (mode === "submit") {
+          if (!row.eligible) block("not_eligible"); if (!row.submissionOpen) block("submission_expired");
+          if (row.submitted) block("already_submitted"); ensure(row.pending && row.writtenId);
+        } else {
+          if (!row.allowed) {
+            if (row.commentWindow && payload.rating === undefined && Object.hasOwn(payload, "comment") && payload.comment !== null && !row.addComment) block("comment_already_added");
+            block("edit_window_closed");
+          }
+          ensure(row.changed ? row.writtenId === evaluationId : row.writtenId === null);
+        }
+        const evaluation = await this.response(tx, selection, row.decisionAt);
+        ensure(mode === "submit" ? evaluation.id === row.writtenId : evaluation.id === evaluationId);
+        await completeIdempotencyOperationWithTx(tx, intent.operationId, { httpStatus: mode === "submit" ? 201 : 200,
+          resultReference: evaluation.id, resultPayload: { evaluation } as unknown as JsonValue });
+        return { kind: mode === "submit" ? "created" : "updated", evaluation };
+      }, { isolationLevel: "read committed" });
+    } catch (error) {
+      if (error instanceof WriteRollback) return { kind: error.kind };
+      // O filtro HTTP existente registra somente message; causa interna nunca vira resposta ou log.
+      throw new Error("EVALUATION_WRITE_INTERNAL_ERROR", { cause: error });
+    }
+  }
+  private async response(tx: DatabaseTransactionExecutor, selection: ReturnType<EvaluationWriteService["selection"]>, at: string) {
+    const rows = (await tx.execute<EvaluationReadRow>(evaluationReadProjection(selection, at))).rows;
+    ensure(rows.length === 1); const value = ownEvaluation(rows[0]); ensure(value); return value;
+  }
+}
