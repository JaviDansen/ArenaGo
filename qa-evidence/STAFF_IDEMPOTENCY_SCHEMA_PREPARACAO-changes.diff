+          "value": "\"staff_idempotency_epochs\".\"status\" = 'pending' AND \"staff_idempotency_epochs\".\"activated_at\" IS NULL AND \"staff_idempotency_epochs\".\"invalidated_at\" IS NULL"
+        },
+        "ck_staff_idempotency_epoch_version": {
+          "name": "ck_staff_idempotency_epoch_version",
+          "value": "length(btrim(\"staff_idempotency_epochs\".\"controls_version\")) > 0"
+        }
+      },
+      "isRLSEnabled": false
+    }
