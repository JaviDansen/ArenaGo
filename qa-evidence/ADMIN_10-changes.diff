+        assert.doesNotMatch(JSON.stringify(summary), /PRIVADO|audience|durationB/);
+      } finally {
+        try { await client.query('ROLLBACK'); } finally { client.release(); }
+      }
+    });
+  } finally { await pool.end(); }
+});
